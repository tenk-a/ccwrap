{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 29,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/_build/${presetName}",
      "cacheVariables": {
        "TEST_TARGET_CXX": "2023"
      }
    },
    {
      "name": "vc145",
      "inherits": "base",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64"
    },
    {
      "name": "vc145-ccwstd",
      "inherits": "vc145",
      "displayName": "vc145 + ccwstd (libcxx03 relocated out of std)",
      "description": "C++ comes from libcxx03 (namespace ccwstd), not the native std.",
      "cacheVariables": {
        "TST_NS": "ccwstd"
      }
    },
    {
      "name": "vc145-latest",
      "inherits": "vc145",
      "description": "MSVC 14.5 (VS2026) x64, /std:c++latest. Tests run at _CCW_TARGET_CXX=2023 (c++latest's C++26 surface is still thin)."
    },
    {
      "name": "vc145-std",
      "inherits": "vc145",
      "cacheVariables": {
        "TEST_TARGET_CXX": ""
      },
      "description": ""
    },
    {
      "name": "vc143",
      "inherits": "base",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64"
    },
    {
      "name": "gcc",
      "inherits": "base",
      "generator": "Ninja",
      "description": "g++ -std=c++03 (like Watcom, the modern merged cases skip). Run `setcc gcc x64` (msys2 ucrt64) or use a shell with g++ on PATH.",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_CXX_STANDARD": "98",
        "CMAKE_BUILD_TYPE": "Debug"
      },
      "binaryDir": "${sourceDir}/_build/${hostSystemName}-${presetName}"
    },
    {
      "name": "gcc-cxx03",
      "inherits": "gcc",
      "description": "Explicit name for the g++ C++03 config (== gcc)."
    },
    {
      "name": "gcc-latest",
      "inherits": "gcc",
      "description": "g++ -std=c++23: the modern merged cases DO compile here. Tests run at _CCW_TARGET_CXX=2023.",
      "cacheVariables": {
        "CMAKE_CXX_STANDARD": "23"
      }
    },
    {
      "name": "gcc-cxx26",
      "inherits": "gcc",
      "description": "g++ -std=c++26: the widest standard-library coverage available, used as the reference when filling spec gaps.",
      "cacheVariables": {
        "CMAKE_CXX_STANDARD": "26",
        "TEST_TARGET_CXX": "2026"
      }
    },
    {
      "name": "clang-cxx26",
      "inherits": "gcc-cxx26",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "clang",
      "inherits": "gcc",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "gcc-noeh",
      "inherits": "gcc",
      "description": "g++ -std=c++03 + ccwrap, exceptions and RTTI off (-fno-exceptions -fno-rtti). The gcc twin of the watcom-noeh preset.",
      "cacheVariables": {
        "TEST_NO_EH": "ON",
        "TEST_NO_RTTI": "ON"
      }
    },
    {
      "name": "clang-noeh",
      "inherits": "clang",
      "description": "clang++ -std=c++03 + ccwrap, exceptions and RTTI off (-fno-exceptions -fno-rtti).",
      "cacheVariables": {
        "TEST_NO_EH": "ON",
        "TEST_NO_RTTI": "ON"
      }
    },
    {
      "name": "clang-cxx26-noeh",
      "inherits": "clang-cxx26",
      "description": "clang++ -std=c++26 + ccwrap, exceptions and RTTI off. C++03 の組み合わせが通らない環境 (Apple clang + libc++) 用。",
      "cacheVariables": {
        "TEST_NO_EH": "ON",
        "TEST_NO_RTTI": "ON"
      }
    },
    {
      "name": "watcom",
      "inherits": "base",
      "generator": "Watcom WMake",
      "environment": {
        "WATCOM": "C:/WATCOM",
        "PATH": "$env{WATCOM}/binnt64;$env{WATCOM}/binnt;$penv{PATH}",
        "EDPATH": "$env{WATCOM}/eddat",
        "INCLUDE": "$env{WATCOM}/h;$env{WATCOM}/h/nt"
      },
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "Windows",
        "CMAKE_C_COMPILER": "wcl386",
        "CMAKE_CXX_COMPILER": "wcl386",
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_FLAGS_DEBUG": "-d1",
        "CMAKE_CXX_FLAGS_DEBUG": "-d1",
        "CMAKE_WATCOM_RUNTIME_LIBRARY": "MultiThreaded",
        "TEST_TARGET_CXX": "2026"
      }
    },
    {
      "name": "watcom-xrxs",
      "inherits": "watcom",
      "displayName": "Open Watcom 2.0 (win32), -xs exception model -- test only (A1''); pairs with the -xrxs lib",
      "binaryDir": "${sourceDir}/_build/watcom-xrxs",
      "cacheVariables": {
        "TEST_WATCOM_XS": "ON"
      }
    },
    {
      "name": "watcom-dos32",
      "displayName": "Open Watcom 2.0 (32-bit DOS / DOS4GW, C++)",
      "inherits": "base",
      "generator": "Watcom WMake",
      "environment": {
        "WATCOM": "C:/WATCOM",
        "PATH": "$env{WATCOM}/binnt64;$env{WATCOM}/binnt;$penv{PATH}",
        "EDPATH": "$env{WATCOM}/eddat",
        "INCLUDE": "$env{WATCOM}/h"
      },
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/../toolchains/watcom-dos32-toolchain.cmake",
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS_DEBUG": "-d1",
        "TEST_TARGET_CXX": "2026"
      }
    },
    {
      "name": "watcom-fs-char",
      "inherits": "watcom",
      "displayName": "Open Watcom (filesystem::path::value_type = char)",
      "binaryDir": "${sourceDir}/_build/watcom-fs-char",
      "cacheVariables": {
        "TEST_FS_CHAR": "ON"
      }
    },
    {
      "name": "watcom-xst",
      "inherits": "watcom",
      "displayName": "Open Watcom (-xst only, no RTTI) -- pairs with the -xst lib; needs `gen full`",
      "binaryDir": "${sourceDir}/_build/watcom-xst",
      "cacheVariables": {
        "TEST_WATCOM_RTTI": "OFF"
      }
    },
    {
      "name": "watcom-noeh",
      "inherits": "watcom",
      "displayName": "Open Watcom (no exceptions and no RTTI) -- pairs with the -noeh lib",
      "binaryDir": "${sourceDir}/_build/watcom-noeh",
      "cacheVariables": {
        "TEST_NO_EH": "ON",
        "TEST_WATCOM_RTTI": "OFF"
      }
    },
    {
      "name": "watcom-ccwstd",
      "inherits": "watcom",
      "displayName": "Open Watcom (ccwstd relocation)",
      "binaryDir": "${sourceDir}/_build/watcom-ccwstd",
      "cacheVariables": {
        "TST_NS": "ccwstd"
      }
    },
    {
      "name": "nmake-base",
      "hidden": true,
      "inherits": "base",
      "generator": "NMake Makefiles",
      "description": "NMake base for vc80..vc145. cl / nmake go through ../bin/*_with_setcc.bat, so setcc need not be run first. See doc/src/test/CMakePresets.json.md. Static runtime (/MTd).",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_MAKE_PROGRAM": "${sourceDir}/../bin/nmake_with_setcc.bat",
        "CMAKE_C_COMPILER": "${sourceDir}/../bin/cl_with_setcc.bat",
        "CMAKE_RC_COMPILER": "${sourceDir}/../bin/rc_with_setcc.bat",
        "CMAKE_LINKER": "${sourceDir}/../bin/link_with_setcc.bat",
        "CMAKE_AR": "${sourceDir}/../bin/lib_with_setcc.bat",
        "CMAKE_MT": "${sourceDir}/../bin/mt_with_setcc.bat",
        "CMAKE_CXX_COMPILER": "${sourceDir}/../bin/cl_with_setcc.bat",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>"
      }
    },
    {
      "name": "vc80-x86",
      "inherits": "nmake-base",
      "environment": {
        "CCWRAP_VC_VERSION": "vc80",
        "CCWRAP_VC_ARCH": "x86"
