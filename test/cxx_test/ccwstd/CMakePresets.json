{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 20, "patch": 0 },
  "configurePresets": [
    {
      "name": "watcom-ccwstd",
      "displayName": "Open Watcom 2.0 -- libcxx03 relocated into namespace ccwstd",
      "generator": "Watcom WMake",
      "binaryDir": "${sourceDir}/_build/watcom-ccwstd",
      "environment": {
        "WATCOM": "C:/WATCOM",
        "PATH": "$env{WATCOM}/binnt64;$env{WATCOM}/binnt;$penv{PATH}",
        "EDPATH": "$env{WATCOM}/eddat",
        "INCLUDE": "$env{WATCOM}/h;$env{WATCOM}/h/nt"
      },
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "Windows",
        "CMAKE_C_COMPILER": "wcl386",
        "CMAKE_CXX_COMPILER": "wcl386",
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_FLAGS_DEBUG": "-d1",
        "CMAKE_CXX_FLAGS_DEBUG": "-d1",
        "CMAKE_WATCOM_RUNTIME_LIBRARY": "MultiThreaded",
        "TEST_TARGET_CXX": "2026"
      }
    }
  ],
  "buildPresets": [
    { "name": "watcom-ccwstd", "configurePreset": "watcom-ccwstd" }
  ],
  "testPresets": [
    { "name": "watcom-ccwstd", "configurePreset": "watcom-ccwstd", "output": { "outputOnFailure": true } }
  ]
}
