{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/_build/${presetName}",
      "cacheVariables": {
        "TEST_TARGET_C": "2023"
      }
    },
    {
      "name": "vc145",
      "displayName": "VC 14.5 (VS2026), x64",
      "inherits": "base",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64"
    },
    {
      "name": "vc143",
      "displayName": "VC 14.3 (VS2022), x64",
      "inherits": "base",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64"
    },
    {
      "name": "gcc",
      "displayName": "gcc (msys2 / WSL)",
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_BUILD_TYPE": "Debug"
      },
      "binaryDir": "${sourceDir}/_build/${hostSystemName}-${presetName}"
    },
    {
      "name": "gcc-c23",
      "inherits": "gcc",
      "description": "gcc -std=c23 -- widest C library coverage; the reference for spec gaps.",
      "cacheVariables": {
        "CMAKE_C_STANDARD": "23"
      }
    },
    {
      "name": "clang-c23",
      "inherits": "gcc-c23",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang"
      }
    },
    {
      "name": "clang",
      "inherits": "gcc",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang"
      }
    },
    {
      "name": "pcc",
      "displayName": "pcc (WSL / Linux) -- native C library",
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "pcc",
        "CMAKE_C_FLAGS": "-U__GNUC__",
        "CMAKE_BUILD_TYPE": "Debug",
        "TEST_TARGET_C": ""
      },
      "binaryDir": "${sourceDir}/_build/${hostSystemName}-${presetName}"
    },
    {
      "name": "tcc",
      "displayName": "TinyCC (WSL / Linux) -- native C library",
      "inherits": "pcc",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "tcc",
        "CMAKE_C_FLAGS": ""
      }
    },
    {
      "name": "dmc",
      "displayName": "Digital Mars C 8.x (Ninja, native C library)",
      "description": "dmc.exe directly, no ccwrap. Only the suites that link against the DMC 8.x runtime.",
      "inherits": "base",
      "generator": "Ninja",
      "toolchainFile": "${sourceDir}/../toolchains/dmc.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "TEST_TARGET_C": "",
        "TST_ONLY": "assert;ctype;fenv;float;iso646;limits;locale;setjmp;signal;stdarg;stdbool;stdlib;stdnoreturn;time"
      }
    },
    {
      "name": "orangec",
      "displayName": "Orange C/C++ 7.x (Ninja, native C library)",
      "description": "occ.exe via CMake's OrangeC support, no ccwrap. Unsupported suites are excluded.",
      "inherits": "base",
      "generator": "Ninja",
      "toolchainFile": "${sourceDir}/../toolchains/orangec.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "TEST_TARGET_C": "",
        "TST_ONLY": "assert;complex;ctype;errno;fenv;float;inttypes;iso646;locale;setjmp;signal;stdalign;stdarg;stdatomic;stdbool;stddef;stdio;stdlib;stdnoreturn;string;time;uchar;wchar;wctype"
      }
    },
    {
      "name": "watcom",
      "displayName": "Open Watcom 2.0 (win32, C)",
      "inherits": "base",
      "generator": "Watcom WMake",
      "environment": {
        "WATCOM": "C:/WATCOM",
        "PATH": "$env{WATCOM}/binnt64;$env{WATCOM}/binnt;$penv{PATH}",
        "EDPATH": "$env{WATCOM}/eddat",
        "INCLUDE": "$env{WATCOM}/h;$env{WATCOM}/h/nt"
      },
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "Windows",
        "CMAKE_C_COMPILER": "wcl386",
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_FLAGS_DEBUG": "-d1",
        "CMAKE_WATCOM_RUNTIME_LIBRARY": "MultiThreaded",
        "TEST_TARGET_C": "2026"
      }
    },
    {
      "name": "watcom-dos32",
      "displayName": "Open Watcom 2.0 (32-bit DOS / DOS4GW, C)",
      "description": "DOS target; -bt=dos comes from the toolchain. Run it with test/scripts/dos_ctest.ps1 (DOSBox-X).",
      "inherits": "base",
      "generator": "Watcom WMake",
      "environment": {
        "WATCOM": "C:/WATCOM",
        "PATH": "$env{WATCOM}/binnt64;$env{WATCOM}/binnt;$penv{PATH}",
        "EDPATH": "$env{WATCOM}/eddat",
        "INCLUDE": "$env{WATCOM}/h"
      },
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/../toolchains/watcom-dos32-toolchain.cmake",
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_FLAGS_DEBUG": "-d1",
        "TEST_TARGET_C": "2026"
      }
    },
    {
      "name": "watcom-std",
      "displayName": "Open Watcom 2.0 (win32, C) -- native baseline, no ccwrap",
      "description": "Plain Open Watcom C library, no ccwrap. What fails here is what ccwrap supplies.",
      "inherits": "watcom",
      "cacheVariables": {
        "TEST_TARGET_C": ""
      }
    },
    {
      "name": "nmake-base",
      "hidden": true,
      "inherits": "base",
      "generator": "NMake Makefiles",
      "description": "NMake base for vc80..vc145. cl / nmake go through ../bin/*_with_setcc.bat, so setcc need not be run first. See doc/src/test/CMakePresets.json.md.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_MAKE_PROGRAM": "${sourceDir}/../bin/nmake_with_setcc.bat",
        "CMAKE_C_COMPILER": "${sourceDir}/../bin/cl_with_setcc.bat",
        "CMAKE_RC_COMPILER": "${sourceDir}/../bin/rc_with_setcc.bat",
        "CMAKE_LINKER": "${sourceDir}/../bin/link_with_setcc.bat",
        "CMAKE_AR": "${sourceDir}/../bin/lib_with_setcc.bat",
        "CMAKE_MT": "${sourceDir}/../bin/mt_with_setcc.bat",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>"
      }
    },
    {
      "name": "vc80-x86",
      "inherits": "nmake-base",
      "environment": {
        "CCWRAP_VC_VERSION": "vc80",
        "CCWRAP_VC_ARCH": "x86"
