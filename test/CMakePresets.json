{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 29,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/_build/${presetName}",
      "cacheVariables": {
        "TEST_TARGET_C": "2023",
        "TEST_TARGET_CXX": "2023"
      }
    },
    {
      "name": "vc145",
      "displayName": "VC 14.5 (VS2026) x64 -- c_test + cxx_test + etc_test/vc",
      "inherits": "base",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64"
    },
    {
      "name": "vc143",
      "displayName": "VC 14.3 (VS2022) x64 -- c_test + cxx_test + etc_test/vc",
      "inherits": "base",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64"
    },
    {
      "name": "gcc",
      "displayName": "g++/gcc (Linux / macOS / msys2) -- c_test + cxx_test",
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_CXX_STANDARD": "98",
        "CMAKE_BUILD_TYPE": "Debug"
      },
      "binaryDir": "${sourceDir}/_build/${hostSystemName}-${presetName}"
    },
    {
      "name": "gcc-latest",
      "inherits": "gcc",
      "displayName": "g++ -std=c++23 (the modern merged cases DO compile here)",
      "cacheVariables": {
        "CMAKE_CXX_STANDARD": "23"
      }
    },
    {
      "name": "gcc-cxx26",
      "inherits": "gcc",
      "displayName": "g++ -std=c++26 / gcc -std=c23 (spec 追従の主軸。最新規格を最も広く実装する構成)",
      "cacheVariables": {
        "CMAKE_CXX_STANDARD": "26",
        "CMAKE_C_STANDARD": "23",
        "TEST_TARGET_CXX": "2026",
        "TEST_TARGET_C": "2023"
      }
    },
    {
      "name": "clang",
      "inherits": "gcc",
      "displayName": "clang++/clang (Linux / macOS)",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "clang-latest",
      "inherits": "clang",
      "cacheVariables": {
        "CMAKE_CXX_STANDARD": "23"
      }
    },
    {
      "name": "clang-cxx26",
      "inherits": "clang",
      "displayName": "clang++ -std=c++26 / clang -std=c23",
      "cacheVariables": {
        "CMAKE_CXX_STANDARD": "26",
        "CMAKE_C_STANDARD": "23"
      }
    },
    {
      "name": "pcc",
      "displayName": "pcc (WSL / Linux) -- native C library, c_test only",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "pcc",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_C_FLAGS": "-U__GNUC__",
        "CMAKE_BUILD_TYPE": "Debug",
        "TEST_TARGET_C": "",
        "TST_SUITES": "c_test"
      },
      "binaryDir": "${sourceDir}/_build/${hostSystemName}-${presetName}"
    },
    {
      "name": "tcc",
      "displayName": "TinyCC (WSL / Linux) -- native C library, c_test only",
      "inherits": "pcc",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "tcc",
        "CMAKE_C_FLAGS": ""
      }
    },
    {
      "name": "dmc",
      "displayName": "Digital Mars C 8.x (Ninja, native C library)",
      "description": "dmc.exe is invoked directly; no dmc-cc or ccwrap is used. The selected suites are the tests that link against the DMC 8.x runtime.",
      "generator": "Ninja",
      "toolchainFile": "${sourceDir}/toolchains/dmc.cmake",
      "binaryDir": "${sourceDir}/_build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "TEST_TARGET_C": "",
        "TST_SUITES": "c_test",
        "TST_ONLY": "assert;ctype;fenv;float;iso646;limits;locale;setjmp;signal;stdarg;stdbool;stdlib;stdnoreturn;time"
      }
    },
    {
      "name": "orangec",
      "displayName": "Orange C/C++ 7.x (Ninja, native C library)",
      "description": "occ.exe is invoked directly through CMake's native OrangeC support; no ccwrap is used. Compile/link-unsupported suites are excluded, and known OrangeC 7.10.59 fatal library calls are conditionally skipped so CTest completes.",
      "generator": "Ninja",
      "toolchainFile": "${sourceDir}/toolchains/orangec.cmake",
      "binaryDir": "${sourceDir}/_build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "TEST_TARGET_C": "",
        "TST_SUITES": "c_test",
        "TST_ONLY": "assert;complex;ctype;errno;fenv;float;inttypes;iso646;locale;setjmp;signal;stdalign;stdarg;stdatomic;stdbool;stddef;stdio;stdlib;stdnoreturn;string;time;uchar;wchar;wctype"
      }
    },
    {
      "name": "watcom",
      "displayName": "Open Watcom 2.0 (win32) -- c_test + cxx_test + etc_test/watcom",
      "inherits": "base",
      "generator": "Watcom WMake",
      "environment": {
        "WATCOM": "C:/WATCOM",
        "PATH": "$env{WATCOM}/binnt64;$env{WATCOM}/binnt;$penv{PATH}",
        "EDPATH": "$env{WATCOM}/eddat",
        "INCLUDE": "$env{WATCOM}/h;$env{WATCOM}/h/nt"
      },
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "Windows",
        "CMAKE_C_COMPILER": "wcl386",
        "CMAKE_CXX_COMPILER": "wcl386",
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_FLAGS_DEBUG": "-d1",
        "CMAKE_CXX_FLAGS_DEBUG": "-d1",
        "CMAKE_WATCOM_RUNTIME_LIBRARY": "MultiThreaded",
        "TEST_TARGET_C": "2026",
        "TEST_TARGET_CXX": "2026"
      }
    },
    {
      "name": "watcom-noeh",
      "inherits": "watcom",
      "displayName": "Open Watcom (no exceptions and no RTTI) -- pairs with the -noeh lib; cxx_test only",
      "cacheVariables": {
        "TEST_NO_EH": "ON",
        "TEST_WATCOM_RTTI": "OFF",
        "TST_SUITES": "cxx_test"
      }
    },
    {
      "name": "watcom-xst",
      "inherits": "watcom",
      "displayName": "Open Watcom (-xst only, no RTTI) -- pairs with the -xst lib; needs `gen full`",
      "cacheVariables": {
        "TEST_WATCOM_RTTI": "OFF",
        "TST_SUITES": "cxx_test"
      }
    },
    {
      "name": "watcom-xrxs",
      "inherits": "watcom",
      "displayName": "Open Watcom 2.0 (win32), -xs exception model -- test only (A1''); pairs with the -xrxs lib",
      "cacheVariables": {
        "TEST_WATCOM_XS": "ON"
      }
    },
    {
      "name": "watcom-fs-char",
      "displayName": "Open Watcom 2.0 (win32), filesystem::path forced to char -- needs lib/ built with the -fs-char variants",
      "inherits": "watcom",
      "cacheVariables": {
        "TEST_FS_CHAR": "ON",
        "TST_SUITES": "cxx_test"
      }
    },
    {
      "name": "watcom-ccwstd",
      "inherits": "watcom",
      "displayName": "Open Watcom (ccwstd relocation) -- cxx_test only",
      "description": "libcxx03 を ccwstd 名前空間へ再配置した環境。C スイートは std/ccwstd の区別が無いので cxx_test だけを回す。",
      "cacheVariables": {
        "TST_NS": "ccwstd",
        "TST_SUITES": "cxx_test"
      }
    },
    {
      "name": "watcom-std",
      "inherits": "watcom",
      "displayName": "Open Watcom, native C library only (no ccwrap) -- c_test only",
      "description": "ccwrap を一切通さない素の Open Watcom ベースライン。C++ 側は純正ライブラリが貧弱すぎて成立しないので c_test だけ。ここで落ちる分が ccwrap の補充分そのもの。",
      "cacheVariables": {
        "TST_SUITES": "c_test",
        "TEST_TARGET_C": ""
      }
    },
    {
      "name": "gcc-std",
      "hidden": true,
      "inherits": "gcc",
      "displayName": "g++ 素の libstdc++ (ccwrap 無し) -- C++ 規格別スイープの土台",
      "cacheVariables": {
        "TEST_TARGET_CXX": "",
        "TEST_TARGET_C": "",
        "TST_SUITES": "cxx_test"
      }
    },
    {
      "name": "gcc-std-cxx03",
      "inherits": "gcc-std",
      "displayName": "g++ -std=c++98 / 素の libstdc++",
      "cacheVariables": {
