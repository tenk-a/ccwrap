// ccwrap gcc forwarder for <stop_token>. libstdc++ ships the file but keeps its contents
// behind a language-version gate, so __has_include_next alone would land on an empty
// header. Take the native one only when the mode is C++20 or later; otherwise llibcxx03.
#pragma once

#include <ccwrap_common.h>

#if defined(__has_include_next) && defined(__cplusplus) && __cplusplus >= 202002L
# if __has_include_next(<stop_token>)
#  define _CCW_HAVE_NATIVE_STOP_TOKEN 1
# endif
#endif

#ifdef _CCW_HAVE_NATIVE_STOP_TOKEN
# include_next <stop_token>
#else
# include <../../detail/llibcxx03/include/stop_token>
#endif
