#if defined(__cplusplus) && ((__cplusplus < 201103L && !defined(_CCW_STD_LIB_LIBCXX)) || \
    (defined(_LIBCPP_VERSION) && __cplusplus > 202302L && \
     !defined(_LIBCPP_ENABLE_CXX26_REMOVED_WSTRING_CONVERT)))
#include <../../detail/llibcxx03/include/__locale_dir/wstring_convert.h>
#endif

#if __cplusplus < 201103L && !defined(_CCW_STD_LIB_LIBCXX)
namespace std {
template <class _CharT>
inline bool isblank(_CharT __c, const locale& __loc) {
    const ctype<_CharT>& __ct = use_facet<ctype<_CharT> >(__loc);
    if (!__ct.is(ctype_base::space, __c)) return false;
    return __c != __ct.widen('\n') && __c != __ct.widen('\v')
        && __c != __ct.widen('\f') && __c != __ct.widen('\r');
}
}
#endif
