 namespace _ccw { using std::shared_mutex; }
 #endif
#else
#if defined(_WIN32)
 #include <../../detail/cxx/win/shared_mutex.hpp>
#else
 // the C++03 stand-in is Win32-only; elsewhere the native header decides
 #include_next <shared_mutex>
#endif
#endif
