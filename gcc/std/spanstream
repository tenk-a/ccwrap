// ccwrap gcc forwarder for <spanstream>. libstdc++ ships the file but keeps its contents
// behind a language-version gate, so __has_include_next alone would land on an empty
// header. Take the native one only when the mode is C++23 or later; otherwise llibcxx03.
#pragma once

#include <ccwrap_common.h>

#if defined(__has_include_next) && defined(__cplusplus) && __cplusplus >= 202302L
# if __has_include_next(<spanstream>)
#  define _CCW_HAVE_NATIVE_SPANSTREAM 1
# endif
#endif

#ifdef _CCW_HAVE_NATIVE_SPANSTREAM
# include_next <spanstream>
#else
# include <../../detail/llibcxx03/include/spanstream>
#endif
