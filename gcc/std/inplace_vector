// ccwrap gcc forwarder for <inplace_vector>. libstdc++ ships the file but keeps its contents
// behind a language-version gate, so __has_include_next alone would land on an empty
// header. Take the native one only when the mode is C++26 or later; otherwise llibcxx03.
#pragma once

#include <ccwrap_common.h>

#if defined(__has_include_next) && defined(__cplusplus) && __cplusplus >= 202400L
# if __has_include_next(<inplace_vector>)
#  define _CCW_HAVE_NATIVE_INPLACE_VECTOR 1
# endif
#endif

#ifdef _CCW_HAVE_NATIVE_INPLACE_VECTOR
# include_next <inplace_vector>
#else
# include <../../detail/llibcxx03/include/inplace_vector>
#endif
