// ccwrap vc forwarder for <ios>. MSVC ships this one, so ccwrap only needs a door here:
// the door exists so that nothing resolves into detail/llibcxx03/include by accident (that
// directory is on the include path for the headers MSVC does NOT have), and so there is
// somewhere to add supplements later.
#pragma once

#include <ccwrap_common.h>

#include _CCW_NATIVE_STL_HEADER_PATH(ios)

#if defined(__cplusplus) && _MSC_VER < 1600
namespace std {
inline ios_base& defaultfloat(ios_base& __s) { __s.unsetf(ios_base::floatfield); return __s; }
}
#endif

#if defined(__cplusplus) && _MSC_VER < 1500
namespace std {
inline ios_base& hexfloat(ios_base& __s) {
    __s.setf(ios_base::fixed | ios_base::scientific, ios_base::floatfield);
    return __s;
}
}
#endif
