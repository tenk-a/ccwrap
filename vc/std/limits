// ccwrap vc forwarder for <limits>. MSVC ships this one, so ccwrap only needs a door here:
// the door exists so that nothing resolves into detail/llibcxx03/include by accident (that
// directory is on the include path for the headers MSVC does NOT have), and so there is
// somewhere to add supplements later.
#pragma once

#include <ccwrap_common.h>

#include _CCW_NATIVE_STL_HEADER_PATH(limits)

#if defined(__cplusplus) && _MSC_VER < 1600
namespace std {
template <class _Tp> class numeric_limits<const _Tp>          : public numeric_limits<_Tp> {};
template <class _Tp> class numeric_limits<volatile _Tp>       : public numeric_limits<_Tp> {};
template <class _Tp> class numeric_limits<const volatile _Tp> : public numeric_limits<_Tp> {};
}
#endif
