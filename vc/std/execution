// ccwrap vc forwarder for <execution>. This is one of the headers MSVC does not always ship,
// so it comes from libcxx03 when the toolchain has none of its own.
//
// The choice is made with __has_include on the NATIVE path. Every MSVC that has this
// header is newer than the one that gained __has_include (VS2017 15.3), so "no
// __has_include" safely means "no native header" -- vc120 lands on libcxx03, vc145 on
// its own.
#pragma once

#include <ccwrap_common.h>

#if defined(__has_include)
# if __has_include(_CCW_NATIVE_STL_HEADER_PATH(execution))
#  define _CCW_HAVE_NATIVE_EXECUTION 1
# endif
#endif

#ifdef _CCW_HAVE_NATIVE_EXECUTION
# include _CCW_NATIVE_STL_HEADER_PATH(execution)
#else
# include <../../detail/llibcxx03/include/execution>
#endif

#if defined(__cplusplus) && defined(_CCW_HAVE_NATIVE_EXECUTION) \
    && _CCW_TARGET_CXX >= 2020 \
    && (!defined(__cpp_lib_execution) || __cpp_lib_execution < 201902L)
namespace std { namespace execution {
class unsequenced_policy : public _CCW_STD::_Sequenced_policy_tag {
public:
    typedef int _Standard_execution_policy;
};
_ccw_inline_const unsequenced_policy unseq = unsequenced_policy();
} }
namespace std {
template <> struct is_execution_policy<execution::unsequenced_policy> : public true_type {};
}
#endif
