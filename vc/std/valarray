// ccwrap vc forwarder for <valarray>. MSVC ships this one, so ccwrap only needs a door here:
// the door exists so that nothing resolves into detail/llibcxx03/include by accident (that
// directory is on the include path for the headers MSVC does NOT have), and so there is
// somewhere to add supplements later.
#pragma once

#include <ccwrap_common.h>

#include _CCW_NATIVE_STL_HEADER_PATH(valarray)

#if defined(__cplusplus) && _MSC_VER < 1600
namespace std {
template <class _Tp> inline _Tp* begin(valarray<_Tp>& __v) { return __v.size() ? &__v[0] : (_Tp*)0; }
template <class _Tp> inline _Tp* end(valarray<_Tp>& __v)   { return __v.size() ? &__v[0] + __v.size() : (_Tp*)0; }
template <class _Tp> inline const _Tp* begin(const valarray<_Tp>& __v) {
    return __v.size() ? &const_cast<valarray<_Tp>&>(__v)[0] : (const _Tp*)0;
}
template <class _Tp> inline const _Tp* end(const valarray<_Tp>& __v) {
    return __v.size() ? &const_cast<valarray<_Tp>&>(__v)[0] + __v.size() : (const _Tp*)0;
}
}
#endif
