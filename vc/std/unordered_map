#include <iterator>

#if defined(__cplusplus) && !defined(__cpp_lib_erase_if) && _MSC_VER >= 1700
namespace _CCW_STD20 {
template <class _Key, class _Tp, class _Hash, class _Eq, class _Alloc, class _Pred>
inline typename std::unordered_map<_Key, _Tp, _Hash, _Eq, _Alloc>::size_type erase_if(std::unordered_map<_Key, _Tp, _Hash, _Eq, _Alloc>& __c, _Pred __p) {
    typename std::unordered_map<_Key, _Tp, _Hash, _Eq, _Alloc>::size_type __n = 0;
    for (typename std::unordered_map<_Key, _Tp, _Hash, _Eq, _Alloc>::iterator __i = __c.begin(); __i != __c.end(); ) {
        if (__p(*__i)) { __c.erase(__i++); ++__n; } else { ++__i; }
    }
    return __n;
}

template <class _Key, class _Tp, class _Hash, class _Eq, class _Alloc, class _Pred>
inline typename std::unordered_multimap<_Key, _Tp, _Hash, _Eq, _Alloc>::size_type erase_if(std::unordered_multimap<_Key, _Tp, _Hash, _Eq, _Alloc>& __c, _Pred __p) {
    typename std::unordered_multimap<_Key, _Tp, _Hash, _Eq, _Alloc>::size_type __n = 0;
    for (typename std::unordered_multimap<_Key, _Tp, _Hash, _Eq, _Alloc>::iterator __i = __c.begin(); __i != __c.end(); ) {
        if (__p(*__i)) { __c.erase(__i++); ++__n; } else { ++__i; }
    }
    return __n;
}

