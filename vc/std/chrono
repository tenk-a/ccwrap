template <class _ToDur, class _Rep, class _Period>
inline _ToDur floor(const duration<_Rep, _Period>& __d) {
    _ToDur __t = duration_cast<_ToDur>(__d);
    if (duration_cast<duration<_Rep, _Period> >(__t).count() > __d.count()) __t = __t - _ToDur(1);
    return __t;
}
template <class _ToDur, class _Rep, class _Period>
inline _ToDur ceil(const duration<_Rep, _Period>& __d) {
    _ToDur __t = duration_cast<_ToDur>(__d);
    if (duration_cast<duration<_Rep, _Period> >(__t).count() < __d.count()) __t = __t + _ToDur(1);
    return __t;
}
template <class _ToDur, class _Rep, class _Period>
inline _ToDur round(const duration<_Rep, _Period>& __d) {
    _ToDur __t = duration_cast<_ToDur>(__d);
    long long __back = (long long)duration_cast<duration<_Rep, _Period> >(__t).count();
    long long __dc   = (long long)__d.count();
    _ToDur __lo = __t, __hi = __t;
    if      (__back > __dc) __lo = __t - _ToDur(1);
    else if (__back < __dc) __hi = __t + _ToDur(1);
    else return __t;
    long long __dlo = __dc - (long long)duration_cast<duration<_Rep, _Period> >(__lo).count();
    long long __dhi = (long long)duration_cast<duration<_Rep, _Period> >(__hi).count() - __dc;
    if (__dlo < __dhi) return __lo;
    if (__dhi < __dlo) return __hi;
    return ((long long)__lo.count() & 1) ? __hi : __lo;
}
template <class _ToDur, class _Clock, class _Dur>
inline time_point<_Clock, _ToDur> floor(const time_point<_Clock, _Dur>& __t) {
    return time_point<_Clock, _ToDur>(chrono::floor<_ToDur>(__t.time_since_epoch()));
}
template <class _ToDur, class _Clock, class _Dur>
inline time_point<_Clock, _ToDur> ceil(const time_point<_Clock, _Dur>& __t) {
