#if defined(__cplusplus) && !defined(__cpp_lib_hypot) && _MSC_VER >= 1600
namespace _CCW_STD17 {
inline double __ccw_hypot3(double __x, double __y, double __z) {
    if (__x < 0) __x = -__x;
    if (__y < 0) __y = -__y;
    if (__z < 0) __z = -__z;
    double __m = __x > __y ? (__x > __z ? __x : __z) : (__y > __z ? __y : __z);
    if (__m == 0.0) return 0.0;
    __x /= __m; __y /= __m; __z /= __m;
    return __m * ::sqrt(__x * __x + __y * __y + __z * __z);
}
inline float       hypot(float __x, float __y, float __z)                   { return (float)__ccw_hypot3(__x, __y, __z); }
inline double      hypot(double __x, double __y, double __z)                { return __ccw_hypot3(__x, __y, __z); }
inline long double hypot(long double __x, long double __y, long double __z) { return (long double)__ccw_hypot3((double)__x, (double)__y, (double)__z); }
}
#endif

