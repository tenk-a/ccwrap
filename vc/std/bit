 namespace _CCW_STD23 {
 using namespace ::std;
 template<class T>
 inline T byteswap(T v) noexcept {
     unsigned char* p = reinterpret_cast<unsigned char*>(&v);
     for (std::size_t i = 0, j = sizeof(T) - 1; i < j; ++i, --j) {
         unsigned char t = p[i]; p[i] = p[j]; p[j] = t;
     }
     return v;
 }
 }   // _CCW_STD23
