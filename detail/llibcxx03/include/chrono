template <class _Rep1, class _Period1, class _Rep2, class _Period2>
_CCW_LIBCPP_HIDE_FROM_ABI bool operator!=(const duration<_Rep1, _Period1>& __x, const duration<_Rep2, _Period2>& __y) { return !(__x == __y); }
