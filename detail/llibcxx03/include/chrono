class system_clock {
public:
    typedef chrono::seconds                          duration;
    typedef duration::rep                            rep;
    typedef duration::period                         period;
    typedef chrono::time_point<system_clock, duration> time_point;
    static const bool is_steady = false;

    _CCW_LIBCPP_HIDE_FROM_ABI static time_point now() { return time_point(duration((long long)_CCW_STD::time(0))); }
    _CCW_LIBCPP_HIDE_FROM_ABI static _CCW_STD::time_t to_time_t(const time_point& __t) { return (_CCW_STD::time_t)__t.time_since_epoch().count(); }
    _CCW_LIBCPP_HIDE_FROM_ABI static time_point from_time_t(_CCW_STD::time_t __t) { return time_point(duration((long long)__t)); }
};

