namespace chrono {

class steady_clock {
public:
    typedef chrono::milliseconds                     duration;
    typedef duration::rep                            rep;
    typedef duration::period                         period;
    typedef chrono::time_point<steady_clock, duration> time_point;
    static const bool is_steady = true;

    _CCW_LIBCPP_HIDE_FROM_ABI static time_point now() {
        long long __ms = (long long)_CCW_STD::clock() * 1000 / (long long)CLOCKS_PER_SEC;
        return time_point(duration(__ms));
    }
};
typedef steady_clock high_resolution_clock;

typedef char __is_clock_y;
struct       __is_clock_n { char __x_[2]; };
template <class _Tp> __is_clock_y __is_clock_members(int,
    typename _Tp::rep* = 0, typename _Tp::period* = 0,
    typename _Tp::duration* = 0, typename _Tp::time_point* = 0);
template <class _Tp> __is_clock_n __is_clock_members(long);

template <class _Tp> __is_clock_y __is_clock_hasclock(int, typename _Tp::clock* = 0);
template <class _Tp> __is_clock_n __is_clock_hasclock(long);

template <class _Tp> struct __is_clock_raw {
    enum { __has_members = sizeof(chrono::__is_clock_members<_Tp>(0)) == sizeof(chrono::__is_clock_y) };
    enum { __has_clock   = sizeof(chrono::__is_clock_hasclock<_Tp>(0)) == sizeof(chrono::__is_clock_y) };
    enum { __is_cls      = is_class<_Tp>::value };
    enum { value         = __has_members && __is_cls && !__has_clock };
};

template <class _Tp> struct is_clock {
    enum { value = __is_clock_raw<_Tp>::value };
};

