template <class _Period1, class _Period2>
struct __ccw_common_period {
    static const long long __gnum = __static_gcd<_Period1::num + 0, _Period2::num + 0>::value;
    static const long long __gden = __static_gcd<_Period1::den + 0, _Period2::den + 0>::value;
    static const long long __lden = (_Period1::den / __gden) * _Period2::den;   // lcm, divide first
    typedef ratio<__gnum + 0, __lden + 0> type;
};

