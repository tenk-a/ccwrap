template <class _Rep, class _Period> class duration;

template <class _ToDuration, class _Rep, class _Period>
_CCW_LIBCPP_HIDE_FROM_ABI _ToDuration duration_cast(const duration<_Rep, _Period>& __d) {
    typedef typename _ToDuration::period _Pt;
    long long __n = (long long)__d.count() * (_Period::num * _Pt::den);
    return _ToDuration((typename _ToDuration::rep)(__n / (_Period::den * _Pt::num)));
}

template <class _Rep, class _Period>
class duration {
    _Rep __r_;
public:
    typedef _Rep    rep;
    typedef _Period period;

    _CCW_LIBCPP_HIDE_FROM_ABI duration() : __r_(0) {}
    _CCW_LIBCPP_HIDE_FROM_ABI explicit duration(const _Rep& __r) : __r_(__r) {}
    template <class _Rep2, class _Period2>
    _CCW_LIBCPP_HIDE_FROM_ABI duration(const duration<_Rep2, _Period2>& __d)
        : __r_((_Rep)((long long)__d.count() * (_Period2::num * _Period::den) / (_Period2::den * _Period::num))) {}

    _CCW_LIBCPP_HIDE_FROM_ABI rep count() const { return __r_; }

    _CCW_LIBCPP_HIDE_FROM_ABI static duration zero() { return duration(_Rep(0)); }
    _CCW_LIBCPP_HIDE_FROM_ABI static duration min()  { _Rep __v = _CCW_STD::numeric_limits<_Rep>::min(); return duration(__v); }
    _CCW_LIBCPP_HIDE_FROM_ABI static duration max()  { _Rep __v = _CCW_STD::numeric_limits<_Rep>::max(); return duration(__v); }

    _CCW_LIBCPP_HIDE_FROM_ABI duration operator+() const { return *this; }
    _CCW_LIBCPP_HIDE_FROM_ABI duration operator-() const { return duration(-__r_); }
    _CCW_LIBCPP_HIDE_FROM_ABI duration& operator++()    { ++__r_; return *this; }
    _CCW_LIBCPP_HIDE_FROM_ABI duration  operator++(int) { duration __t(*this); ++__r_; return __t; }
    _CCW_LIBCPP_HIDE_FROM_ABI duration& operator--()    { --__r_; return *this; }
    _CCW_LIBCPP_HIDE_FROM_ABI duration  operator--(int) { duration __t(*this); --__r_; return __t; }
    _CCW_LIBCPP_HIDE_FROM_ABI duration& operator+=(const duration& __d) { __r_ += __d.__r_; return *this; }
    _CCW_LIBCPP_HIDE_FROM_ABI duration& operator-=(const duration& __d) { __r_ -= __d.__r_; return *this; }
    _CCW_LIBCPP_HIDE_FROM_ABI duration& operator*=(const rep& __x) { __r_ *= __x; return *this; }
    _CCW_LIBCPP_HIDE_FROM_ABI duration& operator/=(const rep& __x) { __r_ /= __x; return *this; }
    _CCW_LIBCPP_HIDE_FROM_ABI duration& operator%=(const rep& __x) { __r_ %= __x; return *this; }
    _CCW_LIBCPP_HIDE_FROM_ABI duration& operator%=(const duration& __d) { __r_ %= __d.__r_; return *this; }
};

template <class _Rep1, class _Period1, class _Rep2, class _Period2>
_CCW_LIBCPP_HIDE_FROM_ABI typename common_type<duration<_Rep1, _Period1>, duration<_Rep2, _Period2> >::type
operator+(const duration<_Rep1, _Period1>& __x, const duration<_Rep2, _Period2>& __y) {
    typedef typename common_type<duration<_Rep1, _Period1>, duration<_Rep2, _Period2> >::type _Cd;
    _Cd __r(duration_cast<_Cd>(__x));
    __r += duration_cast<_Cd>(__y);
    return __r;
}
template <class _Rep1, class _Period1, class _Rep2, class _Period2>
_CCW_LIBCPP_HIDE_FROM_ABI typename common_type<duration<_Rep1, _Period1>, duration<_Rep2, _Period2> >::type
operator-(const duration<_Rep1, _Period1>& __x, const duration<_Rep2, _Period2>& __y) {
    typedef typename common_type<duration<_Rep1, _Period1>, duration<_Rep2, _Period2> >::type _Cd;
    _Cd __r(duration_cast<_Cd>(__x));
    __r -= duration_cast<_Cd>(__y);
    return __r;
}
