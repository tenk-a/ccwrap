template <class _Dur, class _Rep2>
struct __ccw_dur_div {          // right operand is a scalar: scale the count
    typedef _Dur type;
    _CCW_LIBCPP_HIDE_FROM_ABI static type __apply(const _Dur& __x, const _Rep2& __y) {
        return _Dur((typename _Dur::rep)(__x.count() / __y));
    }
};
template <class _Dur, class _Rep2, class _Period2>
struct __ccw_dur_div<_Dur, duration<_Rep2, _Period2> > {    // right operand is a duration
    typedef typename common_type<typename _Dur::rep, _Rep2>::type type;
    _CCW_LIBCPP_HIDE_FROM_ABI static type __apply(const _Dur& __x, const duration<_Rep2, _Period2>& __y) {
        typedef typename common_type<_Dur, duration<_Rep2, _Period2> >::type _Cd;
        return (type)(duration_cast<_Cd>(__x).count() / duration_cast<_Cd>(__y).count());
    }
};

template <class _Dur, class _Rep2>
struct __ccw_dur_mod {
    typedef _Dur type;
    _CCW_LIBCPP_HIDE_FROM_ABI static type __apply(const _Dur& __x, const _Rep2& __y) {
        return _Dur((typename _Dur::rep)(__x.count() % __y));
    }
};
template <class _Dur, class _Rep2, class _Period2>
struct __ccw_dur_mod<_Dur, duration<_Rep2, _Period2> > {
    typedef typename common_type<_Dur, duration<_Rep2, _Period2> >::type type;
    _CCW_LIBCPP_HIDE_FROM_ABI static type __apply(const _Dur& __x, const duration<_Rep2, _Period2>& __y) {
        type __r(duration_cast<type>(__x));
        __r %= duration_cast<type>(__y);
        return __r;
    }
};

template <class _Rep, class _Period, class _Rep2>
_CCW_LIBCPP_HIDE_FROM_ABI typename __ccw_dur_div<duration<_Rep, _Period>, _Rep2>::type
operator/(const duration<_Rep, _Period>& __x, const _Rep2& __y) {
    return __ccw_dur_div<duration<_Rep, _Period>, _Rep2>::__apply(__x, __y);
}
template <class _Rep, class _Period, class _Rep2>
_CCW_LIBCPP_HIDE_FROM_ABI typename __ccw_dur_mod<duration<_Rep, _Period>, _Rep2>::type
operator%(const duration<_Rep, _Period>& __x, const _Rep2& __y) {
    return __ccw_dur_mod<duration<_Rep, _Period>, _Rep2>::__apply(__x, __y);
}

template <class _ToDur, class _Rep, class _Period>
_CCW_LIBCPP_HIDE_FROM_ABI _ToDur floor(const duration<_Rep, _Period>& __d) {
    _ToDur __t = duration_cast<_ToDur>(__d);
    if (duration_cast<duration<_Rep, _Period> >(__t).count() > __d.count()) __t = __t - _ToDur(1);
    return __t;
}
template <class _ToDur, class _Rep, class _Period>
_CCW_LIBCPP_HIDE_FROM_ABI _ToDur ceil(const duration<_Rep, _Period>& __d) {
    _ToDur __t = duration_cast<_ToDur>(__d);
    if (duration_cast<duration<_Rep, _Period> >(__t).count() < __d.count()) __t = __t + _ToDur(1);
    return __t;
}
template <class _ToDur, class _Rep, class _Period>
_CCW_LIBCPP_HIDE_FROM_ABI _ToDur round(const duration<_Rep, _Period>& __d) {
    _ToDur __t = duration_cast<_ToDur>(__d);   // truncated toward zero
    duration<_Rep, _Period> __bt = duration_cast<duration<_Rep, _Period> >(__t);
    long long __back = (long long)__bt.count(), __dc = (long long)__d.count();
    _ToDur __lo = __t, __hi = __t;
    if (__back > __dc)      __lo = __t - _ToDur(1);   // t overshot: floor = t-1
    else if (__back < __dc) __hi = __t + _ToDur(1);   // t undershot: ceil = t+1
    else return __t;                                 // exact
    duration<_Rep, _Period> __blo = duration_cast<duration<_Rep, _Period> >(__lo);
    duration<_Rep, _Period> __bhi = duration_cast<duration<_Rep, _Period> >(__hi);
    long long __dlo = __dc - (long long)__blo.count();
    long long __dhi = (long long)__bhi.count() - __dc;
    if (__dlo < __dhi) return __lo;
    if (__dhi < __dlo) return __hi;
    return ((long long)__lo.count() & 1) ? __hi : __lo;   // ties to even
}
template <class _Rep, class _Period>
_CCW_LIBCPP_HIDE_FROM_ABI duration<_Rep, _Period> abs(const duration<_Rep, _Period>& __d) { return __d.count() < 0 ? -__d : __d; }

