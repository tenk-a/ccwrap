class time_point {
    _Duration __d_;
public:
    typedef _Clock    clock;
    typedef _Duration duration;
    typedef typename _Duration::rep    rep;
    typedef typename _Duration::period period;

    _CCW_LIBCPP_HIDE_FROM_ABI time_point() : __d_() {}
    _CCW_LIBCPP_HIDE_FROM_ABI explicit time_point(const _Duration& __d) : __d_(__d) {}
    template <class _Duration2>
    _CCW_LIBCPP_HIDE_FROM_ABI time_point(const time_point<_Clock, _Duration2>& __t) : __d_(__t.time_since_epoch()) {}
    _CCW_LIBCPP_HIDE_FROM_ABI _Duration time_since_epoch() const { return __d_; }

    _CCW_LIBCPP_HIDE_FROM_ABI time_point& operator+=(const _Duration& __d) { __d_ += __d; return *this; }
    _CCW_LIBCPP_HIDE_FROM_ABI time_point& operator-=(const _Duration& __d) { __d_ -= __d; return *this; }

    _CCW_LIBCPP_HIDE_FROM_ABI static time_point min() { return time_point(_Duration::min()); }
    _CCW_LIBCPP_HIDE_FROM_ABI static time_point max() { return time_point(_Duration::max()); }
};

template <class _ToDur, class _Clock, class _Duration>
_CCW_LIBCPP_HIDE_FROM_ABI time_point<_Clock, _ToDur> time_point_cast(const time_point<_Clock, _Duration>& __t) {
    _ToDur __cd = duration_cast<_ToDur>(__t.time_since_epoch());   // split out: nesting a template-id
    return time_point<_Clock, _ToDur>(__cd);                       // call inside a template-id type trips Watcom
}
template <class _Clock, class _Duration1, class _Rep2, class _Period2>
_CCW_LIBCPP_HIDE_FROM_ABI time_point<_Clock, typename common_type<_Duration1, duration<_Rep2, _Period2> >::type>
operator+(const time_point<_Clock, _Duration1>& __t, const duration<_Rep2, _Period2>& __d) {
    typedef typename common_type<_Duration1, duration<_Rep2, _Period2> >::type _Cd;
    _Cd __r = duration_cast<_Cd>(__t.time_since_epoch()) + __d;
    return time_point<_Clock, _Cd>(__r);
}
template <class _Clock, class _Duration1, class _Rep2, class _Period2>
_CCW_LIBCPP_HIDE_FROM_ABI time_point<_Clock, typename common_type<_Duration1, duration<_Rep2, _Period2> >::type>
operator+(const duration<_Rep2, _Period2>& __d, const time_point<_Clock, _Duration1>& __t) { return __t + __d; }
template <class _Clock, class _Duration1, class _Rep2, class _Period2>
_CCW_LIBCPP_HIDE_FROM_ABI time_point<_Clock, typename common_type<_Duration1, duration<_Rep2, _Period2> >::type>
operator-(const time_point<_Clock, _Duration1>& __t, const duration<_Rep2, _Period2>& __d) {
    typedef typename common_type<_Duration1, duration<_Rep2, _Period2> >::type _Cd;
    _Cd __r = duration_cast<_Cd>(__t.time_since_epoch()) - __d;
    return time_point<_Clock, _Cd>(__r);
}

