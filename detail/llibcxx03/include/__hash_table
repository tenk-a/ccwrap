#include "__utility/pair.h"
#include "__memory/allocator.h"
#include <vector>
#include <cstddef>
#include <new>
#if _CCW_HAS_REAL_RVALUE_REF
# define _CCW_HT_FWD(x)  ::_ccw::move(x)
#else
# define _CCW_HT_FWD(x)  (x)
#endif

_CCW_LIBCPP_BEGIN_NAMESPACE_STD

template <class _Value>
struct __hash_node {
    __hash_node* __next_;
    _Value       __value_;
    _CCW_LIBCPP_HIDE_FROM_ABI __hash_node(const _Value& __v) : __next_(0), __value_(__v) {}
#if _CCW_HAS_REAL_RVALUE_REF
    _CCW_LIBCPP_HIDE_FROM_ABI __hash_node(_Value&& __v) : __next_(0), __value_(_ccw::move(__v)) {}
#else
    _CCW_LIBCPP_HIDE_FROM_ABI __hash_node(_CCW_RV_REF(_Value) __v) : __next_(0), __value_(__v) {}
#endif // _CCW_HAS_REAL_RVALUE_REF
};

template <class _Value, class _Ref, class _Ptr>
class __hash_iterator {
    typedef __hash_node<_Value> __node;
    __node*  __nd_;
    __node** __bkt_;
    __node** __bend_;
public:
    typedef forward_iterator_tag iterator_category;
    typedef _Value               value_type;
    typedef _CCW_STD::ptrdiff_t       difference_type;
    typedef _Ptr                 pointer;
    typedef _Ref                 reference;

    _CCW_LIBCPP_HIDE_FROM_ABI __hash_iterator() : __nd_(0), __bkt_(0), __bend_(0) {}
    _CCW_LIBCPP_HIDE_FROM_ABI __hash_iterator(__node* __n, __node** __b, __node** __e) : __nd_(__n), __bkt_(__b), __bend_(__e) {}
    _CCW_LIBCPP_HIDE_FROM_ABI __hash_iterator(const __hash_iterator<_Value, _Value&, _Value*>& __o)
        : __nd_(__o.__node_()), __bkt_(__o.__bkt()), __bend_(__o.__bend()) {}

    _CCW_LIBCPP_HIDE_FROM_ABI __node*  __node_() const { return __nd_; }   // name differs from the __node type
    _CCW_LIBCPP_HIDE_FROM_ABI __node** __bkt()  const { return __bkt_; }
    _CCW_LIBCPP_HIDE_FROM_ABI __node** __bend() const { return __bend_; }

    _CCW_LIBCPP_HIDE_FROM_ABI reference operator*()  const { return __nd_->__value_; }
    _CCW_LIBCPP_HIDE_FROM_ABI pointer   operator->() const { return &__nd_->__value_; }
    _CCW_LIBCPP_HIDE_FROM_ABI __hash_iterator& operator++() {
        if (__nd_->__next_) { __nd_ = __nd_->__next_; }
        else { do { ++__bkt_; } while (__bkt_ != __bend_ && *__bkt_ == 0); __nd_ = (__bkt_ != __bend_) ? *__bkt_ : 0; }
        return *this;
    }
    _CCW_LIBCPP_HIDE_FROM_ABI __hash_iterator operator++(int) { __hash_iterator __t = *this; ++*this; return __t; }
    _CCW_LIBCPP_HIDE_FROM_ABI bool operator==(const __hash_iterator& __o) const { return __nd_ == __o.__nd_; }
    _CCW_LIBCPP_HIDE_FROM_ABI bool operator!=(const __hash_iterator& __o) const { return __nd_ != __o.__nd_; }
};

template <class _Value, class _Ref, class _Ptr>
class __hash_local_iterator {
    typedef __hash_node<_Value> __node;
    __node* __nd_;
public:
    typedef forward_iterator_tag iterator_category;
    typedef _Value               value_type;
    typedef _CCW_STD::ptrdiff_t       difference_type;
    typedef _Ptr                 pointer;
    typedef _Ref                 reference;

    _CCW_LIBCPP_HIDE_FROM_ABI __hash_local_iterator() : __nd_(0) {}
    _CCW_LIBCPP_HIDE_FROM_ABI explicit __hash_local_iterator(__node* __n) : __nd_(__n) {}
    _CCW_LIBCPP_HIDE_FROM_ABI __hash_local_iterator(const __hash_local_iterator<_Value, _Value&, _Value*>& __o)
        : __nd_(__o.__node_()) {}

    _CCW_LIBCPP_HIDE_FROM_ABI __node* __node_() const { return __nd_; }
    _CCW_LIBCPP_HIDE_FROM_ABI reference operator*()  const { return __nd_->__value_; }
    _CCW_LIBCPP_HIDE_FROM_ABI pointer   operator->() const { return &__nd_->__value_; }
