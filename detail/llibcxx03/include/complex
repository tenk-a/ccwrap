template <class _Tp> _CCW_LIBCPP_HIDE_FROM_ABI _Tp real(const complex<_Tp>& __c) { return __c.real(); }
template <class _Tp> _CCW_LIBCPP_HIDE_FROM_ABI _Tp imag(const complex<_Tp>& __c) { return __c.imag(); }
template <class _Tp> _CCW_LIBCPP_HIDE_FROM_ABI _Tp abs(const complex<_Tp>& __c)  { return _CCW_STD::sqrt(__c.real() * __c.real() + __c.imag() * __c.imag()); }
template <class _Tp> _CCW_LIBCPP_HIDE_FROM_ABI _Tp arg(const complex<_Tp>& __c)  { return _CCW_STD::atan2(__c.imag(), __c.real()); }
template <class _Tp> _CCW_LIBCPP_HIDE_FROM_ABI _Tp norm(const complex<_Tp>& __c) { return __c.real() * __c.real() + __c.imag() * __c.imag(); }
template <class _Tp> _CCW_LIBCPP_HIDE_FROM_ABI complex<_Tp> conj(const complex<_Tp>& __c) { return complex<_Tp>(__c.real(), -__c.imag()); }
template <class _Tp> _CCW_LIBCPP_HIDE_FROM_ABI complex<_Tp> polar(const _Tp& __r, const _Tp& __theta = _Tp()) { return complex<_Tp>(__r * _CCW_STD::cos(__theta), __r * _CCW_STD::sin(__theta)); }

template <class _Tp> _CCW_LIBCPP_HIDE_FROM_ABI complex<_Tp> exp(const complex<_Tp>& __c) {
    _Tp __e = _CCW_STD::exp(__c.real());
    return complex<_Tp>(__e * _CCW_STD::cos(__c.imag()), __e * _CCW_STD::sin(__c.imag()));
}
template <class _Tp> _CCW_LIBCPP_HIDE_FROM_ABI complex<_Tp> log(const complex<_Tp>& __c)  { return complex<_Tp>(_CCW_STD::log(_CCW_STD::abs(__c)), _CCW_STD::arg(__c)); }
template <class _Tp> _CCW_LIBCPP_HIDE_FROM_ABI complex<_Tp> log10(const complex<_Tp>& __c) { return _CCW_STD::log(__c) / _Tp(_CCW_STD::log((_Tp)10)); }
template <class _Tp> _CCW_LIBCPP_HIDE_FROM_ABI complex<_Tp> sqrt(const complex<_Tp>& __c)  { return _CCW_STD::polar((_Tp)_CCW_STD::sqrt(_CCW_STD::abs(__c)), (_Tp)(_CCW_STD::arg(__c) / 2)); }
template <class _Tp> _CCW_LIBCPP_HIDE_FROM_ABI complex<_Tp> pow(const complex<_Tp>& __x, const complex<_Tp>& __y) { return _CCW_STD::exp(__y * _CCW_STD::log(__x)); }
