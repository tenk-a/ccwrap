#if defined(_CCW_COMPLEX_HAS_STREAMS)
template <class _CharT, class _Traits, class _Tp>
_CCW_LIBCPP_HIDE_FROM_ABI basic_ostream<_CharT, _Traits>& operator<<(basic_ostream<_CharT, _Traits>& __os, const complex<_Tp>& __c) {
    return __os << '(' << __c.real() << ',' << __c.imag() << ')';
}
template <class _CharT, class _Traits, class _Tp>
_CCW_LIBCPP_HIDE_FROM_ABI basic_istream<_CharT, _Traits>& operator>>(basic_istream<_CharT, _Traits>& __is, complex<_Tp>& __c) {
    _Tp __re = _Tp(), __im = _Tp(); _CharT __ch = 0;
    __is >> __ch;
    if (__ch == '(') {
        __is >> __re >> __ch;
        if (__ch == ',') { __is >> __im >> __ch; }   // __ch should be ')'
    } else { __is.putback(__ch); __is >> __re; }
    if (!__is.fail()) __c = complex<_Tp>(__re, __im);
    return __is;
}
#endif // _CCW_COMPLEX_HAS_STREAMS

