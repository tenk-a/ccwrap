template <class _Tp> _CCW_LIBCPP_HIDE_FROM_ABI complex<_Tp> sinh(const complex<_Tp>& __c) { return complex<_Tp>(_CCW_STD::sinh(__c.real()) * _CCW_STD::cos(__c.imag()), _CCW_STD::cosh(__c.real()) * _CCW_STD::sin(__c.imag())); }
template <class _Tp> _CCW_LIBCPP_HIDE_FROM_ABI complex<_Tp> cosh(const complex<_Tp>& __c) { return complex<_Tp>(_CCW_STD::cosh(__c.real()) * _CCW_STD::cos(__c.imag()), _CCW_STD::sinh(__c.real()) * _CCW_STD::sin(__c.imag())); }
template <class _Tp> _CCW_LIBCPP_HIDE_FROM_ABI complex<_Tp> tanh(const complex<_Tp>& __c) { return _CCW_STD::sinh(__c) / _CCW_STD::cosh(__c); }
template <class _Tp> _CCW_LIBCPP_HIDE_FROM_ABI complex<_Tp> sin(const complex<_Tp>& __c)  { return complex<_Tp>(_CCW_STD::sin(__c.real()) * _CCW_STD::cosh(__c.imag()), _CCW_STD::cos(__c.real()) * _CCW_STD::sinh(__c.imag())); }
template <class _Tp> _CCW_LIBCPP_HIDE_FROM_ABI complex<_Tp> cos(const complex<_Tp>& __c)  { return complex<_Tp>(_CCW_STD::cos(__c.real()) * _CCW_STD::cosh(__c.imag()), -_CCW_STD::sin(__c.real()) * _CCW_STD::sinh(__c.imag())); }
template <class _Tp> _CCW_LIBCPP_HIDE_FROM_ABI complex<_Tp> tan(const complex<_Tp>& __c)  { return _CCW_STD::sin(__c) / _CCW_STD::cos(__c); }

template <class _Tp> _CCW_LIBCPP_HIDE_FROM_ABI complex<_Tp> proj(const complex<_Tp>& __c) { return __c; }

template <class _Tp> _CCW_LIBCPP_HIDE_FROM_ABI complex<_Tp> asinh(const complex<_Tp>& __z) { return _CCW_STD::log(__z + _CCW_STD::sqrt(__z * __z + complex<_Tp>(1))); }
