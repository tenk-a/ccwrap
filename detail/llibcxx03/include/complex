template <class _Tp> _CCW_LIBCPP_HIDE_FROM_ABI complex<_Tp> atanh(const complex<_Tp>& __z) { return (_CCW_STD::log(complex<_Tp>(1) + __z) - _CCW_STD::log(complex<_Tp>(1) - __z)) / _Tp(2); }
