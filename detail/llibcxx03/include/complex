template <class _Tp>
class _CCW_LIBCPP_TEMPLATE_VIS complex {
    _Tp __re_;
    _Tp __im_;
public:
    typedef _Tp value_type;

    _CCW_LIBCPP_HIDE_FROM_ABI complex(const _Tp& __re = _Tp(), const _Tp& __im = _Tp()) : __re_(__re), __im_(__im) {}
    template <class _Xp>
    _CCW_LIBCPP_HIDE_FROM_ABI complex(const complex<_Xp>& __c) : __re_(__c.real()), __im_(__c.imag()) {}

    _CCW_LIBCPP_HIDE_FROM_ABI _Tp real() const { return __re_; }
    _CCW_LIBCPP_HIDE_FROM_ABI _Tp imag() const { return __im_; }
    _CCW_LIBCPP_HIDE_FROM_ABI _Tp&       __get_re()       { return __re_; }
    _CCW_LIBCPP_HIDE_FROM_ABI const _Tp& __get_re() const { return __re_; }
    _CCW_LIBCPP_HIDE_FROM_ABI _Tp&       __get_im()       { return __im_; }
    _CCW_LIBCPP_HIDE_FROM_ABI const _Tp& __get_im() const { return __im_; }
    _CCW_LIBCPP_HIDE_FROM_ABI void real(_Tp __v) { __re_ = __v; }
    _CCW_LIBCPP_HIDE_FROM_ABI void imag(_Tp __v) { __im_ = __v; }

    _CCW_LIBCPP_HIDE_FROM_ABI complex& operator=(const _Tp& __v) { __re_ = __v; __im_ = _Tp(); return *this; }
    template <class _Xp> _CCW_LIBCPP_HIDE_FROM_ABI complex& operator=(const complex<_Xp>& __c) { __re_ = (_Tp)__c.real(); __im_ = (_Tp)__c.imag(); return *this; }
    _CCW_LIBCPP_HIDE_FROM_ABI complex& operator+=(const _Tp& __v) { __re_ += __v; return *this; }
    _CCW_LIBCPP_HIDE_FROM_ABI complex& operator-=(const _Tp& __v) { __re_ -= __v; return *this; }
    _CCW_LIBCPP_HIDE_FROM_ABI complex& operator*=(const _Tp& __v) { __re_ *= __v; __im_ *= __v; return *this; }
    _CCW_LIBCPP_HIDE_FROM_ABI complex& operator/=(const _Tp& __v) { __re_ /= __v; __im_ /= __v; return *this; }

    template <class _Xp> _CCW_LIBCPP_HIDE_FROM_ABI complex& operator+=(const complex<_Xp>& __c) { __re_ += __c.real(); __im_ += __c.imag(); return *this; }
    template <class _Xp> _CCW_LIBCPP_HIDE_FROM_ABI complex& operator-=(const complex<_Xp>& __c) { __re_ -= __c.real(); __im_ -= __c.imag(); return *this; }
    template <class _Xp> _CCW_LIBCPP_HIDE_FROM_ABI complex& operator*=(const complex<_Xp>& __c) {
        _Tp __r = __re_ * __c.real() - __im_ * __c.imag();
        _Tp __i = __re_ * __c.imag() + __im_ * __c.real();
        __re_ = __r; __im_ = __i; return *this;
    }
    template <class _Xp> _CCW_LIBCPP_HIDE_FROM_ABI complex& operator/=(const complex<_Xp>& __c) {
        _Tp __d = __c.real() * __c.real() + __c.imag() * __c.imag();
        _Tp __r = (__re_ * __c.real() + __im_ * __c.imag()) / __d;
        _Tp __i = (__im_ * __c.real() - __re_ * __c.imag()) / __d;
        __re_ = __r; __im_ = __i; return *this;
    }
};

