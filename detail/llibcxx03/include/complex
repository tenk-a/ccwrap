template <class _Tp> _CCW_LIBCPP_HIDE_FROM_ABI complex<_Tp> operator*(const complex<_Tp>& __x, const _Tp& __y) { complex<_Tp> __r(__x); __r *= __y; return __r; }
template <class _Tp> _CCW_LIBCPP_HIDE_FROM_ABI complex<_Tp> operator*(const _Tp& __x, const complex<_Tp>& __y) { complex<_Tp> __r(__y); __r *= __x; return __r; }
template <class _Tp> _CCW_LIBCPP_HIDE_FROM_ABI complex<_Tp> operator/(const complex<_Tp>& __x, const complex<_Tp>& __y) { complex<_Tp> __r(__x); __r /= __y; return __r; }
template <class _Tp> _CCW_LIBCPP_HIDE_FROM_ABI complex<_Tp> operator/(const complex<_Tp>& __x, const _Tp& __y) { complex<_Tp> __r(__x); __r /= __y; return __r; }
template <class _Tp> _CCW_LIBCPP_HIDE_FROM_ABI complex<_Tp> operator/(const _Tp& __x, const complex<_Tp>& __y) { complex<_Tp> __r(__x); __r /= __y; return __r; }

template <class _Tp> _CCW_LIBCPP_HIDE_FROM_ABI bool operator==(const complex<_Tp>& __x, const complex<_Tp>& __y) { return __x.real() == __y.real() && __x.imag() == __y.imag(); }
template <class _Tp> _CCW_LIBCPP_HIDE_FROM_ABI bool operator==(const complex<_Tp>& __x, const _Tp& __y) { return __x.real() == __y && __x.imag() == _Tp(); }
template <class _Tp> _CCW_LIBCPP_HIDE_FROM_ABI bool operator==(const _Tp& __x, const complex<_Tp>& __y) { return __x == __y.real() && __y.imag() == _Tp(); }
template <class _Tp> _CCW_LIBCPP_HIDE_FROM_ABI bool operator!=(const complex<_Tp>& __x, const complex<_Tp>& __y) { return !(__x == __y); }
template <class _Tp> _CCW_LIBCPP_HIDE_FROM_ABI bool operator!=(const complex<_Tp>& __x, const _Tp& __y) { return !(__x == __y); }
