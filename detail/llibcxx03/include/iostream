// Part of the LLVM Project (Apache-2.0 WITH LLVM-exception).
//  ccwrap llibcxx03: <iostream> for Open Watcom -- cin/cout/cerr/clog over the real
//  <ostream>/<istream> tower, each backed by a basic_filebuf that adopts the C
//  stdin/stdout/stderr FILE*.
//===----------------------------------------------------------------------===//
#ifndef _CCW_LIBCPP_IOSTREAM
#define _CCW_LIBCPP_IOSTREAM
#include "__config"
#include <ostream>
#include <istream>
#include <fstream>
#include <cstdio>
_CCW_LIBCPP_BEGIN_NAMESPACE_STD

_CCW_LIBCPP_HIDE_FROM_ABI inline basic_ostream<char>& __ccw_cout() { static basic_filebuf<char> __b(stdout); static basic_ostream<char> __o(&__b); return __o; }
_CCW_LIBCPP_HIDE_FROM_ABI inline basic_ostream<char>& __ccw_cerr() {
    static basic_filebuf<char> __b(stderr);
    static basic_ostream<char> __o(&__b);
    static bool __unit = false;
    if (!__unit) { __unit = true; __o.setf(ios_base::unitbuf); }
    return __o;
}
_CCW_LIBCPP_HIDE_FROM_ABI inline basic_ostream<char>& __ccw_clog() { static basic_filebuf<char> __b(stderr); static basic_ostream<char> __o(&__b); return __o; }
_CCW_LIBCPP_HIDE_FROM_ABI inline basic_istream<char>& __ccw_cin()  {
    static basic_filebuf<char> __b(stdin);
    static basic_istream<char> __o(&__b);
    static bool __tied = false;
    if (!__tied) { __tied = true; __o.tie(&__ccw_cout()); }
    return __o;
}

static basic_ostream<char>& cout = __ccw_cout();
static basic_ostream<char>& cerr = __ccw_cerr();
static basic_ostream<char>& clog = __ccw_clog();
static basic_istream<char>& cin  = __ccw_cin();

_CCW_LIBCPP_END_NAMESPACE_STD
#endif // _CCW_LIBCPP_IOSTREAM
