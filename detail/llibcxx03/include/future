template <class _Tp>
struct __future_state {
    mutex               __m_;
    condition_variable  __cv_;
    _Tp                 __value_;
    exception_ptr       __eptr_;      // set via promise::set_exception; rethrown by get()
    bool                __ready_;
    bool                __broken_;
    long                __refs_;
    _CCW_LIBCPP_HIDE_FROM_ABI __future_state() : __value_(), __ready_(false), __broken_(false), __refs_(1) {}
    _CCW_LIBCPP_HIDE_FROM_ABI void __add() { lock_guard<mutex> __g(__m_); ++__refs_; }
    _CCW_LIBCPP_HIDE_FROM_ABI void __release() {
        bool __del;
        { lock_guard<mutex> __g(__m_); __del = (--__refs_ == 0); }
        if (__del) delete this;
    }
    _CCW_LIBCPP_HIDE_FROM_ABI void __set(const _Tp& __v) {
        { lock_guard<mutex> __g(__m_); __value_ = __v; __ready_ = true; }
        __cv_.notify_all();
    }
    _CCW_LIBCPP_HIDE_FROM_ABI void __set_exception(exception_ptr __e) {
        { lock_guard<mutex> __g(__m_); if (!__ready_) { __eptr_ = __e; __ready_ = true; } }
        __cv_.notify_all();
    }
    _CCW_LIBCPP_HIDE_FROM_ABI void __break() {
        { lock_guard<mutex> __g(__m_); if (!__ready_) { __broken_ = true; __ready_ = true; } }
        __cv_.notify_all();
    }
    _CCW_LIBCPP_HIDE_FROM_ABI void __wait() {
        unique_lock<mutex> __lk(__m_);
        while (!__ready_) __cv_.wait(__lk);
    }
    template <class _Rep, class _Period>
    _CCW_LIBCPP_HIDE_FROM_ABI future_status __wait_for(const chrono::duration<_Rep, _Period>& __rt) {
        unique_lock<mutex> __lk(__m_);
        if (__ready_) return future_status::ready;
        __cv_.wait_for(__lk, __rt);
        return __ready_ ? future_status::ready : future_status::timeout;
    }
    template <class _Clock, class _Duration>
    _CCW_LIBCPP_HIDE_FROM_ABI future_status __wait_until(const chrono::time_point<_Clock, _Duration>& __tp) {
        unique_lock<mutex> __lk(__m_);
        if (__ready_) return future_status::ready;
        __cv_.wait_until(__lk, __tp);
        return __ready_ ? future_status::ready : future_status::timeout;
    }
    _CCW_LIBCPP_HIDE_FROM_ABI _Tp __get() {
        __wait();
        if (__eptr_) rethrow_exception(__eptr_);
        if (__broken_) _CCW_THROW(future_error(future_errc::broken_promise));
        return __value_;
    }
};

