struct _CCW_LIBCPP_TEMPLATE_VIS ctype_base {
    typedef unsigned short mask;
    static const mask space  = 0x0001;
    static const mask print  = 0x0002;
    static const mask cntrl  = 0x0004;
    static const mask upper  = 0x0008;
    static const mask lower  = 0x0010;
    static const mask alpha  = 0x0020;
    static const mask digit  = 0x0040;
    static const mask punct  = 0x0080;
    static const mask xdigit = 0x0100;
    static const mask blank  = 0x0200;
    static const mask alnum  = alpha | digit;
    static const mask graph  = alnum | punct;
};

class _CCW_LIBCPP_TEMPLATE_VIS locale {
public:
    class facet;
    class id;
    typedef int category;
    static const category none     = 0;
    static const category collate  = 0x01;
    static const category ctype    = 0x02;
    static const category monetary = 0x04;
    static const category numeric  = 0x08;
    static const category time     = 0x10;
    static const category messages = 0x20;
    static const category all = collate | ctype | monetary | numeric | time | messages;

    _CCW_LIBCPP_HIDE_FROM_ABI locale() _CCW_LIBCPP_NOEXCEPT;
    _CCW_LIBCPP_HIDE_FROM_ABI locale(const locale& __o) _CCW_LIBCPP_NOEXCEPT;
    _CCW_LIBCPP_HIDE_FROM_ABI explicit locale(const char*);
    _CCW_LIBCPP_HIDE_FROM_ABI explicit locale(const _CCW_STD::string&);
    _CCW_LIBCPP_HIDE_FROM_ABI locale(const locale& __o, const char*, category);
    _CCW_LIBCPP_HIDE_FROM_ABI locale(const locale& __o, const _CCW_STD::string&, category);
    _CCW_LIBCPP_HIDE_FROM_ABI locale(const locale& __o, const locale& __one, category);
    template <class _Facet> _CCW_LIBCPP_HIDE_FROM_ABI locale(const locale& __o, _Facet* __f);
    _CCW_LIBCPP_HIDE_FROM_ABI locale& operator=(const locale& __o) _CCW_LIBCPP_NOEXCEPT;
    _CCW_LIBCPP_HIDE_FROM_ABI ~locale();

    template <class _Facet> _CCW_LIBCPP_HIDE_FROM_ABI locale combine(const locale& __o) const;

    _CCW_LIBCPP_HIDE_FROM_ABI _CCW_STD::string name() const;
    _CCW_LIBCPP_HIDE_FROM_ABI bool operator==(const locale& __o) const { return __imp_ == __o.__imp_; }
    _CCW_LIBCPP_HIDE_FROM_ABI bool operator!=(const locale& __o) const { return __imp_ != __o.__imp_; }
    _CCW_LIBCPP_HIDE_FROM_ABI bool operator()(const _CCW_STD::string& __x, const _CCW_STD::string& __y) const;

    _CCW_LIBCPP_HIDE_FROM_ABI static const locale& classic();
    _CCW_LIBCPP_HIDE_FROM_ABI static locale global(const locale& __loc);

    _CCW_LIBCPP_HIDE_FROM_ABI const facet* __get_facet(long __idx) const;
    _CCW_LIBCPP_HIDE_FROM_ABI bool __has_facet(long __idx) const;

    struct __imp;   // defined after facet
private:
    __imp* __imp_;
    _CCW_LIBCPP_HIDE_FROM_ABI locale(__imp* __p, int) _CCW_LIBCPP_NOEXCEPT;
    _CCW_LIBCPP_HIDE_FROM_ABI static __imp* __classic_imp();
    _CCW_LIBCPP_HIDE_FROM_ABI static __imp*& __global() { static __imp* __g = __classic_imp(); return __g; }
};

class _CCW_LIBCPP_TEMPLATE_VIS locale::facet {
    long __refs_;
    _CCW_LIBCPP_HIDE_FROM_ABI facet(const facet&);            // not copyable
    _CCW_LIBCPP_HIDE_FROM_ABI facet& operator=(const facet&);
protected:
    _CCW_LIBCPP_HIDE_FROM_ABI explicit facet(_CCW_STD::size_t __refs = 0) : __refs_((long)__refs) {}
    virtual ~facet() {}
public:
    _CCW_LIBCPP_HIDE_FROM_ABI void __add()     { ++__refs_; }
    _CCW_LIBCPP_HIDE_FROM_ABI void __release()  { if (--__refs_ < 0) delete this; }
};

class _CCW_LIBCPP_TEMPLATE_VIS locale::id {
    long __id_;   // 0 => not yet assigned; otherwise (index + 1)
public:
    _CCW_LIBCPP_HIDE_FROM_ABI id() : __id_(0) {}
    _CCW_LIBCPP_HIDE_FROM_ABI long __index() { if (__id_ == 0) __id_ = ++__counter(); return __id_ - 1; }
    _CCW_LIBCPP_HIDE_FROM_ABI static long& __counter() { static long __n = 0; return __n; }
};

struct locale::__imp {
    long __refs_;
    _CCW_STD::string __name_;
    _CCW_STD::vector<facet*> __facets_;
    _CCW_LIBCPP_HIDE_FROM_ABI __imp() : __refs_(0), __name_("C") {}
    _CCW_LIBCPP_HIDE_FROM_ABI __imp(const __imp& __o) : __refs_(0), __name_(__o.__name_), __facets_(__o.__facets_) {
        for (_CCW_STD::size_t __i = 0; __i < __facets_.size(); ++__i) if (__facets_[__i]) __facets_[__i]->__add();
    }
    _CCW_LIBCPP_HIDE_FROM_ABI ~__imp() {
        for (_CCW_STD::size_t __i = 0; __i < __facets_.size(); ++__i) if (__facets_[__i]) __facets_[__i]->__release();
    }
    _CCW_LIBCPP_HIDE_FROM_ABI void __add()     { ++__refs_; }
    _CCW_LIBCPP_HIDE_FROM_ABI void __release() { if (--__refs_ < 0) delete this; }
    _CCW_LIBCPP_HIDE_FROM_ABI void __install(long __idx, facet* __f) {
        if ((_CCW_STD::size_t)__idx >= __facets_.size()) __facets_.resize((_CCW_STD::size_t)__idx + 1, (facet*)0);
        if (__facets_[__idx]) __facets_[__idx]->__release();
        __f->__add(); __facets_[__idx] = __f;
    }
    _CCW_LIBCPP_HIDE_FROM_ABI facet* __get(long __idx) const {
        if (__idx < 0 || (_CCW_STD::size_t)__idx >= __facets_.size()) return 0;
        return __facets_[__idx];
    }
};

inline locale::locale() _CCW_LIBCPP_NOEXCEPT : __imp_(__global()) { __imp_->__add(); }
inline locale::locale(const locale& __o) _CCW_LIBCPP_NOEXCEPT : __imp_(__o.__imp_) { __imp_->__add(); }
inline locale::locale(const char*) : __imp_(__classic_imp()) { __imp_->__add(); }
inline locale::locale(const _CCW_STD::string&) : __imp_(__classic_imp()) { __imp_->__add(); }
inline locale::locale(__imp* __p, int) _CCW_LIBCPP_NOEXCEPT : __imp_(__p) { __imp_->__add(); }
inline locale& locale::operator=(const locale& __o) _CCW_LIBCPP_NOEXCEPT {
    __o.__imp_->__add(); __imp_->__release(); __imp_ = __o.__imp_; return *this;
}
inline locale::~locale() { __imp_->__release(); }
inline _CCW_STD::string locale::name() const { return __imp_->__name_; }
inline const locale::facet* locale::__get_facet(long __idx) const { return __imp_->__get(__idx); }
inline bool locale::__has_facet(long __idx) const { return __imp_->__get(__idx) != 0; }
inline const locale& locale::classic() { static locale __c(__classic_imp(), 0); return __c; }
inline locale locale::global(const locale& __loc) {
    locale __old(__global(), 0); __loc.__imp_->__add(); __global()->__release(); __global() = __loc.__imp_; return __old;
}
inline locale::locale(const locale& __o, const char*, category) : __imp_(__o.__imp_) { __imp_->__add(); }
inline locale::locale(const locale& __o, const _CCW_STD::string&, category) : __imp_(__o.__imp_) { __imp_->__add(); }
inline locale::locale(const locale& __o, const locale& __one, category __cats) : __imp_(__cats ? __one.__imp_ : __o.__imp_) { __imp_->__add(); }
template <class _Facet>
inline locale::locale(const locale& __o, _Facet* __f) : __imp_(new __imp(*__o.__imp_)) {
    __imp_->__add();
    if (__f) __imp_->__install(_Facet::id.__index(), __f);
}
template <class _Facet>
inline locale locale::combine(const locale& __o) const {
    const _Facet& __f = use_facet<_Facet>(__o);
    return locale(*this, const_cast<_Facet*>(&__f));
}

template <class _Facet>
_CCW_LIBCPP_HIDE_FROM_ABI const _Facet& use_facet(const locale& __l) {
    const locale::facet* __f = __l.__get_facet(_Facet::id.__index());
    if (!__f) _CCW_THROW(_CCW_STD::runtime_error("bad_cast: use_facet"));
    return static_cast<const _Facet&>(*__f);
}
template <class _Facet>
_CCW_LIBCPP_HIDE_FROM_ABI bool has_facet(const locale& __l) _CCW_LIBCPP_NOEXCEPT { return __l.__has_facet(_Facet::id.__index()); }

template <class _CharT> class _CCW_LIBCPP_TEMPLATE_VIS ctype;

template <>
class _CCW_LIBCPP_TEMPLATE_VIS ctype<char> : public locale::facet, public ctype_base {
    const mask* __tab_;
    bool        __del_;
public:
    typedef char char_type;
    static const _CCW_STD::size_t table_size = 256;
    static locale::id id;
    _CCW_LIBCPP_HIDE_FROM_ABI explicit ctype(const mask* __tab = 0, bool __del = false, _CCW_STD::size_t __refs = 0)
        : locale::facet(__refs), __tab_(__tab ? __tab : classic_table()), __del_(__del) {}

    _CCW_LIBCPP_HIDE_FROM_ABI bool  is(mask __m, char __c) const { return (__tab_[(unsigned char)__c] & __m) != 0; }
    _CCW_LIBCPP_HIDE_FROM_ABI const char* is(const char* __b, const char* __e, mask* __v) const {
        for (; __b != __e; ++__b, ++__v) *__v = __tab_[(unsigned char)*__b]; return __e;
    }
    _CCW_LIBCPP_HIDE_FROM_ABI const char* scan_is(mask __m, const char* __b, const char* __e) const {
        for (; __b != __e; ++__b) if (__tab_[(unsigned char)*__b] & __m) break; return __b;
    }
    _CCW_LIBCPP_HIDE_FROM_ABI const char* scan_not(mask __m, const char* __b, const char* __e) const {
        for (; __b != __e; ++__b) if (!(__tab_[(unsigned char)*__b] & __m)) break; return __b;
    }
    _CCW_LIBCPP_HIDE_FROM_ABI char toupper(char __c) const { return do_toupper(__c); }
    _CCW_LIBCPP_HIDE_FROM_ABI const char* toupper(char* __b, const char* __e) const { return do_toupper(__b, __e); }
    _CCW_LIBCPP_HIDE_FROM_ABI char tolower(char __c) const { return do_tolower(__c); }
    _CCW_LIBCPP_HIDE_FROM_ABI const char* tolower(char* __b, const char* __e) const { return do_tolower(__b, __e); }
    _CCW_LIBCPP_HIDE_FROM_ABI char widen(char __c) const { return do_widen(__c); }
    _CCW_LIBCPP_HIDE_FROM_ABI const char* widen(const char* __b, const char* __e, char* __d) const { return do_widen(__b, __e, __d); }
    _CCW_LIBCPP_HIDE_FROM_ABI char narrow(char __c, char __dflt) const { return do_narrow(__c, __dflt); }
    _CCW_LIBCPP_HIDE_FROM_ABI const char* narrow(const char* __b, const char* __e, char __dflt, char* __d) const { return do_narrow(__b, __e, __dflt, __d); }

    _CCW_LIBCPP_HIDE_FROM_ABI const mask* table() const _CCW_LIBCPP_NOEXCEPT { return __tab_; }
    _CCW_LIBCPP_HIDE_FROM_ABI static const mask* classic_table() _CCW_LIBCPP_NOEXCEPT {
        static mask __t[table_size]; static bool __init = false;
        if (!__init) {
            for (int __i = 0; __i < (int)table_size; ++__i) {
                unsigned char __u = (unsigned char)__i; mask __r = 0;
                if (_CCW_STD::isspace(__u))  __r |= space;
                if (_CCW_STD::isprint(__u))  __r |= print;
                if (_CCW_STD::iscntrl(__u))  __r |= cntrl;
                if (_CCW_STD::isupper(__u))  __r |= upper;
                if (_CCW_STD::islower(__u))  __r |= lower;
                if (_CCW_STD::isalpha(__u))  __r |= alpha;
                if (_CCW_STD::isdigit(__u))  __r |= digit;
                if (_CCW_STD::ispunct(__u))  __r |= punct;
                if (_CCW_STD::isxdigit(__u)) __r |= xdigit;
                if (__i == ' ' || __i == '\t') __r |= blank;
                __t[__i] = __r;
            }
            __init = true;
        }
        return __t;
    }
protected:
    virtual ~ctype() { if (__del_) delete[] __tab_; }
    _CCW_LIBCPP_HIDE_FROM_ABI virtual char do_toupper(char __c) const { return (char)_CCW_STD::toupper((unsigned char)__c); }
    _CCW_LIBCPP_HIDE_FROM_ABI virtual const char* do_toupper(char* __b, const char* __e) const { for (; __b != __e; ++__b) *__b = do_toupper(*__b); return __e; }
    _CCW_LIBCPP_HIDE_FROM_ABI virtual char do_tolower(char __c) const { return (char)_CCW_STD::tolower((unsigned char)__c); }
    _CCW_LIBCPP_HIDE_FROM_ABI virtual const char* do_tolower(char* __b, const char* __e) const { for (; __b != __e; ++__b) *__b = do_tolower(*__b); return __e; }
    _CCW_LIBCPP_HIDE_FROM_ABI virtual char do_widen(char __c) const { return __c; }
    _CCW_LIBCPP_HIDE_FROM_ABI virtual const char* do_widen(const char* __b, const char* __e, char* __d) const { for (; __b != __e; ++__b, ++__d) *__d = *__b; return __e; }
    _CCW_LIBCPP_HIDE_FROM_ABI virtual char do_narrow(char __c, char) const { return __c; }
    _CCW_LIBCPP_HIDE_FROM_ABI virtual const char* do_narrow(const char* __b, const char* __e, char, char* __d) const { for (; __b != __e; ++__b, ++__d) *__d = *__b; return __e; }
};

template <>
class _CCW_LIBCPP_TEMPLATE_VIS ctype<wchar_t> : public locale::facet, public ctype_base {
public:
    typedef wchar_t char_type;
    static locale::id id;
    _CCW_LIBCPP_HIDE_FROM_ABI explicit ctype(_CCW_STD::size_t __refs = 0) : locale::facet(__refs) {}

    _CCW_LIBCPP_HIDE_FROM_ABI bool is(mask __m, wchar_t __c) const { return do_is(__m, __c); }
    _CCW_LIBCPP_HIDE_FROM_ABI const wchar_t* is(const wchar_t* __b, const wchar_t* __e, mask* __v) const { return do_is(__b, __e, __v); }
    _CCW_LIBCPP_HIDE_FROM_ABI const wchar_t* scan_is(mask __m, const wchar_t* __b, const wchar_t* __e) const { return do_scan_is(__m, __b, __e); }
    _CCW_LIBCPP_HIDE_FROM_ABI const wchar_t* scan_not(mask __m, const wchar_t* __b, const wchar_t* __e) const { return do_scan_not(__m, __b, __e); }
    _CCW_LIBCPP_HIDE_FROM_ABI wchar_t toupper(wchar_t __c) const { return do_toupper(__c); }
    _CCW_LIBCPP_HIDE_FROM_ABI const wchar_t* toupper(wchar_t* __b, const wchar_t* __e) const { return do_toupper(__b, __e); }
    _CCW_LIBCPP_HIDE_FROM_ABI wchar_t tolower(wchar_t __c) const { return do_tolower(__c); }
    _CCW_LIBCPP_HIDE_FROM_ABI const wchar_t* tolower(wchar_t* __b, const wchar_t* __e) const { return do_tolower(__b, __e); }
    _CCW_LIBCPP_HIDE_FROM_ABI wchar_t widen(char __c) const { return do_widen(__c); }
    _CCW_LIBCPP_HIDE_FROM_ABI const char* widen(const char* __b, const char* __e, wchar_t* __d) const { return do_widen(__b, __e, __d); }
    _CCW_LIBCPP_HIDE_FROM_ABI char narrow(wchar_t __c, char __dflt) const { return do_narrow(__c, __dflt); }
    _CCW_LIBCPP_HIDE_FROM_ABI const wchar_t* narrow(const wchar_t* __b, const wchar_t* __e, char __dflt, char* __d) const {
        return do_narrow(__b, __e, __dflt, __d);
    }
protected:
    virtual ~ctype() {}
    _CCW_LIBCPP_HIDE_FROM_ABI virtual bool do_is(mask __m, wchar_t __c) const {
        wint_t __w = (wint_t)__c;
        mask __r = 0;
        if (_CCW_STD::iswspace(__w))  __r |= space;
        if (_CCW_STD::iswprint(__w))  __r |= print;
        if (_CCW_STD::iswcntrl(__w))  __r |= cntrl;
        if (_CCW_STD::iswupper(__w))  __r |= upper;
        if (_CCW_STD::iswlower(__w))  __r |= lower;
        if (_CCW_STD::iswalpha(__w))  __r |= alpha;
        if (_CCW_STD::iswdigit(__w))  __r |= digit;
        if (_CCW_STD::iswpunct(__w))  __r |= punct;
        if (_CCW_STD::iswxdigit(__w)) __r |= xdigit;
        if (__c == L' ' || __c == L'\t') __r |= blank;
        return (__r & __m) != 0;
    }
    _CCW_LIBCPP_HIDE_FROM_ABI virtual const wchar_t* do_is(const wchar_t* __b, const wchar_t* __e, mask* __v) const {
        static const mask __all[] = { space, print, cntrl, upper, lower, alpha, digit, punct, xdigit, blank };
        for (; __b != __e; ++__b, ++__v) {
            mask __r = 0;
            for (int __i = 0; __i < 10; ++__i) if (do_is(__all[__i], *__b)) __r |= __all[__i];
            *__v = __r;
        }
        return __e;
    }
    _CCW_LIBCPP_HIDE_FROM_ABI virtual const wchar_t* do_scan_is(mask __m, const wchar_t* __b, const wchar_t* __e) const {
        for (; __b != __e; ++__b) if (do_is(__m, *__b)) break;
        return __b;
    }
    _CCW_LIBCPP_HIDE_FROM_ABI virtual const wchar_t* do_scan_not(mask __m, const wchar_t* __b, const wchar_t* __e) const {
        for (; __b != __e; ++__b) if (!do_is(__m, *__b)) break;
        return __b;
    }
    _CCW_LIBCPP_HIDE_FROM_ABI virtual wchar_t do_toupper(wchar_t __c) const { return (wchar_t)_CCW_STD::towupper((wint_t)__c); }
    _CCW_LIBCPP_HIDE_FROM_ABI virtual const wchar_t* do_toupper(wchar_t* __b, const wchar_t* __e) const {
        for (; __b != __e; ++__b) *__b = do_toupper(*__b);
        return __e;
    }
    _CCW_LIBCPP_HIDE_FROM_ABI virtual wchar_t do_tolower(wchar_t __c) const { return (wchar_t)_CCW_STD::towlower((wint_t)__c); }
    _CCW_LIBCPP_HIDE_FROM_ABI virtual const wchar_t* do_tolower(wchar_t* __b, const wchar_t* __e) const {
        for (; __b != __e; ++__b) *__b = do_tolower(*__b);
        return __e;
    }
    _CCW_LIBCPP_HIDE_FROM_ABI virtual wchar_t do_widen(char __c) const { return (wchar_t)(unsigned char)__c; }
    _CCW_LIBCPP_HIDE_FROM_ABI virtual const char* do_widen(const char* __b, const char* __e, wchar_t* __d) const {
        for (; __b != __e; ++__b, ++__d) *__d = (wchar_t)(unsigned char)*__b;
        return __e;
    }
    _CCW_LIBCPP_HIDE_FROM_ABI virtual char do_narrow(wchar_t __c, char __dflt) const {
        return ((unsigned long)__c < 256u) ? (char)(unsigned char)__c : __dflt;
    }
    _CCW_LIBCPP_HIDE_FROM_ABI virtual const wchar_t* do_narrow(const wchar_t* __b, const wchar_t* __e, char __dflt, char* __d) const {
        for (; __b != __e; ++__b, ++__d) *__d = do_narrow(*__b, __dflt);
        return __e;
    }
};

