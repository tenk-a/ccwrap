// -*- C++ -*-
//===----------------------------------------------------------------------===//
// Part of the LLVM Project (Apache-2.0 WITH LLVM-exception).
//  ccwrap llibcxx03: <tuple> for Open Watcom. Rather than re-implement it, this
//  bridges to ccwrap's existing detail/tuple.hpp -- a recursive head/tail tuple
//  (up to 10 elements) with get<N>/get<Type>, tuple_size, tuple_element,
//  make_tuple (fnctmpl), comparisons and swap, all in namespace std. Value
//  elements only (no reference members / tie), no move on C++03.
//===----------------------------------------------------------------------===//
#ifndef _CCW_LIBCPP_TUPLE
#define _CCW_LIBCPP_TUPLE
#include "__config"
#include "__utility/move.h"
#include "../../cxx/tuple.hpp"
#include "__memory/misc.h"          // the uses_allocator primary, specialised below
_CCW_LIBCPP_BEGIN_NAMESPACE_STD
#if defined(__WATCOMC__) || defined(_CCW_STD_RELOCATED)
template <class _T0, class _T1, class _T2, class _T3, class _T4,
          class _T5, class _T6, class _T7, class _T8, class _T9, class _Alloc>
struct uses_allocator<tuple<_T0, _T1, _T2, _T3, _T4, _T5, _T6, _T7, _T8, _T9>, _Alloc> {
    static const bool value = true;
};
#endif
_CCW_LIBCPP_END_NAMESPACE_STD
#endif // _CCW_LIBCPP_TUPLE
