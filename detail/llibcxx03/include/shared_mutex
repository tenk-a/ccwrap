// Part of the LLVM Project (Apache-2.0 WITH LLVM-exception).
//  ccwrap llibcxx03: <shared_mutex> for Open Watcom. On the Windows/nt target
//  shared_mutex / shared_timed_mutex are REAL, wrapping a Win32 SRWLOCK (Slim
//  Reader/Writer lock): lock()/unlock() take it exclusively, lock_shared()/
//  unlock_shared() take it shared. shared_lock is the RAII reader wrapper. Off
//  Open Watcom they fall back to a no-op single-thread stub. (SRWLOCK is neither
//  recursive nor timed; the timed_mutex ops here are the plain acquire calls.)
#ifndef _CCW_LIBCPP_SHARED_MUTEX
#define _CCW_LIBCPP_SHARED_MUTEX
#include "__config"

#if defined(__WATCOMC__) && !defined(_CCW_OS_WIN)
# error "ccwrap llibcxx03: <shared_mutex> is Win32-only on Open Watcom -- std::shared_mutex needs Win32 SRW locks."
#endif
#include <mutex>
#include "../../c/win/win32_fwd.h"   // defer_lock_t / adopt_lock_t / try_to_lock_t

#if defined(__WATCOMC__)
extern "C" {
__declspec(dllimport) void __stdcall AcquireSRWLockExclusive(__ccw_psrwlock);
__declspec(dllimport) void __stdcall ReleaseSRWLockExclusive(__ccw_psrwlock);
__declspec(dllimport) void __stdcall AcquireSRWLockShared(__ccw_psrwlock);
__declspec(dllimport) void __stdcall ReleaseSRWLockShared(__ccw_psrwlock);
__declspec(dllimport) unsigned char __stdcall TryAcquireSRWLockExclusive(__ccw_psrwlock);
__declspec(dllimport) unsigned char __stdcall TryAcquireSRWLockShared(__ccw_psrwlock);
}
#endif

_CCW_LIBCPP_BEGIN_NAMESPACE_STD

#if defined(__WATCOMC__)
#  define _CCW_SHARED_MUTEX_BODY(_Name)                                                                              \
    void* __rw_;   /* SRWLOCK == a single PVOID, SRWLOCK_INIT = 0 */                                                 \
public:                                                                                                             \
    typedef void* native_handle_type;                                                                               \
    _CCW_LIBCPP_HIDE_FROM_ABI _Name() : __rw_(0) {}                                                                      \
    _CCW_LIBCPP_HIDE_FROM_ABI void lock()             { AcquireSRWLockExclusive((__ccw_psrwlock)&__rw_); }                               \
    _CCW_LIBCPP_HIDE_FROM_ABI bool try_lock()         { return TryAcquireSRWLockExclusive((__ccw_psrwlock)&__rw_) != 0; }                \
    _CCW_LIBCPP_HIDE_FROM_ABI void unlock()           { ReleaseSRWLockExclusive((__ccw_psrwlock)&__rw_); }                               \
    _CCW_LIBCPP_HIDE_FROM_ABI void lock_shared()       { AcquireSRWLockShared((__ccw_psrwlock)&__rw_); }                                 \
    _CCW_LIBCPP_HIDE_FROM_ABI bool try_lock_shared()   { return TryAcquireSRWLockShared((__ccw_psrwlock)&__rw_) != 0; }                  \
    _CCW_LIBCPP_HIDE_FROM_ABI void unlock_shared()     { ReleaseSRWLockShared((__ccw_psrwlock)&__rw_); }                                 \
    _CCW_LIBCPP_HIDE_FROM_ABI native_handle_type native_handle() { return &__rw_; }
#else
#  define _CCW_SHARED_MUTEX_BODY(_Name)                                                                              \
public:                                                                                                             \
    _CCW_LIBCPP_HIDE_FROM_ABI _Name() {}                                                                                 \
    _CCW_LIBCPP_HIDE_FROM_ABI void lock() {}                                                                             \
    _CCW_LIBCPP_HIDE_FROM_ABI bool try_lock() { return true; }                                                           \
    _CCW_LIBCPP_HIDE_FROM_ABI void unlock() {}                                                                           \
    _CCW_LIBCPP_HIDE_FROM_ABI void lock_shared() {}                                                                      \
    _CCW_LIBCPP_HIDE_FROM_ABI bool try_lock_shared() { return true; }                                                    \
    _CCW_LIBCPP_HIDE_FROM_ABI void unlock_shared() {}
#endif

class shared_mutex {
    _CCW_SHARED_MUTEX_BODY(shared_mutex)
private:
    shared_mutex(const shared_mutex&);
    shared_mutex& operator=(const shared_mutex&);
};

class shared_timed_mutex {
    _CCW_SHARED_MUTEX_BODY(shared_timed_mutex)
public:
    template <class _Rep, class _Period>
    _CCW_LIBCPP_HIDE_FROM_ABI bool try_lock_for(const chrono::duration<_Rep, _Period>& __rt) {
        if (try_lock()) return true;
        chrono::steady_clock::time_point __dl = chrono::steady_clock::now() + __rt;
        while (chrono::steady_clock::now() < __dl) { if (try_lock()) return true; }
        return false;
    }
    template <class _Clock, class _Duration>
    _CCW_LIBCPP_HIDE_FROM_ABI bool try_lock_until(const chrono::time_point<_Clock, _Duration>& __tp) {
        if (try_lock()) return true;
        while (_Clock::now() < __tp) { if (try_lock()) return true; }
        return false;
    }
    template <class _Rep, class _Period>
    _CCW_LIBCPP_HIDE_FROM_ABI bool try_lock_shared_for(const chrono::duration<_Rep, _Period>& __rt) {
        if (try_lock_shared()) return true;
        chrono::steady_clock::time_point __dl = chrono::steady_clock::now() + __rt;
        while (chrono::steady_clock::now() < __dl) { if (try_lock_shared()) return true; }
        return false;
    }
    template <class _Clock, class _Duration>
    _CCW_LIBCPP_HIDE_FROM_ABI bool try_lock_shared_until(const chrono::time_point<_Clock, _Duration>& __tp) {
        if (try_lock_shared()) return true;
        while (_Clock::now() < __tp) { if (try_lock_shared()) return true; }
        return false;
    }
private:
    shared_timed_mutex(const shared_timed_mutex&);
    shared_timed_mutex& operator=(const shared_timed_mutex&);
};

#undef _CCW_SHARED_MUTEX_BODY

template <class _Mutex>
class shared_lock {
    _Mutex* __m_;
    bool    __owns_;
public:
    typedef _Mutex mutex_type;
    _CCW_LIBCPP_HIDE_FROM_ABI shared_lock() : __m_(0), __owns_(false) {}
    _CCW_LIBCPP_HIDE_FROM_ABI explicit shared_lock(_Mutex& __m) : __m_(&__m), __owns_(true) { __m_->lock_shared(); }
    _CCW_LIBCPP_HIDE_FROM_ABI shared_lock(_Mutex& __m, defer_lock_t) : __m_(&__m), __owns_(false) {}
    _CCW_LIBCPP_HIDE_FROM_ABI shared_lock(_Mutex& __m, try_to_lock_t) : __m_(&__m), __owns_(__m.try_lock_shared()) {}
    _CCW_LIBCPP_HIDE_FROM_ABI shared_lock(_Mutex& __m, adopt_lock_t) : __m_(&__m), __owns_(true) {}
    template <class _Rep, class _Period>
    _CCW_LIBCPP_HIDE_FROM_ABI shared_lock(_Mutex& __m, const chrono::duration<_Rep, _Period>& __rt)
        : __m_(&__m), __owns_(__m.try_lock_shared_for(__rt)) {}
    template <class _Clock, class _Duration>
    _CCW_LIBCPP_HIDE_FROM_ABI shared_lock(_Mutex& __m, const chrono::time_point<_Clock, _Duration>& __tp)
        : __m_(&__m), __owns_(__m.try_lock_shared_until(__tp)) {}
    _CCW_LIBCPP_HIDE_FROM_ABI ~shared_lock() { if (__owns_ && __m_) __m_->unlock_shared(); }
#if !_CCW_HAS_REAL_RVALUE_REF
    _CCW_LIBCPP_HIDE_FROM_ABI shared_lock(_CCW_RV_REF(shared_lock) __r) : __m_(0), __owns_(false) {
        shared_lock& __o = _CCW_MOVED_OBJ(__r);
        __m_ = __o.__m_; __owns_ = __o.__owns_;
        __o.__m_ = 0; __o.__owns_ = false;
    }
    _CCW_LIBCPP_HIDE_FROM_ABI shared_lock& operator=(_CCW_RV_REF(shared_lock) __r) {
        shared_lock& __o = _CCW_MOVED_OBJ(__r);
        if (this != &__o) {
            if (__owns_ && __m_) __m_->unlock_shared();
            __m_ = __o.__m_; __owns_ = __o.__owns_;
            __o.__m_ = 0; __o.__owns_ = false;
        }
        return *this;
    }
#else
    _CCW_LIBCPP_HIDE_FROM_ABI shared_lock(shared_lock&& __o) : __m_(__o.__m_), __owns_(__o.__owns_) {
        __o.__m_ = 0; __o.__owns_ = false;
    }
    _CCW_LIBCPP_HIDE_FROM_ABI shared_lock& operator=(shared_lock&& __o) {
        if (this != &__o) {
            if (__owns_ && __m_) __m_->unlock_shared();
            __m_ = __o.__m_; __owns_ = __o.__owns_;
            __o.__m_ = 0; __o.__owns_ = false;
        }
        return *this;
    }
#endif
    _CCW_LIBCPP_HIDE_FROM_ABI void lock()   { if (__m_) { __m_->lock_shared(); __owns_ = true; } }
    _CCW_LIBCPP_HIDE_FROM_ABI bool try_lock() { if (__m_) __owns_ = __m_->try_lock_shared(); return __owns_; }
    _CCW_LIBCPP_HIDE_FROM_ABI void unlock() { if (__m_ && __owns_) { __m_->unlock_shared(); __owns_ = false; } }
    _CCW_LIBCPP_HIDE_FROM_ABI bool owns_lock() const { return __owns_; }
    _CCW_LIBCPP_HIDE_FROM_ABI _Mutex* mutex() const { return __m_; }
    _CCW_LIBCPP_HIDE_FROM_ABI _Mutex* release() { _Mutex* __m = __m_; __m_ = 0; __owns_ = false; return __m; }

    template <class _Rep, class _Period>
    _CCW_LIBCPP_HIDE_FROM_ABI bool try_lock_for(const chrono::duration<_Rep, _Period>& __rt) {
        if (__m_) __owns_ = __m_->try_lock_shared_for(__rt); return __owns_;
    }
    template <class _Clock, class _Duration>
    _CCW_LIBCPP_HIDE_FROM_ABI bool try_lock_until(const chrono::time_point<_Clock, _Duration>& __tp) {
        if (__m_) __owns_ = __m_->try_lock_shared_until(__tp); return __owns_;
    }

    _CCW_LIBCPP_HIDE_FROM_ABI void swap(shared_lock& __u) {
        _Mutex* __tm = __m_; __m_ = __u.__m_; __u.__m_ = __tm;
        bool __to = __owns_; __owns_ = __u.__owns_; __u.__owns_ = __to;
    }
    typedef _Mutex* shared_lock::*__bool_type;
    _CCW_LIBCPP_HIDE_FROM_ABI operator __bool_type() const { return __owns_ ? &shared_lock::__m_ : 0; }
private:
    shared_lock(const shared_lock&);
    shared_lock& operator=(const shared_lock&);
};
#if !defined(__WATCOMC__)
template <class _Mutex>
_CCW_LIBCPP_HIDE_FROM_ABI inline void swap(shared_lock<_Mutex>& __x, shared_lock<_Mutex>& __y) { __x.swap(__y); }
#endif

_CCW_LIBCPP_END_NAMESPACE_STD
#endif // _CCW_LIBCPP_SHARED_MUTEX
