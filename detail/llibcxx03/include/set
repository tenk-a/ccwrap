#if !_CCW_HAS_REAL_RVALUE_REF
    template <class _Vt>
    _CCW_LIBCPP_HIDE_FROM_ABI _CCW_STD::pair<iterator, bool>
    insert(_CCW_RV_REF_BEG _Vt _CCW_RV_REF_END __v, typename __vins_gate<_Vt, value_type>::type* = 0) {
