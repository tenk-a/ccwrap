template <class _K, class _C, class _A>
_CCW_LIBCPP_HIDE_FROM_ABI bool operator==(const set<_K, _C, _A>& __x, const set<_K, _C, _A>& __y) {
    if (__x.size() != __y.size()) return false;
    typename set<_K, _C, _A>::const_iterator __i = __x.begin(), __j = __y.begin();
    for (; __i != __x.end(); ++__i, ++__j) if (!(*__i == *__j)) return false;
    return true;
}
template <class _K, class _C, class _A>
_CCW_LIBCPP_HIDE_FROM_ABI bool operator!=(const set<_K, _C, _A>& __x, const set<_K, _C, _A>& __y) { return !(__x == __y); }
template <class _K, class _C, class _A>
_CCW_LIBCPP_HIDE_FROM_ABI bool operator<(const set<_K, _C, _A>& __x, const set<_K, _C, _A>& __y) {
    typename set<_K, _C, _A>::const_iterator __i = __x.begin(), __j = __y.begin();
    for (; __i != __x.end() && __j != __y.end(); ++__i, ++__j) { if (*__i < *__j) return true; if (*__j < *__i) return false; }
    return __i == __x.end() && __j != __y.end();
}
