        insert_return_type __r;
        if (__nh.empty()) return __r;
        bool __b; __tree_node_base* __ex;
        iterator __it = __tree_.__insert_unique_node(__nh.__get(), __b, __ex);
        __r.position = __it;
        __r.inserted = __b;
        if (__b) __nh.__release();       // ownership moved into the tree
