    template <class _InputIt>
    _CCW_LIBCPP_HIDE_FROM_ABI set(_InputIt __f, _InputIt __l, const _Compare& __c) : __tree_(__c) { insert(__f, __l); }
    template <class _InputIt>
    _CCW_LIBCPP_HIDE_FROM_ABI set(_InputIt __f, _InputIt __l, const _Compare& __c, const _Alloc& __a)
        : __tree_(__c, __a) { insert(__f, __l); }
