template <class _CharT, class _Traits, class _Alloc>
struct __ccw_sv_not_ccw_string<basic_string<_CharT, _Traits, _Alloc> > { };

template <class _CharT, class _Traits, class _Alloc>
class _CCW_LIBCPP_TEMPLATE_VIS basic_string {
public:
    typedef _Traits                              traits_type;
    typedef _CharT                               value_type;
    typedef _Alloc                               allocator_type;
    typedef _CCW_STD::size_t                          size_type;
    typedef _CCW_STD::ptrdiff_t                       difference_type;
    typedef _CharT&                              reference;
    typedef const _CharT&                        const_reference;
    typedef _CharT*                              pointer;
    typedef const _CharT*                        const_pointer;
    typedef _CharT*                              iterator;
    typedef const _CharT*                        const_iterator;
    typedef _CCW_STD::reverse_iterator<iterator>       reverse_iterator;
    typedef _CCW_STD::reverse_iterator<const_iterator> const_reverse_iterator;

    static const size_type npos = (size_type)-1;

private:
    struct __long {
        size_type __cap_;    // bit0 = is-long (1); capacity incl null = __cap_ >> 1
        size_type __size_;
        pointer   __data_;
    };
    enum { __min_cap = (sizeof(__long) - 1) / sizeof(value_type) };
    struct __short {
        unsigned char __size_;   // bit0 = is-long (0); short size = __size_ >> 1
        value_type    __data_[__min_cap];
    };
    union __rep { __long __l; __short __s; };

    struct __rep_alloc : allocator_type {
        __rep __r_;
        _CCW_LIBCPP_HIDE_FROM_ABI __rep_alloc() {}
        _CCW_LIBCPP_HIDE_FROM_ABI explicit __rep_alloc(const allocator_type& __a) : allocator_type(__a) {}
    };
    __rep_alloc __ra_;

    _CCW_LIBCPP_HIDE_FROM_ABI allocator_type&       __alloc()       { return __ra_; }
    _CCW_LIBCPP_HIDE_FROM_ABI const allocator_type& __alloc() const { return __ra_; }
    _CCW_LIBCPP_HIDE_FROM_ABI __rep&       __r()       { return __ra_.__r_; }
    _CCW_LIBCPP_HIDE_FROM_ABI const __rep& __r() const { return __ra_.__r_; }

    _CCW_LIBCPP_HIDE_FROM_ABI bool __is_long() const { return (__r().__s.__size_ & 1u) != 0; }

    _CCW_LIBCPP_HIDE_FROM_ABI pointer       __p()       { return __is_long() ? __r().__l.__data_ : __r().__s.__data_; }
    _CCW_LIBCPP_HIDE_FROM_ABI const_pointer __p() const { return __is_long() ? __r().__l.__data_ : __r().__s.__data_; }
    _CCW_LIBCPP_HIDE_FROM_ABI size_type __z() const {
        return __is_long() ? __r().__l.__size_ : (size_type)(__r().__s.__size_ >> 1);
    }
    _CCW_LIBCPP_HIDE_FROM_ABI size_type __long_cap() const { return __r().__l.__cap_ >> 1; }
    _CCW_LIBCPP_HIDE_FROM_ABI void __set_long_cap(size_type __c) { __r().__l.__cap_ = (__c << 1) | 1u; }

    _CCW_LIBCPP_HIDE_FROM_ABI void __set_size(size_type __n) {
        if (__is_long()) __r().__l.__size_ = __n;
        else             __r().__s.__size_ = (unsigned char)(__n << 1);   // bit0 = 0 => stays short
        __p()[__n] = value_type();
    }
    _CCW_LIBCPP_HIDE_FROM_ABI static bool __fits_sso(size_type __n) { return __n < (size_type)__min_cap; }

    _CCW_LIBCPP_HIDE_FROM_ABI void __init(size_type __n) {
        if (__fits_sso(__n)) {
            __r().__s.__size_    = 0;                 // short, size 0, flag 0
            __r().__s.__data_[0] = value_type();
        } else {
            pointer __nb = __alloc().allocate(__n + 1);
            __nb[0] = value_type();
            __r().__l.__data_ = __nb;
            __r().__l.__size_ = 0;
            __set_long_cap(__n + 1);
        }
    }
    _CCW_LIBCPP_HIDE_FROM_ABI void __reserve_exact(size_type __nc) {
        if (__nc > max_size()) _CCW_THROW(_CCW_STD::length_error("basic_string"));
        size_type __sz  = __z();
        pointer   __old = __p();
        bool      __was_long   = __is_long();
        size_type __old_alloc  = __was_long ? __long_cap() : 0;
        pointer __nb = __alloc().allocate(__nc + 1);
        _Traits::copy(__nb, __old, __sz);
        __nb[__sz] = value_type();
        if (__was_long) __alloc().deallocate(__old, __old_alloc);
        __r().__l.__data_ = __nb;
        __r().__l.__size_ = __sz;
        __set_long_cap(__nc + 1);
    }
    _CCW_LIBCPP_HIDE_FROM_ABI void __ensure(size_type __need) {
        if (__need <= capacity()) return;
        size_type __c  = capacity();
        size_type __nc = __c ? __c * 2 : 1;
        if (__nc < __need) __nc = __need;
        __reserve_exact(__nc);
    }
    _CCW_LIBCPP_HIDE_FROM_ABI void __chk() const {
        if (!__is_long()) return;
        _CCW_CHK((unsigned long)(void*)__r().__l.__data_ >= 0x10000ul
                 && (__r().__l.__cap_ >> 1) <= 0x08000000ul
                 && __r().__l.__size_ < (__r().__l.__cap_ >> 1),
                 "basic_string rep", this,
                 __r().__l.__cap_, __r().__l.__size_, (void*)__r().__l.__data_);
    }
    _CCW_LIBCPP_HIDE_FROM_ABI void __free() {
        __chk();
        if (__is_long()) __alloc().deallocate(__r().__l.__data_, __long_cap());
    }
    _CCW_LIBCPP_HIDE_FROM_ABI size_type __self_off(const _CharT* __s) const {
        const_pointer __b = __p();
        if (__s < __b || __s > __b + __z()) return npos;
        return (size_type)(__s - __b);
    }

public:
    _CCW_LIBCPP_HIDE_FROM_ABI basic_string() { __init(0); }
    _CCW_LIBCPP_HIDE_FROM_ABI explicit basic_string(const allocator_type& __a) : __ra_(__a) { __init(0); }
    _CCW_LIBCPP_HIDE_FROM_ABI basic_string(const basic_string& __o, const allocator_type& __a)
        : __ra_(__a) { __init(__o.__z()); append(__o.__p(), __o.__z()); }
    _CCW_LIBCPP_HIDE_FROM_ABI basic_string(const _CharT* __s) { __init(_Traits::length(__s)); append(__s); }
    _CCW_LIBCPP_HIDE_FROM_ABI basic_string(const _CharT* __s, size_type __n) { __init(__n); append(__s, __n); }
    _CCW_LIBCPP_HIDE_FROM_ABI basic_string(size_type __n, _CharT __c) { __init(__n); append(__n, __c); }
    _CCW_LIBCPP_HIDE_FROM_ABI basic_string(const basic_string& __o) : __ra_(__o.__alloc()) { __init(__o.__z()); append(__o.__p(), __o.__z()); }
    _CCW_LIBCPP_HIDE_FROM_ABI basic_string(const basic_string& __o, size_type __pos, size_type __n = npos) {
        if (__pos > __o.__z()) _CCW_THROW(_CCW_STD::out_of_range("basic_string::basic_string"));
        size_type __rn = __o.__z() - __pos; if (__n < __rn) __rn = __n;
        __init(__rn); append(__o.__p() + __pos, __rn);
    }
    template <class _InputIt>
    _CCW_LIBCPP_HIDE_FROM_ABI basic_string(_InputIt __f, _InputIt __l) {
        __init(0); __ctor_disp(__f, __l, typename __ccw_dispatch_is_int<_InputIt>::_Tag());
    }
    _CCW_LIBCPP_HIDE_FROM_ABI ~basic_string() { __free(); }

    _CCW_LIBCPP_HIDE_FROM_ABI basic_string& operator=(const basic_string& __o) {
        if (this != &__o) { clear(); append(__o.__p(), __o.__z()); }
        return *this;
    }
    _CCW_LIBCPP_HIDE_FROM_ABI basic_string& operator=(const _CharT* __s)  { return assign(__s); }
    _CCW_LIBCPP_HIDE_FROM_ABI basic_string& operator=(_CharT __c)         { clear(); push_back(__c); return *this; }

#if _CCW_HAS_REAL_RVALUE_REF
    _CCW_LIBCPP_HIDE_FROM_ABI basic_string(basic_string&& __o) _CCW_LIBCPP_NOEXCEPT {
        __alloc() = __o.__alloc();     // clobbers __r_'s first byte; repaired just below
        __r()     = __o.__r();
        __o.__init(0);
    }
    _CCW_LIBCPP_HIDE_FROM_ABI basic_string& operator=(basic_string&& __o) _CCW_LIBCPP_NOEXCEPT {
        if (this != &__o) {
            __free();
            __alloc() = __o.__alloc();
            __r()     = __o.__r();
            __o.__init(0);
        }
        return *this;
    }
#else // !_CCW_HAS_REAL_RVALUE_REF
    _CCW_LIBCPP_HIDE_FROM_ABI basic_string(_CCW_RV_REF(basic_string) __rr) {
        basic_string& __o = _CCW_MOVED_OBJ(__rr);
        __alloc() = __o.__alloc();
        __r()     = __o.__r();
        __o.__init(0);
    }
    _CCW_LIBCPP_HIDE_FROM_ABI basic_string& operator=(_CCW_RV_REF(basic_string) __rr) {
        basic_string& __o = _CCW_MOVED_OBJ(__rr);
        if (this != &__o) {
            __free();
            __alloc() = __o.__alloc();
            __r()     = __o.__r();
            __o.__init(0);
        }
        return *this;
    }
#endif

    _CCW_LIBCPP_HIDE_FROM_ABI operator basic_string_view<_CharT, _Traits>() const {
        return basic_string_view<_CharT, _Traits>(data(), size());
    }

    _CCW_LIBCPP_HIDE_FROM_ABI size_type size() const     { return __z(); }
    _CCW_LIBCPP_HIDE_FROM_ABI size_type length() const   { return __z(); }
    _CCW_LIBCPP_HIDE_FROM_ABI size_type capacity() const { return (__is_long() ? __long_cap() : (size_type)__min_cap) - 1; }
    _CCW_LIBCPP_HIDE_FROM_ABI size_type max_size() const {
        size_type __lim = ((size_type)-1 >> 1) - 1;
        size_type __m   = __alloc().max_size();
        return __m < __lim ? __m : __lim;
    }
    _CCW_LIBCPP_HIDE_FROM_ABI bool      empty() const    { return __z() == 0; }
    _CCW_LIBCPP_HIDE_FROM_ABI void      clear()          { __set_size(0); }
    _CCW_LIBCPP_HIDE_FROM_ABI void      reserve(size_type __n) { if (__n > capacity()) __reserve_exact(__n); }
    _CCW_LIBCPP_HIDE_FROM_ABI void      shrink_to_fit()  {
        if (!__is_long()) return;                       // short is already minimal
        size_type __sz = __z();
        if (__fits_sso(__sz)) {                          // move back into the inline buffer
            pointer   __old = __r().__l.__data_;
            size_type __oa  = __long_cap();
            value_type __tmp[__min_cap];
            _Traits::copy(__tmp, __old, __sz);
            __r().__s.__size_ = (unsigned char)(__sz << 1);   // now short (bit0 = 0)
            _Traits::copy(__r().__s.__data_, __tmp, __sz);
            __r().__s.__data_[__sz] = value_type();
            __alloc().deallocate(__old, __oa);
        } else if (__long_cap() > __sz + 1) {
            __reserve_exact(__sz);
        }
    }
    _CCW_LIBCPP_HIDE_FROM_ABI void      resize(size_type __n, _CharT __c = _CharT()) {
        size_type __sz = __z();
        if (__n <= __sz) { __set_size(__n); return; }
        __ensure(__n);
        pointer __d = __p();
        for (size_type __i = __sz; __i < __n; ++__i) __d[__i] = __c;
        __set_size(__n);
    }
    template <class _Op>
    _CCW_LIBCPP_HIDE_FROM_ABI void resize_and_overwrite(size_type __n, _Op __op) {
        __ensure(__n);
        size_type __r = (size_type)__op(__p(), __n);
        __set_size(__r);
    }

    _CCW_LIBCPP_HIDE_FROM_ABI reference       operator[](size_type __i)       { return __p()[__i]; }
    _CCW_LIBCPP_HIDE_FROM_ABI const_reference operator[](size_type __i) const { return __p()[__i]; }
    _CCW_LIBCPP_HIDE_FROM_ABI reference       at(size_type __i)       { if (__i >= __z()) _CCW_THROW(_CCW_STD::out_of_range("basic_string::at")); return __p()[__i]; }
    _CCW_LIBCPP_HIDE_FROM_ABI const_reference at(size_type __i) const { if (__i >= __z()) _CCW_THROW(_CCW_STD::out_of_range("basic_string::at")); return __p()[__i]; }
    _CCW_LIBCPP_HIDE_FROM_ABI reference       front()       { return __p()[0]; }
    _CCW_LIBCPP_HIDE_FROM_ABI const_reference front() const { return __p()[0]; }
    _CCW_LIBCPP_HIDE_FROM_ABI reference       back()        { return __p()[__z() - 1]; }
    _CCW_LIBCPP_HIDE_FROM_ABI const_reference back() const  { return __p()[__z() - 1]; }
    _CCW_LIBCPP_HIDE_FROM_ABI const _CharT*   c_str() const { return __p(); }
    _CCW_LIBCPP_HIDE_FROM_ABI const _CharT*   data()  const { return __p(); }
    _CCW_LIBCPP_HIDE_FROM_ABI _CharT*         data()        { return __p(); }
    _CCW_LIBCPP_HIDE_FROM_ABI allocator_type  get_allocator() const { return __alloc(); }

    _CCW_LIBCPP_HIDE_FROM_ABI iterator       begin()       { return __p(); }
    _CCW_LIBCPP_HIDE_FROM_ABI const_iterator begin() const { return __p(); }
    _CCW_LIBCPP_HIDE_FROM_ABI iterator       end()         { return __p() + __z(); }
    _CCW_LIBCPP_HIDE_FROM_ABI const_iterator end() const   { return __p() + __z(); }
    _CCW_LIBCPP_HIDE_FROM_ABI const_iterator cbegin() const { return __p(); }
    _CCW_LIBCPP_HIDE_FROM_ABI const_iterator cend() const   { return __p() + __z(); }
    _CCW_LIBCPP_HIDE_FROM_ABI reverse_iterator       rbegin()       { return reverse_iterator(end()); }
    _CCW_LIBCPP_HIDE_FROM_ABI reverse_iterator       rend()         { return reverse_iterator(begin()); }
    _CCW_LIBCPP_HIDE_FROM_ABI const_reverse_iterator rbegin() const { return const_reverse_iterator(end()); }
    _CCW_LIBCPP_HIDE_FROM_ABI const_reverse_iterator rend()   const { return const_reverse_iterator(begin()); }
    _CCW_LIBCPP_HIDE_FROM_ABI const_reverse_iterator crbegin() const { return const_reverse_iterator(cend()); }
    _CCW_LIBCPP_HIDE_FROM_ABI const_reverse_iterator crend()   const { return const_reverse_iterator(cbegin()); }

    _CCW_LIBCPP_HIDE_FROM_ABI void push_back(_CharT __c) { size_type __s = __z(); __ensure(__s + 1); __p()[__s] = __c; __set_size(__s + 1); }
    _CCW_LIBCPP_HIDE_FROM_ABI void pop_back()            { __set_size(__z() - 1); }

    _CCW_LIBCPP_HIDE_FROM_ABI basic_string& append(const _CharT* __s, size_type __n) {
        size_type __z0 = __z();
        size_type __off = __self_off(__s);
        __ensure(__z0 + __n);
        if (__off != npos) _Traits::move(__p() + __z0, __p() + __off, __n);
        else               _Traits::copy(__p() + __z0, __s, __n);
        __set_size(__z0 + __n);
        return *this;
    }
    _CCW_LIBCPP_HIDE_FROM_ABI basic_string& append(const _CharT* __s)         { return append(__s, _Traits::length(__s)); }
    _CCW_LIBCPP_HIDE_FROM_ABI basic_string& append(const basic_string& __o)   { return append(__o.__p(), __o.__z()); }
    _CCW_LIBCPP_HIDE_FROM_ABI basic_string& append(const basic_string& __o, size_type __pos, size_type __n = npos) {
        return append(basic_string(__o, __pos, __n));
    }
    _CCW_LIBCPP_HIDE_FROM_ABI basic_string& append(size_type __n, _CharT __c) {
        size_type __z0 = __z(); __ensure(__z0 + __n); _Traits::assign(__p() + __z0, __n, __c); __set_size(__z0 + __n); return *this;
    }
    template <class _InputIt>
    _CCW_LIBCPP_HIDE_FROM_ABI basic_string& append(_InputIt __f, _InputIt __l) { for (; __f != __l; ++__f) push_back(*__f); return *this; }

    _CCW_LIBCPP_HIDE_FROM_ABI basic_string& assign(const basic_string& __o)   {
        if (this == &__o) return *this;
        clear(); return append(__o);
    }
    _CCW_LIBCPP_HIDE_FROM_ABI basic_string& assign(const _CharT* __s)         { return assign(__s, _Traits::length(__s)); }
    _CCW_LIBCPP_HIDE_FROM_ABI basic_string& assign(const _CharT* __s, size_type __n) {
        size_type __off = __self_off(__s);
        if (__off != npos) {                 // clear() would null out what we are about to read
            _Traits::move(__p(), __p() + __off, __n);
            __set_size(__n);
            return *this;
        }
        clear(); return append(__s, __n);
    }
    _CCW_LIBCPP_HIDE_FROM_ABI basic_string& assign(const basic_string& __o, size_type __pos, size_type __n = npos) {
        return assign(basic_string(__o, __pos, __n));
    }
    _CCW_LIBCPP_HIDE_FROM_ABI basic_string& assign(size_type __n, _CharT __c) { clear(); return append(__n, __c); }
    template <class _InputIt>
    _CCW_LIBCPP_HIDE_FROM_ABI basic_string& assign(_InputIt __f, _InputIt __l) {
        return assign(basic_string(__f, __l));
    }

    _CCW_LIBCPP_HIDE_FROM_ABI basic_string& operator+=(const basic_string& __o) { return append(__o); }
    _CCW_LIBCPP_HIDE_FROM_ABI basic_string& operator+=(const _CharT* __s)       { return append(__s); }
    _CCW_LIBCPP_HIDE_FROM_ABI basic_string& operator+=(_CharT __c)             { push_back(__c); return *this; }

    _CCW_LIBCPP_HIDE_FROM_ABI basic_string& insert(size_type __pos, const _CharT* __s, size_type __n) {
        size_type __z0 = __z();
        if (__pos > __z0) _CCW_THROW(_CCW_STD::out_of_range("basic_string::insert"));
        if (__self_off(__s) != npos) {   // s.insert(p, s): the move below would shift it
            basic_string __t(__s, __n);
            return insert(__pos, __t.__p(), __t.__z());
        }
        __ensure(__z0 + __n);
        pointer __d = __p();
        _Traits::move(__d + __pos + __n, __d + __pos, __z0 - __pos);
        _Traits::copy(__d + __pos, __s, __n);
        __set_size(__z0 + __n); return *this;
    }
    _CCW_LIBCPP_HIDE_FROM_ABI basic_string& insert(size_type __pos, const _CharT* __s)       { return insert(__pos, __s, _Traits::length(__s)); }
    _CCW_LIBCPP_HIDE_FROM_ABI basic_string& insert(size_type __pos, const basic_string& __o) { return insert(__pos, __o.__p(), __o.__z()); }
    _CCW_LIBCPP_HIDE_FROM_ABI basic_string& insert(size_type __pos1, const basic_string& __o, size_type __pos2, size_type __n = npos) {
        return insert(__pos1, basic_string(__o, __pos2, __n));
    }
    _CCW_LIBCPP_HIDE_FROM_ABI basic_string& insert(size_type __pos, size_type __n, _CharT __c) {
        size_type __z0 = __z();
        if (__pos > __z0) _CCW_THROW(_CCW_STD::out_of_range("basic_string::insert"));
        __ensure(__z0 + __n);
        pointer __d = __p();
        _Traits::move(__d + __pos + __n, __d + __pos, __z0 - __pos);
        _Traits::assign(__d + __pos, __n, __c);
        __set_size(__z0 + __n); return *this;
    }
    _CCW_LIBCPP_HIDE_FROM_ABI iterator insert(const_iterator __p, _CharT __c) {
        size_type __off = (size_type)(__p - (const_iterator)begin());
        insert(__off, (size_type)1, __c);
        return begin() + __off;
    }
    _CCW_LIBCPP_HIDE_FROM_ABI iterator insert(const_iterator __p, size_type __n, _CharT __c) {
        size_type __off = (size_type)(__p - (const_iterator)begin());
        insert(__off, __n, __c);
        return begin() + __off;
    }
    template <class _InputIt>
    _CCW_LIBCPP_HIDE_FROM_ABI iterator insert(const_iterator __p, _InputIt __f, _InputIt __l) {
        size_type __off = (size_type)(__p - (const_iterator)begin());
        insert(__off, basic_string(__f, __l));
        return begin() + __off;
    }

    _CCW_LIBCPP_HIDE_FROM_ABI basic_string& erase(size_type __pos = 0, size_type __n = npos) {
        size_type __z0 = __z();
        if (__pos > __z0) _CCW_THROW(_CCW_STD::out_of_range("basic_string::erase"));
        size_type __rn = __z0 - __pos; if (__n < __rn) __rn = __n;
        pointer __d = __p();
        _Traits::move(__d + __pos, __d + __pos + __rn, __z0 - __pos - __rn);
        __set_size(__z0 - __rn); return *this;
    }

    _CCW_LIBCPP_HIDE_FROM_ABI basic_string substr(size_type __pos = 0, size_type __n = npos) const {
        size_type __z0 = __z();
        if (__pos > __z0) _CCW_THROW(_CCW_STD::out_of_range("basic_string::substr"));
        size_type __rn = __z0 - __pos; if (__n < __rn) __rn = __n;
        return basic_string(__p() + __pos, __rn);
    }

    _CCW_LIBCPP_HIDE_FROM_ABI int compare(const basic_string& __o) const {
        size_type __a = __z(), __b = __o.__z();
        size_type __n = __a < __b ? __a : __b;
        int __r = _Traits::compare(__p(), __o.__p(), __n);
        if (__r != 0) return __r;
        if (__a < __b) return -1;
        if (__a > __b) return 1;
        return 0;
    }
    _CCW_LIBCPP_HIDE_FROM_ABI int compare(const _CharT* __s) const { return compare(basic_string(__s)); }

    _CCW_LIBCPP_HIDE_FROM_ABI size_type find(const _CharT* __s, size_type __pos, size_type __n) const {
        size_type __z0 = __z();
        if (__n == 0) return __pos <= __z0 ? __pos : npos;
        if (__z0 < __n) return npos;
        const_pointer __d = __p();
        for (size_type __i = __pos; __i + __n <= __z0; ++__i)
            if (_Traits::compare(__d + __i, __s, __n) == 0) return __i;
