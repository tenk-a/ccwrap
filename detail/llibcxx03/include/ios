template <class _StateT>
class fpos {
public:
    typedef _StateT state_type;
    _CCW_LIBCPP_HIDE_FROM_ABI fpos(streamoff __off = 0) : __off_(__off), __st_() {}
    _CCW_LIBCPP_HIDE_FROM_ABI operator streamoff() const { return __off_; }
    _CCW_LIBCPP_HIDE_FROM_ABI state_type state() const { return __st_; }
    _CCW_LIBCPP_HIDE_FROM_ABI void state(state_type __s) { __st_ = __s; }
    _CCW_LIBCPP_HIDE_FROM_ABI fpos& operator+=(streamoff __o) { __off_ += __o; return *this; }
    _CCW_LIBCPP_HIDE_FROM_ABI fpos& operator-=(streamoff __o) { __off_ -= __o; return *this; }
    _CCW_LIBCPP_HIDE_FROM_ABI fpos  operator+(streamoff __o) const { fpos __t(*this); __t += __o; return __t; }
    _CCW_LIBCPP_HIDE_FROM_ABI fpos  operator-(streamoff __o) const { fpos __t(*this); __t -= __o; return __t; }
    _CCW_LIBCPP_HIDE_FROM_ABI streamoff operator-(const fpos& __r) const { return __off_ - __r.__off_; }
private:
    streamoff  __off_;
    state_type __st_;
};
template <class _St> _CCW_LIBCPP_HIDE_FROM_ABI bool operator==(const fpos<_St>& __x, const fpos<_St>& __y) { return streamoff(__x) == streamoff(__y); }
template <class _St> _CCW_LIBCPP_HIDE_FROM_ABI bool operator!=(const fpos<_St>& __x, const fpos<_St>& __y) { return streamoff(__x) != streamoff(__y); }

class ios_base {
public:
    typedef int fmtflags;
    typedef int iostate;
    typedef int openmode;
    typedef int seekdir;

    static const fmtflags boolalpha  = 0x0001;
    static const fmtflags dec        = 0x0002;
    static const fmtflags oct        = 0x0004;
    static const fmtflags hex        = 0x0008;
    static const fmtflags basefield  = dec | oct | hex;
    static const fmtflags left       = 0x0010;
    static const fmtflags right      = 0x0020;
    static const fmtflags internal   = 0x0040;
    static const fmtflags adjustfield = left | right | internal;
    static const fmtflags scientific = 0x0080;
    static const fmtflags fixed      = 0x0100;
    static const fmtflags floatfield = scientific | fixed;
    static const fmtflags showbase   = 0x0200;
    static const fmtflags showpoint  = 0x0400;
    static const fmtflags showpos    = 0x0800;
    static const fmtflags skipws     = 0x1000;
    static const fmtflags unitbuf    = 0x2000;
    static const fmtflags uppercase  = 0x4000;

    static const iostate goodbit = 0x0;
    static const iostate eofbit  = 0x1;
    static const iostate failbit = 0x2;
    static const iostate badbit  = 0x4;

    static const openmode in        = 0x01;
    static const openmode out       = 0x02;
    static const openmode ate       = 0x04;
    static const openmode app       = 0x08;
    static const openmode trunc     = 0x10;
    static const openmode binary    = 0x20;
    static const openmode noreplace = 0x40;   // C++23

    static const seekdir beg = 0;
    static const seekdir cur = 1;
    static const seekdir end = 2;

    class failure : public _CCW_STD::system_error {
    public:
        _CCW_LIBCPP_HIDE_FROM_ABI explicit failure(const _CCW_STD::string& __what,
                                               const error_code& __ec = make_error_code(io_errc::stream))
            : _CCW_STD::system_error(__ec, __what) {}
        _CCW_LIBCPP_HIDE_FROM_ABI explicit failure(const char* __what,
                                               const error_code& __ec = make_error_code(io_errc::stream))
            : _CCW_STD::system_error(__ec, __what) {}
    };

    enum event { erase_event, imbue_event, copyfmt_event };
    typedef void (*event_callback)(event, ios_base&, int);
    _CCW_LIBCPP_HIDE_FROM_ABI void register_callback(event_callback __fn, int __idx) {
        __cb_ = (__cb_entry*)_CCW_STD::realloc(__cb_, (__cbsz_ + 1) * sizeof(__cb_entry));
        __cb_[__cbsz_].__fn = __fn; __cb_[__cbsz_].__idx = __idx; ++__cbsz_;
    }

    _CCW_LIBCPP_HIDE_FROM_ABI static int xalloc() { static int __idx = 0; return __idx++; }
    _CCW_LIBCPP_HIDE_FROM_ABI long&  iword(int __idx) { __grow_i(__idx); return __iarr_[__idx]; }
    _CCW_LIBCPP_HIDE_FROM_ABI void*& pword(int __idx) { __grow_p(__idx); return __parr_[__idx]; }

    _CCW_LIBCPP_HIDE_FROM_ABI static bool sync_with_stdio(bool = true) { return true; }

    class Init {
    public:
        _CCW_LIBCPP_HIDE_FROM_ABI Init() { ++__init_count(); }
        _CCW_LIBCPP_HIDE_FROM_ABI Init(const Init&) { ++__init_count(); }
        _CCW_LIBCPP_HIDE_FROM_ABI Init& operator=(const Init&) { return *this; }
        _CCW_LIBCPP_HIDE_FROM_ABI ~Init() { --__init_count(); }
    private:
        _CCW_LIBCPP_HIDE_FROM_ABI static int& __init_count() { static int __c = 0; return __c; }
    };

    _CCW_LIBCPP_HIDE_FROM_ABI fmtflags flags() const { return __fl_; }
    _CCW_LIBCPP_HIDE_FROM_ABI fmtflags flags(fmtflags __f) { fmtflags __o = __fl_; __fl_ = __f; return __o; }
    _CCW_LIBCPP_HIDE_FROM_ABI fmtflags setf(fmtflags __f) { fmtflags __o = __fl_; __fl_ |= __f; return __o; }
    _CCW_LIBCPP_HIDE_FROM_ABI fmtflags setf(fmtflags __f, fmtflags __mask) { fmtflags __o = __fl_; __fl_ = (__fl_ & ~__mask) | (__f & __mask); return __o; }
    _CCW_LIBCPP_HIDE_FROM_ABI void     unsetf(fmtflags __f) { __fl_ &= ~__f; }
    _CCW_LIBCPP_HIDE_FROM_ABI _CCW_STD::streamsize precision() const { return __prec_; }
    _CCW_LIBCPP_HIDE_FROM_ABI _CCW_STD::streamsize precision(_CCW_STD::streamsize __p) { _CCW_STD::streamsize __o = __prec_; __prec_ = __p; return __o; }
    _CCW_LIBCPP_HIDE_FROM_ABI _CCW_STD::streamsize width() const { return __width_; }
    _CCW_LIBCPP_HIDE_FROM_ABI _CCW_STD::streamsize width(_CCW_STD::streamsize __w) { _CCW_STD::streamsize __o = __width_; __width_ = __w; return __o; }
    _CCW_LIBCPP_HIDE_FROM_ABI locale imbue(const locale& __loc) {
        locale __old = __loc_;
        __loc_ = __loc;
        __call_callbacks(imbue_event);
        return __old;
    }
    _CCW_LIBCPP_HIDE_FROM_ABI locale getloc() const { return __loc_; }

protected:
    _CCW_LIBCPP_HIDE_FROM_ABI ios_base()
        : __fl_(skipws | dec), __prec_(6), __width_(0),
          __iarr_(0), __isz_(0), __parr_(0), __psz_(0), __cb_(0), __cbsz_(0) {}
    _CCW_LIBCPP_HIDE_FROM_ABI virtual ~ios_base() { __call_callbacks(erase_event); _CCW_STD::free(__iarr_); _CCW_STD::free(__parr_); _CCW_STD::free(__cb_); }

    _CCW_LIBCPP_HIDE_FROM_ABI void __call_callbacks(event __ev) {
        for (int __i = __cbsz_ - 1; __i >= 0; --__i) __cb_[__i].__fn(__ev, *this, __cb_[__i].__idx);
    }

    _CCW_LIBCPP_HIDE_FROM_ABI void __copyfmt_base(const ios_base& __r) {
        __call_callbacks(erase_event);
        __fl_ = __r.__fl_; __prec_ = __r.__prec_; __width_ = __r.__width_; __loc_ = __r.__loc_;
        __adopt_i(__r); __adopt_p(__r); __adopt_cb(__r);
        __call_callbacks(copyfmt_event);
    }

    fmtflags        __fl_;
    _CCW_STD::streamsize __prec_;
    _CCW_STD::streamsize __width_;
    locale          __loc_;
private:
    struct __cb_entry { event_callback __fn; int __idx; };
    long*        __iarr_;  int __isz_;
    void**       __parr_;  int __psz_;
    __cb_entry*  __cb_;    int __cbsz_;

    _CCW_LIBCPP_HIDE_FROM_ABI void __grow_i(int __idx) {
        if (__idx < __isz_) return;
        int __n = __idx + 1;
        __iarr_ = (long*)_CCW_STD::realloc(__iarr_, __n * sizeof(long));
        for (int __i = __isz_; __i < __n; ++__i) __iarr_[__i] = 0;
        __isz_ = __n;
    }
    _CCW_LIBCPP_HIDE_FROM_ABI void __grow_p(int __idx) {
        if (__idx < __psz_) return;
        int __n = __idx + 1;
        __parr_ = (void**)_CCW_STD::realloc(__parr_, __n * sizeof(void*));
        for (int __i = __psz_; __i < __n; ++__i) __parr_[__i] = 0;
        __psz_ = __n;
    }

    _CCW_LIBCPP_HIDE_FROM_ABI void __adopt_i(const ios_base& __r) {
        if (__r.__isz_ == 0) { _CCW_STD::free(__iarr_); __iarr_ = 0; __isz_ = 0; return; }
        __iarr_ = (long*)_CCW_STD::realloc(__iarr_, __r.__isz_ * sizeof(long));
        for (int __i = 0; __i < __r.__isz_; ++__i) __iarr_[__i] = __r.__iarr_[__i];
        __isz_ = __r.__isz_;
    }
    _CCW_LIBCPP_HIDE_FROM_ABI void __adopt_p(const ios_base& __r) {
        if (__r.__psz_ == 0) { _CCW_STD::free(__parr_); __parr_ = 0; __psz_ = 0; return; }
        __parr_ = (void**)_CCW_STD::realloc(__parr_, __r.__psz_ * sizeof(void*));
        for (int __i = 0; __i < __r.__psz_; ++__i) __parr_[__i] = __r.__parr_[__i];
        __psz_ = __r.__psz_;
    }
    _CCW_LIBCPP_HIDE_FROM_ABI void __adopt_cb(const ios_base& __r) {
        if (__r.__cbsz_ == 0) { _CCW_STD::free(__cb_); __cb_ = 0; __cbsz_ = 0; return; }
        __cb_ = (__cb_entry*)_CCW_STD::realloc(__cb_, __r.__cbsz_ * sizeof(__cb_entry));
        for (int __i = 0; __i < __r.__cbsz_; ++__i) __cb_[__i] = __r.__cb_[__i];
        __cbsz_ = __r.__cbsz_;
    }

    ios_base(const ios_base&);
    ios_base& operator=(const ios_base&);
};

