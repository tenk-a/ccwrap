template <class _CharT, class _Traits >
class basic_ios : public ios_base {
public:
    typedef _CharT                     char_type;
    typedef _Traits                    traits_type;
    typedef typename _Traits::int_type int_type;
    typedef typename _Traits::pos_type pos_type;
    typedef typename _Traits::off_type off_type;
    typedef basic_streambuf<_CharT, _Traits> __streambuf_type;
private:
    __streambuf_type* __sb_;
    basic_ios*        __tie_;
    iostate           __state_;
    iostate           __except_;
    char_type         __fill_;
public:
    _CCW_LIBCPP_HIDE_FROM_ABI explicit basic_ios(__streambuf_type* __sb) { init(__sb); }

    _CCW_LIBCPP_HIDE_FROM_ABI __streambuf_type* rdbuf() const { return __sb_; }
    _CCW_LIBCPP_HIDE_FROM_ABI __streambuf_type* rdbuf(__streambuf_type* __sb) { __streambuf_type* __o = __sb_; __sb_ = __sb; clear(); return __o; }
    _CCW_LIBCPP_HIDE_FROM_ABI basic_ios* tie() const { return __tie_; }
    _CCW_LIBCPP_HIDE_FROM_ABI basic_ios* tie(basic_ios* __t) { basic_ios* __o = __tie_; __tie_ = __t; return __o; }

    _CCW_LIBCPP_HIDE_FROM_ABI iostate rdstate() const { return __state_; }
    _CCW_LIBCPP_HIDE_FROM_ABI void    clear(iostate __s = goodbit) {
        __state_ = __sb_ ? __s : (iostate)(__s | badbit);
        if (__state_ & __except_) _CCW_THROW(failure("ios_base::clear"));
    }
    _CCW_LIBCPP_HIDE_FROM_ABI void    setstate(iostate __s) { clear(__state_ | __s); }
    _CCW_LIBCPP_HIDE_FROM_ABI iostate exceptions() const { return __except_; }
    _CCW_LIBCPP_HIDE_FROM_ABI void    exceptions(iostate __e) { __except_ = __e; clear(__state_); }
    _CCW_LIBCPP_HIDE_FROM_ABI bool    good() const { return __state_ == goodbit; }
    _CCW_LIBCPP_HIDE_FROM_ABI bool    eof()  const { return (__state_ & eofbit)  != 0; }
    _CCW_LIBCPP_HIDE_FROM_ABI bool    fail() const { return (__state_ & (failbit | badbit)) != 0; }
    _CCW_LIBCPP_HIDE_FROM_ABI bool    bad()  const { return (__state_ & badbit)  != 0; }
    _CCW_LIBCPP_HIDE_FROM_ABI bool    operator!() const { return fail(); }
    typedef void (basic_ios::*__bool_type)() const;
    _CCW_LIBCPP_HIDE_FROM_ABI void    __true_bool() const {}
    _CCW_LIBCPP_HIDE_FROM_ABI operator __bool_type() const { return fail() ? 0 : &basic_ios::__true_bool; }

    _CCW_LIBCPP_HIDE_FROM_ABI char_type fill() const { return __fill_; }
    _CCW_LIBCPP_HIDE_FROM_ABI char_type fill(char_type __c) { char_type __o = __fill_; __fill_ = __c; return __o; }
    _CCW_LIBCPP_HIDE_FROM_ABI locale imbue(const locale& __loc) {
        locale __old = ios_base::imbue(__loc);
        if (__sb_) __sb_->pubimbue(__loc);
        return __old;
    }

    _CCW_LIBCPP_HIDE_FROM_ABI basic_ios& copyfmt(const basic_ios& __r) {
        if (this != &__r) {
            __tie_  = __r.__tie_;
            __fill_ = __r.__fill_;
            ios_base::__copyfmt_base(__r);   // erase_event -> state+storage -> copyfmt_event
            exceptions(__r.__except_);       // "altered last"
        }
        return *this;
    }

    _CCW_LIBCPP_HIDE_FROM_ABI char_type widen(char __c) const { return __c; }
    _CCW_LIBCPP_HIDE_FROM_ABI char narrow(char_type __c, char /*__dflt*/) const { return __c; }

    virtual ~basic_ios() {}
protected:
    _CCW_LIBCPP_HIDE_FROM_ABI basic_ios() : __sb_(0), __tie_(0), __state_(badbit), __except_(goodbit), __fill_(' ') {}
    _CCW_LIBCPP_HIDE_FROM_ABI void init(__streambuf_type* __sb) { __sb_ = __sb; __tie_ = 0; __state_ = __sb ? goodbit : badbit; __except_ = goodbit; __fill_ = ' '; __fl_ = skipws | dec; __prec_ = 6; __width_ = 0; __loc_ = locale(); }

    _CCW_LIBCPP_HIDE_FROM_ABI void set_rdbuf(__streambuf_type* __sb) { __sb_ = __sb; }
    _CCW_LIBCPP_HIDE_FROM_ABI void __ccw_move_ios(basic_ios& __r) {
        __tie_    = __r.__tie_;
        __state_  = __r.__state_;
        __except_ = __r.__except_;
        __fill_   = __r.__fill_;
        __fl_     = __r.__fl_;
        __prec_   = __r.__prec_;
        __width_  = __r.__width_;
        __loc_    = __r.__loc_;
        __r.__tie_ = 0;
    }
    _CCW_LIBCPP_HIDE_FROM_ABI void __ccw_swap_ios(basic_ios& __r) {
        basic_ios* __t2 = __tie_;   __tie_   = __r.__tie_;   __r.__tie_   = __t2;
        iostate  __s   = __state_;  __state_ = __r.__state_; __r.__state_ = __s;
        iostate  __e   = __except_; __except_= __r.__except_;__r.__except_= __e;
        char_type __f  = __fill_;   __fill_  = __r.__fill_;  __r.__fill_  = __f;
        fmtflags __fl  = __fl_;     __fl_    = __r.__fl_;    __r.__fl_    = __fl;
        streamsize __p = __prec_;   __prec_  = __r.__prec_;  __r.__prec_  = __p;
        streamsize __w = __width_;  __width_ = __r.__width_; __r.__width_ = __w;
        locale __l     = __loc_;    __loc_   = __r.__loc_;   __r.__loc_   = __l;
    }
};

