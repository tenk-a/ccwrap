struct memory_order {
    int __v_;
    _CCW_LIBCPP_HIDE_FROM_ABI memory_order() : __v_(5) {}          // seq_cst
    _CCW_LIBCPP_HIDE_FROM_ABI memory_order(int __v) : __v_(__v) {}
    enum _E { relaxed = 0, consume = 1, acquire = 2, release = 3, acq_rel = 4, seq_cst = 5 };
};
_CCW_LIBCPP_HIDE_FROM_ABI inline bool operator==(memory_order __a, memory_order __b) { return __a.__v_ == __b.__v_; }
_CCW_LIBCPP_HIDE_FROM_ABI inline bool operator!=(memory_order __a, memory_order __b) { return __a.__v_ != __b.__v_; }

_ccw_inline_const memory_order memory_order_relaxed = memory_order(memory_order::relaxed);
_ccw_inline_const memory_order memory_order_consume = memory_order(memory_order::consume);
_ccw_inline_const memory_order memory_order_acquire = memory_order(memory_order::acquire);
_ccw_inline_const memory_order memory_order_release = memory_order(memory_order::release);
_ccw_inline_const memory_order memory_order_acq_rel = memory_order(memory_order::acq_rel);
_ccw_inline_const memory_order memory_order_seq_cst = memory_order(memory_order::seq_cst);

template <class _Tp>
struct atomic {
    typedef _Tp value_type;
    typedef _Tp difference_type;                 // meaningful for integral/pointer atomics
    static const bool is_always_lock_free = false;

    _Tp __v_;
    _CCW_LIBCPP_HIDE_FROM_ABI atomic() : __v_() {}
    _CCW_LIBCPP_HIDE_FROM_ABI atomic(_Tp __d) : __v_(__d) {}

    _CCW_LIBCPP_HIDE_FROM_ABI _Tp  load(memory_order = memory_order_seq_cst) const { return __v_; }
    _CCW_LIBCPP_HIDE_FROM_ABI void store(_Tp __d, memory_order = memory_order_seq_cst) { __v_ = __d; }
    _CCW_LIBCPP_HIDE_FROM_ABI _Tp  exchange(_Tp __d, memory_order = memory_order_seq_cst) { _Tp __o = __v_; __v_ = __d; return __o; }
    _CCW_LIBCPP_HIDE_FROM_ABI bool compare_exchange_strong(_Tp& __exp, _Tp __des, memory_order = memory_order_seq_cst) {
        if (_CCW_STD::memcmp(&__v_, &__exp, sizeof(_Tp)) == 0) { __v_ = __des; return true; }
        __exp = __v_; return false;
    }
    _CCW_LIBCPP_HIDE_FROM_ABI bool compare_exchange_weak(_Tp& __exp, _Tp __des, memory_order = memory_order_seq_cst) {
        return compare_exchange_strong(__exp, __des);
    }
    _CCW_LIBCPP_HIDE_FROM_ABI bool compare_exchange_strong(_Tp& __exp, _Tp __des, memory_order, memory_order) {
        return compare_exchange_strong(__exp, __des);
    }
    _CCW_LIBCPP_HIDE_FROM_ABI bool compare_exchange_weak(_Tp& __exp, _Tp __des, memory_order, memory_order) {
        return compare_exchange_strong(__exp, __des);
    }
    _CCW_LIBCPP_HIDE_FROM_ABI bool is_lock_free() const { return sizeof(_Tp) <= sizeof(long); }

    _CCW_LIBCPP_HIDE_FROM_ABI operator _Tp() const { return __v_; }
    _CCW_LIBCPP_HIDE_FROM_ABI _Tp operator=(_Tp __d) { __v_ = __d; return __d; }

    _CCW_LIBCPP_HIDE_FROM_ABI _Tp fetch_add(_Tp __d, memory_order = memory_order_seq_cst) { _Tp __o = __v_; __v_ += __d; return __o; }
    _CCW_LIBCPP_HIDE_FROM_ABI _Tp fetch_sub(_Tp __d, memory_order = memory_order_seq_cst) { _Tp __o = __v_; __v_ -= __d; return __o; }
    _CCW_LIBCPP_HIDE_FROM_ABI _Tp operator++()    { return ++__v_; }
    _CCW_LIBCPP_HIDE_FROM_ABI _Tp operator++(int) { return __v_++; }
    _CCW_LIBCPP_HIDE_FROM_ABI _Tp operator--()    { return --__v_; }
    _CCW_LIBCPP_HIDE_FROM_ABI _Tp operator--(int) { return __v_--; }
    _CCW_LIBCPP_HIDE_FROM_ABI _Tp operator+=(_Tp __d) { __v_ += __d; return __v_; }
    _CCW_LIBCPP_HIDE_FROM_ABI _Tp operator-=(_Tp __d) { __v_ -= __d; return __v_; }
    _CCW_LIBCPP_HIDE_FROM_ABI _Tp fetch_and(_Tp __d, memory_order = memory_order_seq_cst) { _Tp __o = __v_; __v_ &= __d; return __o; }
    _CCW_LIBCPP_HIDE_FROM_ABI _Tp fetch_or(_Tp __d,  memory_order = memory_order_seq_cst) { _Tp __o = __v_; __v_ |= __d; return __o; }
    _CCW_LIBCPP_HIDE_FROM_ABI _Tp fetch_xor(_Tp __d, memory_order = memory_order_seq_cst) { _Tp __o = __v_; __v_ ^= __d; return __o; }
    _CCW_LIBCPP_HIDE_FROM_ABI _Tp operator&=(_Tp __d) { __v_ &= __d; return __v_; }
    _CCW_LIBCPP_HIDE_FROM_ABI _Tp operator|=(_Tp __d) { __v_ |= __d; return __v_; }
    _CCW_LIBCPP_HIDE_FROM_ABI _Tp operator^=(_Tp __d) { __v_ ^= __d; return __v_; }

    _CCW_LIBCPP_HIDE_FROM_ABI _Tp fetch_max(_Tp __d, memory_order = memory_order_seq_cst) { _Tp __o = __v_; if (__d > __o) __v_ = __d; return __o; }
    _CCW_LIBCPP_HIDE_FROM_ABI _Tp fetch_min(_Tp __d, memory_order = memory_order_seq_cst) { _Tp __o = __v_; if (__d < __o) __v_ = __d; return __o; }

    _CCW_LIBCPP_HIDE_FROM_ABI void wait(_Tp __old, memory_order __o = memory_order_seq_cst) const {
        for (;;) {
            _Tp __cur = load(__o);
            if (_CCW_STD::memcmp(&__cur, &__old, sizeof(_Tp)) != 0) return;
        }
    }
    _CCW_LIBCPP_HIDE_FROM_ABI void notify_one() {}
    _CCW_LIBCPP_HIDE_FROM_ABI void notify_all() {}

private:
    atomic(const atomic&);            // non-copyable, like _CCW_STD::atomic
    atomic& operator=(const atomic&);
};

