template <class _Tp>
struct atomic<_Tp*> {
    typedef _Tp* value_type;
    typedef ptrdiff_t difference_type;
#if defined(_CCW_ATOMIC_REAL)
    static const bool is_always_lock_free = true;
#else
    static const bool is_always_lock_free = false;
#endif
    _Tp* __v_;
    _CCW_LIBCPP_HIDE_FROM_ABI atomic() : __v_(0) {}
    _CCW_LIBCPP_HIDE_FROM_ABI atomic(_Tp* __d) : __v_(__d) {}

    _CCW_LIBCPP_HIDE_FROM_ABI _Tp* load(memory_order = memory_order_seq_cst) const { return __v_; }
    _CCW_LIBCPP_HIDE_FROM_ABI void store(_Tp* __d, memory_order = memory_order_seq_cst) {
#if defined(_CCW_ATOMIC_REAL)
        __ccw_ilk_pxchg((__ccw_ilk_iptr volatile*)&__v_, (__ccw_ilk_iptr)__d);
#else
        __v_ = __d;
#endif
    }
    _CCW_LIBCPP_HIDE_FROM_ABI _Tp* exchange(_Tp* __d, memory_order = memory_order_seq_cst) {
#if defined(_CCW_ATOMIC_REAL)
        return (_Tp*)__ccw_ilk_pxchg((__ccw_ilk_iptr volatile*)&__v_, (__ccw_ilk_iptr)__d);
#else
        _Tp* __o = __v_; __v_ = __d; return __o;
#endif
    }
    _CCW_LIBCPP_HIDE_FROM_ABI bool compare_exchange_strong(_Tp*& __exp, _Tp* __des, memory_order = memory_order_seq_cst) {
#if defined(_CCW_ATOMIC_REAL)
        __ccw_ilk_iptr __old = __ccw_ilk_pcas((__ccw_ilk_iptr volatile*)&__v_, (__ccw_ilk_iptr)__des, (__ccw_ilk_iptr)__exp);
        if (__old == (__ccw_ilk_iptr)__exp) return true; __exp = (_Tp*)__old; return false;
#else
        if (__v_ == __exp) { __v_ = __des; return true; } __exp = __v_; return false;
#endif
    }
    _CCW_LIBCPP_HIDE_FROM_ABI bool compare_exchange_weak(_Tp*& __exp, _Tp* __des, memory_order = memory_order_seq_cst) {
        return compare_exchange_strong(__exp, __des);
    }
    _CCW_LIBCPP_HIDE_FROM_ABI bool compare_exchange_strong(_Tp*& __exp, _Tp* __des, memory_order, memory_order) {
        return compare_exchange_strong(__exp, __des);
    }
    _CCW_LIBCPP_HIDE_FROM_ABI bool compare_exchange_weak(_Tp*& __exp, _Tp* __des, memory_order, memory_order) {
        return compare_exchange_strong(__exp, __des);
    }
    _CCW_LIBCPP_HIDE_FROM_ABI bool is_lock_free() const { return true; }

    _CCW_LIBCPP_HIDE_FROM_ABI operator _Tp*() const { return __v_; }
    _CCW_LIBCPP_HIDE_FROM_ABI _Tp* operator=(_Tp* __d) { store(__d); return __d; }

    _CCW_LIBCPP_HIDE_FROM_ABI _Tp* fetch_add(ptrdiff_t __d, memory_order = memory_order_seq_cst) {
#if defined(_CCW_ATOMIC_REAL)
        return (_Tp*)__ccw_ilk_pxadd((__ccw_ilk_iptr volatile*)&__v_, (__ccw_ilk_iptr)(__d * (ptrdiff_t)sizeof(_Tp)));
#else
        _Tp* __o = __v_; __v_ += __d; return __o;
#endif
    }
    _CCW_LIBCPP_HIDE_FROM_ABI _Tp* fetch_sub(ptrdiff_t __d, memory_order = memory_order_seq_cst) {
#if defined(_CCW_ATOMIC_REAL)
        return (_Tp*)__ccw_ilk_pxadd((__ccw_ilk_iptr volatile*)&__v_, -(__ccw_ilk_iptr)(__d * (ptrdiff_t)sizeof(_Tp)));
#else
        _Tp* __o = __v_; __v_ -= __d; return __o;
#endif
    }
    _CCW_LIBCPP_HIDE_FROM_ABI _Tp* operator++()    { return fetch_add(1) + 1; }
    _CCW_LIBCPP_HIDE_FROM_ABI _Tp* operator++(int) { return fetch_add(1); }
    _CCW_LIBCPP_HIDE_FROM_ABI _Tp* operator--()    { return fetch_sub(1) - 1; }
    _CCW_LIBCPP_HIDE_FROM_ABI _Tp* operator--(int) { return fetch_sub(1); }
    _CCW_LIBCPP_HIDE_FROM_ABI _Tp* operator+=(ptrdiff_t __d) { return fetch_add(__d) + __d; }
    _CCW_LIBCPP_HIDE_FROM_ABI _Tp* operator-=(ptrdiff_t __d) { return fetch_sub(__d) - __d; }

    _CCW_LIBCPP_HIDE_FROM_ABI void wait(_Tp* __old, memory_order __mo = memory_order_seq_cst) const { while (load(__mo) == __old) {} }
    _CCW_LIBCPP_HIDE_FROM_ABI void notify_one() {}
    _CCW_LIBCPP_HIDE_FROM_ABI void notify_all() {}
private:
    atomic(const atomic&);
    atomic& operator=(const atomic&);
};

