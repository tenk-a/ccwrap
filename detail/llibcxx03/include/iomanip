        case 'd': case 'e': __ok = __iom_get_num(__is, 2, __v); if (__ok) __m.__t->tm_mday = __v; break;
        case 'H': __ok = __iom_get_num(__is, 2, __v); if (__ok) __m.__t->tm_hour = __v; break;
        case 'I': __ok = __iom_get_num(__is, 2, __v); if (__ok) __m.__t->tm_hour = __v; break;
        case 'M': __ok = __iom_get_num(__is, 2, __v); if (__ok) __m.__t->tm_min = __v; break;
