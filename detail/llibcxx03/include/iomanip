        if (_Traits::eq(__m.__cs[__i], __m.__d) || _Traits::eq(__m.__cs[__i], __m.__e)) __os << __m.__e;
        __os << __m.__cs[__i];
    }
    __os << __m.__d;
    return __os;
}
template <class _CharT, class _Traits>
_CCW_LIBCPP_HIDE_FROM_ABI basic_istream<_CharT, _Traits>& operator>>(basic_istream<_CharT, _Traits>& __is, __iom_quoted __m) {
    _CharT __c;
    __is >> __c;                      // skips whitespace, reads opening char
    if (!__is) return __is;
    if (!_Traits::eq(__c, __m.__d)) { // not quoted: read a single word
        __is.putback(__c);
        __is >> *__m.__ws;
        return __is;
    }
    __m.__ws->clear();
    ios_base::fmtflags __fl = __is.flags();
    __is.unsetf(ios_base::skipws);    // read every char verbatim inside quotes
    for (;;) {
        if (!(__is >> __c)) break;
        if (_Traits::eq(__c, __m.__e)) {          // escape: take next char literally
            if (!(__is >> __c)) break;
        } else if (_Traits::eq(__c, __m.__d)) {   // closing delimiter
            break;
        }
        __m.__ws->push_back(__c);
    }
    __is.flags(__fl);
    return __is;
}

