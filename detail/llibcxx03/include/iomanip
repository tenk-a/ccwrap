    int  __len = 0;
    for (;;) {
        typename _Traits::int_type __c = __is.rdbuf()->sgetc();
        if (_Traits::eq_int_type(__c, _Traits::eof())) break;
        char __ch = static_cast<char>(_Traits::to_char_type(__c));
        if (!((__ch >= 'a' && __ch <= 'z') || (__ch >= 'A' && __ch <= 'Z'))) break;
        if (__len == 31) break;
        __got[__len++] = (__ch >= 'A' && __ch <= 'Z') ? static_cast<char>(__ch - 'A' + 'a') : __ch;
        __is.rdbuf()->sbumpc();
    }
    __got[__len] = '\0';
    if (__len == 0) return false;
    for (int __i = 0; __i < __cnt; ++__i) {
        int __nl = __iom_tm_name_len(__names[__i]);
        int __k = 0;
        while (__k < __len && __k < __nl) {
            char __a = __names[__i][__k];
            if (__a >= 'A' && __a <= 'Z') __a = static_cast<char>(__a - 'A' + 'a');
            if (__a != __got[__k]) break;
