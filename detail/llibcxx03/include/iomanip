struct __iom_quoted { const char* __cs; size_t __n; basic_string<char>* __ws; char __d; char __e; };

template <class _CharT, class _Traits>
_CCW_LIBCPP_HIDE_FROM_ABI basic_ostream<_CharT, _Traits>& operator<<(basic_ostream<_CharT, _Traits>& __os, __iom_quoted __m) {
