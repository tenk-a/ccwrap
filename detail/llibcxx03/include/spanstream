        : basic_iostream<_CharT, _Traits>(&__sb_), __sb_(__s, __which) {}
    _CCW_LIBCPP_HIDE_FROM_ABI ~basic_spanstream() {}
    _CCW_LIBCPP_HIDE_FROM_ABI basic_spanbuf<_CharT, _Traits>* rdbuf() const { return const_cast<basic_spanbuf<_CharT, _Traits>*>(&__sb_); }
