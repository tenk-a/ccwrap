    _CCW_LIBCPP_HIDE_FROM_ABI basic_spanstream& operator=(basic_spanstream&& __o) { this->swap(__o); return *this; }
#endif
    _CCW_LIBCPP_HIDE_FROM_ABI void swap(basic_spanstream& __o) { __sb_.swap(__o.__sb_); }
};

