    valarray<_CCW_STD::size_t> __out_(__total);
    if (__total == 0) return __out_;

    valarray<_CCW_STD::size_t> __j(_CCW_STD::size_t(0), __r);       // the current multi-index
    for (_CCW_STD::size_t __c = 0; __c < __total; ++__c) {
        _CCW_STD::size_t __off = __start_;
        for (_CCW_STD::size_t __k = 0; __k < __r; ++__k) __off += __j[__k] * (*__stride_)[__k];
        __out_[__c] = __off;
        for (_CCW_STD::size_t __k = __r; __k-- > 0; ) {
            if (++__j[__k] < (*__size_)[__k]) break;
            __j[__k] = 0;
        }
