    static const int fixed      = 2;
    static const int general    = 3;   // fixed | scientific
    static const int hex        = 4;

    _CCW_LIBCPP_HIDE_FROM_ABI chars_format& operator&=(const chars_format& __o) { __v_ &= __o.__v_; return *this; }
    _CCW_LIBCPP_HIDE_FROM_ABI chars_format& operator|=(const chars_format& __o) { __v_ |= __o.__v_; return *this; }
    _CCW_LIBCPP_HIDE_FROM_ABI chars_format& operator^=(const chars_format& __o) { __v_ ^= __o.__v_; return *this; }
};

_CCW_LIBCPP_HIDE_FROM_ABI inline bool operator==(const chars_format& __a, const chars_format& __b) { return __a.__v_ == __b.__v_; }
