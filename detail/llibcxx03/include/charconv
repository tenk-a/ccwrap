template <class _Int>
_CCW_LIBCPP_HIDE_FROM_ABI to_chars_result to_chars(char* __first, char* __last, _Int __val_, int __base) {
    typedef typename make_unsigned<_Int>::type _U;
    bool __neg = false;
    _U __mag;
    if (is_signed<_Int>::value && __val_ < 0) { __neg = true; __mag = _U(_U(0) - _U(__val_)); }
    else __mag = _U(__val_);
    char __tmp[sizeof(_U) * 8 + 1]; int __n = 0;
    do { __tmp[__n++] = __ccw_cc::__digit(unsigned(__mag % _U(__base))); __mag /= _U(__base); } while (__mag != 0);
    int __total = __n + (__neg ? 1 : 0);
    to_chars_result __r;
    if (__total > (__last - __first)) { __r.ptr = __last; __r.ec = errc::value_too_large; return __r; }
    char* __d = __first;
    if (__neg) *__d++ = '-';
    while (__n) *__d++ = __tmp[--__n];
    __r.ptr = __d; __r.ec = errc();
    return __r;
}
template <class _Int>
_CCW_LIBCPP_HIDE_FROM_ABI to_chars_result to_chars(char* __first, char* __last, _Int __val_) { return to_chars(__first, __last, __val_, 10); }

template <class _Int>
_CCW_LIBCPP_HIDE_FROM_ABI from_chars_result from_chars(const char* __first, const char* __last, _Int& __val_, int __base) {
    typedef typename make_unsigned<_Int>::type _U;
    const char* __p = __first;
    bool __neg = false;
    if (is_signed<_Int>::value && __p != __last && *__p == '-') { __neg = true; ++__p; }
    _U __acc = 0;
    _U __umax = (numeric_limits<_U>::max)();
    bool __any = false, __over = false;
    const char* __q = __p;
    for (; __q != __last; ++__q) {
        int __dg = __ccw_cc::__dval(*__q);
        if (__dg < 0 || __dg >= __base) break;
        __any = true;
        if (__acc > (__umax - _U(__dg)) / _U(__base)) __over = true;
        else __acc = __acc * _U(__base) + _U(__dg);
    }
    from_chars_result __r;
    if (!__any) { __r.ptr = __first; __r.ec = errc::invalid_argument; return __r; }
    if (!__over) {
        _U __maxpos = _U((numeric_limits<_Int>::max)());
        if (is_signed<_Int>::value && __neg) { if (__acc > __maxpos + _U(1)) __over = true; }
        else                                 { if (__acc > __maxpos)         __over = true; }
    }
    __r.ptr = __q;
    if (__over) __r.ec = errc::result_out_of_range;
    else { __val_ = __neg ? static_cast<_Int>(_U(0) - __acc) : static_cast<_Int>(__acc); __r.ec = errc(); }
    return __r;
}
template <class _Int>
_CCW_LIBCPP_HIDE_FROM_ABI from_chars_result from_chars(const char* __first, const char* __last, _Int& __val_) { return from_chars(__first, __last, __val_, 10); }

_CCW_LIBCPP_HIDE_FROM_ABI inline to_chars_result to_chars(char* __first, char* __last, double __val_) { return __ccw_cc::__shortest(__first, __last, __val_, 17, false); }
_CCW_LIBCPP_HIDE_FROM_ABI inline to_chars_result to_chars(char* __first, char* __last, float __val_)  { return __ccw_cc::__shortest(__first, __last, double(__val_), 9, true); }
_CCW_LIBCPP_HIDE_FROM_ABI inline to_chars_result to_chars(char* __first, char* __last, double __val_, chars_format __fmt) {
    if (__fmt == chars_format(chars_format::general)) return __ccw_cc::__shortest(__first, __last, __val_, 17, false);
    return __ccw_cc::__fp_fmt(__first, __last, __val_, __ccw_cc::__conv_of(__fmt), 0, false);
}
_CCW_LIBCPP_HIDE_FROM_ABI inline to_chars_result to_chars(char* __first, char* __last, double __val_, chars_format __fmt, int __precision) {
