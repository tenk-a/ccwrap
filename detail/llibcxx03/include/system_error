//  ccwrap llibcxx03: <system_error> for Open Watcom -- error_category, error_code,
//  error_condition, the system_error exception and _CCW_STD::errc.
//
//  Open Watcom has no enum class, so errc (and <ios>'s io_errc) follow the ccwrap
//  scoped-enum idiom: a struct wrapping a plain `enum enum_type`, so `errc::io_error`
//  still has to be spelled with the scope and an errc value converts to its
//  enumerator (see detail/system_error.hpp).
#ifndef _CCW_LIBCPP_SYSTEM_ERROR
#define _CCW_LIBCPP_SYSTEM_ERROR
#include "__config"
#include "__functional/hash.h"
#include <cerrno>
#include <cstring>
#include "__fwd/ostream.h"   // NOT <iosfwd>: that reaches <streambuf> -> <ios> -> here
#include <stdexcept>
#include <string>
#include "__exception/eh_anchor.h"
_CCW_LIBCPP_BEGIN_NAMESPACE_STD

