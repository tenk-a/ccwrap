    enum { __m0 = (int)sizeof(_T0) };
    enum { __m1 = __m0 > (int)sizeof(_T1) ? __m0 : (int)sizeof(_T1) };
    enum { __m2 = __m1 > (int)sizeof(_T2) ? __m1 : (int)sizeof(_T2) };
    enum { __m3 = __m2 > (int)sizeof(_T3) ? __m2 : (int)sizeof(_T3) };
    enum { __m4 = __m3 > (int)sizeof(_T4) ? __m3 : (int)sizeof(_T4) };
