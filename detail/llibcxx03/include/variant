#endif
    _CCW_LIBCPP_HIDE_FROM_ABI void* __raw() { return __buf_; }
    _CCW_LIBCPP_HIDE_FROM_ABI const void* __raw() const { return __buf_; }
};

template <class _Tp, class _T0, class _T1, class _T2, class _T3>
_CCW_LIBCPP_HIDE_FROM_ABI int __variant_which() {
    if (is_same<_Tp, _T0>::value) return 0;
    if (is_same<_Tp, _T1>::value) return 1;
    if (is_same<_Tp, _T2>::value) return 2;
    if (is_same<_Tp, _T3>::value) return 3;
    return -1;
}

template <class _Tp, class _T0, class _T1, class _T2, class _T3>
_CCW_LIBCPP_HIDE_FROM_ABI bool holds_alternative(const variant<_T0, _T1, _T2, _T3>& __v) {
    return (int)__v.index() == _CCW_STD::__variant_which<_Tp, _T0, _T1, _T2, _T3>();
}

template <class _Tp, class _T0, class _T1, class _T2, class _T3>
_CCW_LIBCPP_HIDE_FROM_ABI _Tp* get_if(variant<_T0, _T1, _T2, _T3>* __v) {
    if (__v && (int)__v->index() == _CCW_STD::__variant_which<_Tp, _T0, _T1, _T2, _T3>()) return reinterpret_cast<_Tp*>(__v->__raw());
    return 0;
}
template <class _Tp, class _T0, class _T1, class _T2, class _T3>
_CCW_LIBCPP_HIDE_FROM_ABI const _Tp* get_if(const variant<_T0, _T1, _T2, _T3>* __v) {
    if (__v && (int)__v->index() == _CCW_STD::__variant_which<_Tp, _T0, _T1, _T2, _T3>()) return reinterpret_cast<const _Tp*>(const_cast<variant<_T0, _T1, _T2, _T3>*>(__v)->__raw());
    return 0;
}
template <class _Tp, class _T0, class _T1, class _T2, class _T3>
_CCW_LIBCPP_HIDE_FROM_ABI _Tp& get(variant<_T0, _T1, _T2, _T3>& __v) {
    _Tp* __p = get_if<_Tp>(&__v); if (!__p) _CCW_THROW(bad_variant_access()); return *__p;
}
template <class _Tp, class _T0, class _T1, class _T2, class _T3>
_CCW_LIBCPP_HIDE_FROM_ABI const _Tp& get(const variant<_T0, _T1, _T2, _T3>& __v) {
    const _Tp* __p = get_if<_Tp>(&__v); if (!__p) _CCW_THROW(bad_variant_access()); return *__p;
}

template <unsigned _Ip, class _T0, class _T1, class _T2, class _T3>
_CCW_LIBCPP_HIDE_FROM_ABI typename __variant_alt<_Ip, _T0, _T1, _T2, _T3>::type& get(variant<_T0, _T1, _T2, _T3>& __v) {
    typedef typename __variant_alt<_Ip, _T0, _T1, _T2, _T3>::type _Tp;
    _Tp* __p = get_if<_Tp>(&__v); if (!__p) _CCW_THROW(bad_variant_access()); return *__p;
}
template <unsigned _Ip, class _T0, class _T1, class _T2, class _T3>
_CCW_LIBCPP_HIDE_FROM_ABI const typename __variant_alt<_Ip, _T0, _T1, _T2, _T3>::type& get(const variant<_T0, _T1, _T2, _T3>& __v) {
    typedef typename __variant_alt<_Ip, _T0, _T1, _T2, _T3>::type _Tp;
