template <class _T0, class _T1, class _T2, class _T3>
_CCW_LIBCPP_HIDE_FROM_ABI bool operator==(const variant<_T0, _T1, _T2, _T3>& __x, const variant<_T0, _T1, _T2, _T3>& __y) {
    if (__x.index() != __y.index()) return false;
    switch (__x.index()) {
        case 0: return get<0>(__x) == get<0>(__y);
        case 1: return get<1>(__x) == get<1>(__y);
        case 2: return get<2>(__x) == get<2>(__y);
        case 3: return get<3>(__x) == get<3>(__y);
    }
    return true;
}
template <class _T0, class _T1, class _T2, class _T3>
_CCW_LIBCPP_HIDE_FROM_ABI bool operator<(const variant<_T0, _T1, _T2, _T3>& __x, const variant<_T0, _T1, _T2, _T3>& __y) {
    if (__x.index() != __y.index()) return __x.index() < __y.index();
    switch (__x.index()) {
        case 0: return get<0>(__x) < get<0>(__y);
        case 1: return get<1>(__x) < get<1>(__y);
        case 2: return get<2>(__x) < get<2>(__y);
        case 3: return get<3>(__x) < get<3>(__y);
    }
    return false;
}
template <class _T0, class _T1, class _T2, class _T3> _CCW_LIBCPP_HIDE_FROM_ABI bool operator!=(const variant<_T0, _T1, _T2, _T3>& __x, const variant<_T0, _T1, _T2, _T3>& __y) { return !(__x == __y); }
template <class _T0, class _T1, class _T2, class _T3> _CCW_LIBCPP_HIDE_FROM_ABI bool operator>(const variant<_T0, _T1, _T2, _T3>& __x, const variant<_T0, _T1, _T2, _T3>& __y)  { return __y < __x; }
template <class _T0, class _T1, class _T2, class _T3> _CCW_LIBCPP_HIDE_FROM_ABI bool operator<=(const variant<_T0, _T1, _T2, _T3>& __x, const variant<_T0, _T1, _T2, _T3>& __y) { return !(__y < __x); }
template <class _T0, class _T1, class _T2, class _T3> _CCW_LIBCPP_HIDE_FROM_ABI bool operator>=(const variant<_T0, _T1, _T2, _T3>& __x, const variant<_T0, _T1, _T2, _T3>& __y) { return !(__x < __y); }

