class _CCW_LIBCPP_TEMPLATE_VIS bad_variant_access : public exception {
public:
    _CCW_LIBCPP_HIDE_FROM_ABI bad_variant_access() _CCW_LIBCPP_NOEXCEPT {}
    _CCW_LIBCPP_HIDE_FROM_ABI virtual ~bad_variant_access() _CCW_LIBCPP_NOEXCEPT {}
    _CCW_LIBCPP_HIDE_FROM_ABI virtual const char* what() const _CCW_LIBCPP_NOEXCEPT { return "bad_variant_access"; }
};

struct _CCW_LIBCPP_TEMPLATE_VIS monostate {};
_CCW_LIBCPP_HIDE_FROM_ABI inline bool operator==(monostate, monostate) { return true; }
_CCW_LIBCPP_HIDE_FROM_ABI inline bool operator!=(monostate, monostate) { return false; }
_CCW_LIBCPP_HIDE_FROM_ABI inline bool operator< (monostate, monostate) { return false; }
_CCW_LIBCPP_HIDE_FROM_ABI inline bool operator> (monostate, monostate) { return false; }
_CCW_LIBCPP_HIDE_FROM_ABI inline bool operator<=(monostate, monostate) { return true; }
_CCW_LIBCPP_HIDE_FROM_ABI inline bool operator>=(monostate, monostate) { return true; }

struct __variant_nil1 { };
struct __variant_nil2 { };
struct __variant_nil3 { };
#define _CCW_VARIANT_NIL_CMP(_N) \
    _CCW_LIBCPP_HIDE_FROM_ABI inline bool operator==(__variant_nil##_N, __variant_nil##_N) { return true; } \
    _CCW_LIBCPP_HIDE_FROM_ABI inline bool operator<(__variant_nil##_N, __variant_nil##_N)  { return false; }
_CCW_VARIANT_NIL_CMP(1) _CCW_VARIANT_NIL_CMP(2) _CCW_VARIANT_NIL_CMP(3)
#undef _CCW_VARIANT_NIL_CMP

template <unsigned long _A, unsigned long _B> struct __variant_umax { enum { value = _A > _B ? _A : _B }; };

template <unsigned _Ip, class _T0, class _T1, class _T2, class _T3> struct __variant_alt {
    typedef typename conditional<_Ip == 2, _T2, _T3>::type    __a23;
    typedef typename conditional<_Ip == 1, _T1, __a23>::type  __a123;
    typedef typename conditional<_Ip == 0, _T0, __a123>::type type;
};

template <class _T0, class _T1 = __variant_nil1, class _T2 = __variant_nil2, class _T3 = __variant_nil3>
class _CCW_LIBCPP_TEMPLATE_VIS variant {
    enum { __sz = __variant_umax<sizeof(_T0),
                    __variant_umax<sizeof(_T1),
                      __variant_umax<sizeof(_T2), sizeof(_T3)>::value>::value>::value };
    union {
        char        __buf_[__sz];
        long double __align_ld_;
        void*       __align_p_;
        long        __align_l_;
    };
    int __index_;

    _CCW_LIBCPP_HIDE_FROM_ABI _T0* __as0() { return reinterpret_cast<_T0*>(__buf_); }
    _CCW_LIBCPP_HIDE_FROM_ABI _T1* __as1() { return reinterpret_cast<_T1*>(__buf_); }
    _CCW_LIBCPP_HIDE_FROM_ABI _T2* __as2() { return reinterpret_cast<_T2*>(__buf_); }
    _CCW_LIBCPP_HIDE_FROM_ABI _T3* __as3() { return reinterpret_cast<_T3*>(__buf_); }

    _CCW_LIBCPP_HIDE_FROM_ABI void __destroy() {
        switch (__index_) {
            case 0: __as0()->~_T0(); break;
            case 1: __as1()->~_T1(); break;
            case 2: __as2()->~_T2(); break;
            case 3: __as3()->~_T3(); break;
        }
        __index_ = -1;
    }
    _CCW_LIBCPP_HIDE_FROM_ABI void __copy_from(const variant& __o) {
        switch (__o.__index_) {
            case 0: ::new (static_cast<void*>(__buf_)) _T0(*const_cast<variant&>(__o).__as0()); break;
            case 1: ::new (static_cast<void*>(__buf_)) _T1(*const_cast<variant&>(__o).__as1()); break;
            case 2: ::new (static_cast<void*>(__buf_)) _T2(*const_cast<variant&>(__o).__as2()); break;
            case 3: ::new (static_cast<void*>(__buf_)) _T3(*const_cast<variant&>(__o).__as3()); break;
        }
        __index_ = __o.__index_;
    }
    _CCW_LIBCPP_HIDE_FROM_ABI void __move_from(variant& __o) {
        switch (__o.__index_) {
            case 0: ::new (static_cast<void*>(__buf_)) _T0(::_ccw::move(*__o.__as0())); break;
            case 1: ::new (static_cast<void*>(__buf_)) _T1(::_ccw::move(*__o.__as1())); break;
            case 2: ::new (static_cast<void*>(__buf_)) _T2(::_ccw::move(*__o.__as2())); break;
            case 3: ::new (static_cast<void*>(__buf_)) _T3(::_ccw::move(*__o.__as3())); break;
        }
        __index_ = __o.__index_;
    }
public:
    _CCW_LIBCPP_HIDE_FROM_ABI variant() { _T0 __z = _T0(); ::new (static_cast<void*>(__buf_)) _T0(__z); __index_ = 0; }   // value-init first alternative (Open Watcom does not zero a placement-new `_T0()`)
    _CCW_LIBCPP_HIDE_FROM_ABI variant(const variant& __o) { __copy_from(__o); }
    _CCW_LIBCPP_HIDE_FROM_ABI variant(const _T0& __v) { ::new (static_cast<void*>(__buf_)) _T0(__v); __index_ = 0; }
    _CCW_LIBCPP_HIDE_FROM_ABI variant(const _T1& __v) { ::new (static_cast<void*>(__buf_)) _T1(__v); __index_ = 1; }
    _CCW_LIBCPP_HIDE_FROM_ABI variant(const _T2& __v) { ::new (static_cast<void*>(__buf_)) _T2(__v); __index_ = 2; }
    _CCW_LIBCPP_HIDE_FROM_ABI variant(const _T3& __v) { ::new (static_cast<void*>(__buf_)) _T3(__v); __index_ = 3; }

    template <_CCW_STD::size_t _Ip>
    _CCW_LIBCPP_HIDE_FROM_ABI explicit variant(in_place_index_t<_Ip>) {
        typedef typename __variant_alt<(unsigned)_Ip, _T0, _T1, _T2, _T3>::type _Vt;
        _Vt __z = _Vt(); ::new (static_cast<void*>(__buf_)) _Vt(__z); __index_ = (int)_Ip; }
    template <_CCW_STD::size_t _Ip, class _A0>
    _CCW_LIBCPP_HIDE_FROM_ABI variant(in_place_index_t<_Ip>, _A0 __a0) {
        typedef typename __variant_alt<(unsigned)_Ip, _T0, _T1, _T2, _T3>::type _Vt;
        ::new (static_cast<void*>(__buf_)) _Vt(__a0); __index_ = (int)_Ip; }
    template <_CCW_STD::size_t _Ip, class _A0, class _A1>
    _CCW_LIBCPP_HIDE_FROM_ABI variant(in_place_index_t<_Ip>, _A0 __a0, _A1 __a1) {
        typedef typename __variant_alt<(unsigned)_Ip, _T0, _T1, _T2, _T3>::type _Vt;
        ::new (static_cast<void*>(__buf_)) _Vt(__a0, __a1); __index_ = (int)_Ip; }
    template <class _Tp>
    _CCW_LIBCPP_HIDE_FROM_ABI explicit variant(in_place_type_t<_Tp>) {
        _Tp __z = _Tp(); ::new (static_cast<void*>(__buf_)) _Tp(__z); __index_ = __which<_Tp>(); }
    template <class _Tp, class _A0>
    _CCW_LIBCPP_HIDE_FROM_ABI variant(in_place_type_t<_Tp>, _A0 __a0) {
        ::new (static_cast<void*>(__buf_)) _Tp(__a0); __index_ = __which<_Tp>(); }
    template <class _Tp, class _A0, class _A1>
    _CCW_LIBCPP_HIDE_FROM_ABI variant(in_place_type_t<_Tp>, _A0 __a0, _A1 __a1) {
        ::new (static_cast<void*>(__buf_)) _Tp(__a0, __a1); __index_ = __which<_Tp>(); }
#if _CCW_HAS_INIT_LIST
    template <_CCW_STD::size_t _Ip, class _Up>
    _CCW_LIBCPP_HIDE_FROM_ABI variant(in_place_index_t<_Ip>, _CCW_STD::initializer_list<_Up> __il) {
        typedef typename __variant_alt<(unsigned)_Ip, _T0, _T1, _T2, _T3>::type _Vt;
        ::new (static_cast<void*>(__buf_)) _Vt(__il); __index_ = (int)_Ip; }
    template <_CCW_STD::size_t _Ip, class _Up, class _A0>
    _CCW_LIBCPP_HIDE_FROM_ABI variant(in_place_index_t<_Ip>, _CCW_STD::initializer_list<_Up> __il, _A0 __a0) {
        typedef typename __variant_alt<(unsigned)_Ip, _T0, _T1, _T2, _T3>::type _Vt;
        ::new (static_cast<void*>(__buf_)) _Vt(__il, __a0); __index_ = (int)_Ip; }
    template <class _Tp, class _Up>
    _CCW_LIBCPP_HIDE_FROM_ABI variant(in_place_type_t<_Tp>, _CCW_STD::initializer_list<_Up> __il) {
        ::new (static_cast<void*>(__buf_)) _Tp(__il); __index_ = __which<_Tp>(); }
    template <class _Tp, class _Up, class _A0>
    _CCW_LIBCPP_HIDE_FROM_ABI variant(in_place_type_t<_Tp>, _CCW_STD::initializer_list<_Up> __il, _A0 __a0) {
        ::new (static_cast<void*>(__buf_)) _Tp(__il, __a0); __index_ = __which<_Tp>(); }
#endif
    _CCW_LIBCPP_HIDE_FROM_ABI ~variant() { __destroy(); }

    _CCW_LIBCPP_HIDE_FROM_ABI variant& operator=(const variant& __o) {
        if (this != &__o) { __destroy(); __copy_from(__o); }
        return *this;
    }
    _CCW_LIBCPP_HIDE_FROM_ABI variant(_CCW_RV_REF(variant) __r) { __move_from(_CCW_MOVED_OBJ(__r)); }
    _CCW_LIBCPP_HIDE_FROM_ABI variant& operator=(_CCW_RV_REF(variant) __r) {
        variant& __o = _CCW_MOVED_OBJ(__r);
        if (this != &__o) { __destroy(); __move_from(__o); }
        return *this;
    }
    _CCW_LIBCPP_HIDE_FROM_ABI variant& operator=(const _T0& __v) { __destroy(); ::new (static_cast<void*>(__buf_)) _T0(__v); __index_ = 0; return *this; }
    _CCW_LIBCPP_HIDE_FROM_ABI variant& operator=(const _T1& __v) { __destroy(); ::new (static_cast<void*>(__buf_)) _T1(__v); __index_ = 1; return *this; }
    _CCW_LIBCPP_HIDE_FROM_ABI variant& operator=(const _T2& __v) { __destroy(); ::new (static_cast<void*>(__buf_)) _T2(__v); __index_ = 2; return *this; }
    _CCW_LIBCPP_HIDE_FROM_ABI variant& operator=(const _T3& __v) { __destroy(); ::new (static_cast<void*>(__buf_)) _T3(__v); __index_ = 3; return *this; }

    _CCW_LIBCPP_HIDE_FROM_ABI _CCW_STD::size_t index() const {
        return __index_ < 0 ? (_CCW_STD::size_t)-1 : (_CCW_STD::size_t)__index_; }
    _CCW_LIBCPP_HIDE_FROM_ABI bool valueless_by_exception() const { return __index_ < 0; }
    _CCW_LIBCPP_HIDE_FROM_ABI void swap(variant& __o) { variant __t(*this); *this = __o; __o = __t; }

    template <class _Tp> _CCW_LIBCPP_HIDE_FROM_ABI int __which() const {
        return is_same<_Tp, _T0>::value ? 0 : is_same<_Tp, _T1>::value ? 1 : is_same<_Tp, _T2>::value ? 2 : is_same<_Tp, _T3>::value ? 3 : -1; }
    template <class _Tp> _CCW_LIBCPP_HIDE_FROM_ABI _Tp& emplace() {
        __destroy(); ::new (static_cast<void*>(__buf_)) _Tp(); __index_ = __which<_Tp>(); return *reinterpret_cast<_Tp*>(__buf_); }
    template <class _Tp, class _A0> _CCW_LIBCPP_HIDE_FROM_ABI _Tp& emplace(_A0 __a0) {
        __destroy(); ::new (static_cast<void*>(__buf_)) _Tp(__a0); __index_ = __which<_Tp>(); return *reinterpret_cast<_Tp*>(__buf_); }
    template <class _Tp, class _A0, class _A1> _CCW_LIBCPP_HIDE_FROM_ABI _Tp& emplace(_A0 __a0, _A1 __a1) {
        __destroy(); ::new (static_cast<void*>(__buf_)) _Tp(__a0, __a1); __index_ = __which<_Tp>(); return *reinterpret_cast<_Tp*>(__buf_); }
    template <class _Tp, class _A0, class _A1, class _A2> _CCW_LIBCPP_HIDE_FROM_ABI _Tp& emplace(_A0 __a0, _A1 __a1, _A2 __a2) {
        __destroy(); ::new (static_cast<void*>(__buf_)) _Tp(__a0, __a1, __a2); __index_ = __which<_Tp>(); return *reinterpret_cast<_Tp*>(__buf_); }

#if !defined(__WATCOMC__)
