template <class _Tp, _CCW_VARIANT_TPL>
_CCW_LIBCPP_HIDE_FROM_ABI int __variant_which() {
    if (is_same<_Tp, _T0>::value) return 0;
    if (is_same<_Tp, _T1>::value) return 1;
    if (is_same<_Tp, _T2>::value) return 2;
    if (is_same<_Tp, _T3>::value) return 3;
    if (is_same<_Tp, _T4>::value) return 4;
    if (is_same<_Tp, _T5>::value) return 5;
    if (is_same<_Tp, _T6>::value) return 6;
    if (is_same<_Tp, _T7>::value) return 7;
    if (is_same<_Tp, _T8>::value) return 8;
    if (is_same<_Tp, _T9>::value) return 9;
    return -1;
}

template <class _Tp, _CCW_VARIANT_TPL>
_CCW_LIBCPP_HIDE_FROM_ABI bool holds_alternative(const variant<_CCW_VARIANT_T>& __v) {
    return (int)__v.index() == _CCW_STD::__variant_which<_Tp, _CCW_VARIANT_T>();
}

template <class _Tp, _CCW_VARIANT_TPL>
_CCW_LIBCPP_HIDE_FROM_ABI _Tp* get_if(variant<_CCW_VARIANT_T>* __v) {
    if (__v && (int)__v->index() == _CCW_STD::__variant_which<_Tp, _CCW_VARIANT_T>()) return reinterpret_cast<_Tp*>(__v->__raw());
    return 0;
}
template <class _Tp, _CCW_VARIANT_TPL>
