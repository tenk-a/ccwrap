    return 0;
}
template <class _Tp, _CCW_VARIANT_TPL>
_CCW_LIBCPP_HIDE_FROM_ABI _Tp& get(variant<_CCW_VARIANT_T>& __v) {
    _Tp* __p = get_if<_Tp>(&__v); if (!__p) _CCW_THROW(bad_variant_access()); return *__p;
