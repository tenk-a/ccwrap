#define _CCW_VARIANT_AS(_N) \
    _CCW_LIBCPP_HIDE_FROM_ABI _T##_N* __as##_N() { return reinterpret_cast<_T##_N*>(__buf_); }
#define _CCW_VARIANT_DTOR(_N)   case _N: __as##_N()->~_T##_N(); break;
#define _CCW_VARIANT_COPY(_N)   case _N: ::new (static_cast<void*>(__buf_)) _T##_N(*const_cast<variant&>(__o).__as##_N()); break;
#define _CCW_VARIANT_MOVE(_N)   case _N: ::new (static_cast<void*>(__buf_)) _T##_N(::_ccw::move(*__o.__as##_N())); break;
#define _CCW_VARIANT_CTOR(_N) \
    _CCW_LIBCPP_HIDE_FROM_ABI variant(const _T##_N& __v) { ::new (static_cast<void*>(__buf_)) _T##_N(__v); __index_ = _N; }
#define _CCW_VARIANT_ASSIGN(_N) \
    _CCW_LIBCPP_HIDE_FROM_ABI variant& operator=(const _T##_N& __v) { __destroy(); ::new (static_cast<void*>(__buf_)) _T##_N(__v); __index_ = _N; return *this; }

