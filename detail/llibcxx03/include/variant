    _CCW_LIBCPP_HIDE_FROM_ABI typename __variant_alt<(unsigned)_Ip, _T0, _T1, _T2, _T3>::type& emplace() {
        typedef typename __variant_alt<(unsigned)_Ip, _T0, _T1, _T2, _T3>::type _Vt;
        __destroy(); _Vt __z = _Vt(); ::new (static_cast<void*>(__buf_)) _Vt(__z); __index_ = (int)_Ip; return *reinterpret_cast<_Vt*>(__buf_); }
