static const _CCW_STD::size_t variant_npos = (_CCW_STD::size_t)-1;

template <class _Vp> struct variant_size;
template <class _T0, class _T1, class _T2, class _T3> struct variant_size<variant<_T0, _T1, _T2, _T3> > {
    enum { value = 1 + (is_same<_T1, __variant_nil1>::value ? 0 : 1)
                     + (is_same<_T2, __variant_nil2>::value ? 0 : 1)
                     + (is_same<_T3, __variant_nil3>::value ? 0 : 1) };
};

template <class _Vp> struct variant_size<const _Vp>          { enum { value = variant_size<_Vp>::value }; };
template <class _Vp> struct variant_size<volatile _Vp>       { enum { value = variant_size<_Vp>::value }; };
template <class _Vp> struct variant_size<const volatile _Vp> { enum { value = variant_size<_Vp>::value }; };

template <unsigned _Ip, class _Vp> struct variant_alternative;
template <unsigned _Ip, class _T0, class _T1, class _T2, class _T3> struct variant_alternative<_Ip, variant<_T0, _T1, _T2, _T3> > {
    typedef typename __variant_alt<_Ip, _T0, _T1, _T2, _T3>::type type;
};
template <unsigned _Ip, class _Vp> struct variant_alternative<_Ip, const _Vp> {
    typedef const typename variant_alternative<_Ip, _Vp>::type type;
};
