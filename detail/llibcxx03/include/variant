    typedef typename conditional<_Ip == 6, _T6, __a7>::type  __a6;
    typedef typename conditional<_Ip == 5, _T5, __a6>::type  __a5;
    typedef typename conditional<_Ip == 4, _T4, __a5>::type  __a4;
    typedef typename conditional<_Ip == 3, _T3, __a4>::type  __a3;
    typedef typename conditional<_Ip == 2, _T2, __a3>::type  __a2;
    typedef typename conditional<_Ip == 1, _T1, __a2>::type  __a1;
    typedef typename conditional<_Ip == 0, _T0, __a1>::type  type;
