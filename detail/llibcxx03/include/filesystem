_CCW_LIBCPP_HIDE_FROM_ABI inline ::_CCW_STD::size_t hash_value(const path& __p) {
    const path::string_type __t = __p.__generic_native();
    ::_CCW_STD::size_t __h = 2166136261u;
    for (::_CCW_STD::size_t __i = 0; __i < __t.size(); ++__i) {
        unsigned long __c = (unsigned long)__t[__i];
        __h ^= (::_CCW_STD::size_t)(__c & 0xFFUL);
        __h *= 16777619u;
        if (__c > 0xFFUL) { __h ^= (::_CCW_STD::size_t)((__c >> 8) & 0xFFUL); __h *= 16777619u; }
    }
    return __h;
}

