class path {
public:
    typedef __ccw_fs_char_t   value_type;
    typedef __ccw_fs_string_t string_type;
    static const value_type preferred_separator = __CCW_FS_L('\\');
    struct format { enum _E { native_format, generic_format, auto_format }; };

private:
    string_type __s_;
    _CCW_LIBCPP_HIDE_FROM_ABI static bool __is_sep(value_type __c) {
        return __c == __CCW_FS_L('/') || __c == __CCW_FS_L('\\');
    }
    _CCW_LIBCPP_HIDE_FROM_ABI ::_CCW_STD::size_t __last_sep() const {
        for (::_CCW_STD::size_t __i = __s_.size(); __i > 0; --__i) if (__is_sep(__s_[__i - 1])) return __i - 1;
        return string_type::npos;
    }
public:

    _CCW_LIBCPP_HIDE_FROM_ABI path() {}
    _CCW_LIBCPP_HIDE_FROM_ABI path(const ::_CCW_STD::string& __s)  : __s_(__ccw_fs_from_narrow(__s)) {}
    _CCW_LIBCPP_HIDE_FROM_ABI path(const ::_CCW_STD::wstring& __s) : __s_(__ccw_fs_from_wide(__s)) {}
    _CCW_LIBCPP_HIDE_FROM_ABI path(const char* __s)    : __s_(__ccw_fs_from_narrow(::_CCW_STD::string(__s))) {}
    _CCW_LIBCPP_HIDE_FROM_ABI path(const wchar_t* __s) : __s_(__ccw_fs_from_wide(::_CCW_STD::wstring(__s))) {}
#if (_CCW_TARGET_CXX) >= 2020 && (defined(__cpp_char8_t) || defined(__CCW_HAS_CHAR8_T))
    _CCW_LIBCPP_HIDE_FROM_ABI path(const ::_CCW_STD::u8string& __s)
        : __s_(__ccw_fs_from_narrow(::_CCW_STD::string(__s.begin(), __s.end()))) {}
    _CCW_LIBCPP_HIDE_FROM_ABI path(const char8_t* __s) {
        ::_CCW_STD::string __t;
        for (const char8_t* __p = __s; *__p; ++__p) __t += (char)*__p;
        __s_ = __ccw_fs_from_narrow(__t);
    }
#endif
#if !_CCW_HAS_REAL_RVALUE_REF
    _CCW_LIBCPP_HIDE_FROM_ABI path(_CCW_RV_REF(path) __r) : __s_(::_ccw::move(_CCW_MOVED_OBJ(__r).__s_)) {}
    _CCW_LIBCPP_HIDE_FROM_ABI path& operator=(_CCW_RV_REF(path) __r) {
        path& __o = _CCW_MOVED_OBJ(__r);
        if (this != &__o) __s_ = ::_ccw::move(__o.__s_);
        return *this;
    }
    _CCW_LIBCPP_HIDE_FROM_ABI path(_CCW_RV_REF(string_type) __s, format::_E = format::auto_format) : __s_(::_ccw::move(__s)) {}
    _CCW_LIBCPP_HIDE_FROM_ABI path& operator=(_CCW_RV_REF(string_type) __s) { __s_ = ::_ccw::move(_CCW_MOVED_OBJ(__s)); return *this; }
#endif

    _CCW_LIBCPP_HIDE_FROM_ABI const string_type& native() const { return __s_; }
    _CCW_LIBCPP_HIDE_FROM_ABI const value_type*  c_str() const { return __s_.c_str(); }
    _CCW_LIBCPP_HIDE_FROM_ABI bool               empty() const { return __s_.empty(); }
    _CCW_LIBCPP_HIDE_FROM_ABI void               clear() { __s_.clear(); }
    _CCW_LIBCPP_HIDE_FROM_ABI ::_CCW_STD::string  string() const  { return __ccw_fs_to_narrow(__s_); }
    _CCW_LIBCPP_HIDE_FROM_ABI ::_CCW_STD::wstring wstring() const { return __ccw_fs_to_wide(__s_); }

    _CCW_LIBCPP_HIDE_FROM_ABI string_type __generic_native() const {
        string_type __r = __s_;
        for (::_CCW_STD::size_t __i = 0; __i < __r.size(); ++__i)
            if (__r[__i] == __CCW_FS_L('\\')) __r[__i] = __CCW_FS_L('/');
