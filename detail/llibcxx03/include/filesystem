    _CCW_LIBCPP_HIDE_FROM_ABI path& concat(const path& __p) { return operator+=(__p); }
    _CCW_LIBCPP_HIDE_FROM_ABI void  swap(path& __o) { __s_.swap(__o.__s_); }

    _CCW_LIBCPP_HIDE_FROM_ABI path filename() const {
        ::_CCW_STD::size_t __p = __last_sep();
        return path(__p == string_type::npos ? __s_ : __s_.substr(__p + 1));
    }
    _CCW_LIBCPP_HIDE_FROM_ABI path parent_path() const {
        ::_CCW_STD::size_t __p = __last_sep();
        return path(__p == string_type::npos ? string_type() : __s_.substr(0, __p));
    }
    _CCW_LIBCPP_HIDE_FROM_ABI path extension() const {
        string_type __fn = filename().__s_;
        for (::_CCW_STD::size_t __i = __fn.size(); __i > 0; --__i) {
            if (__fn[__i - 1] == __CCW_FS_L('.')) return (__i - 1 == 0) ? path() : path(__fn.substr(__i - 1));
        }
        return path();
    }
    _CCW_LIBCPP_HIDE_FROM_ABI path stem() const {
        string_type __fn = filename().__s_;
        string_type __ext = extension().__s_;
        return path(__ext.empty() ? __fn : __fn.substr(0, __fn.size() - __ext.size()));
    }
    _CCW_LIBCPP_HIDE_FROM_ABI path root_name() const {
        return (__s_.size() >= 2 && __s_[1] == __CCW_FS_L(':')) ? path(__s_.substr(0, 2)) : path();
    }
    _CCW_LIBCPP_HIDE_FROM_ABI path root_directory() const {
        ::_CCW_STD::size_t __rn = (__s_.size() >= 2 && __s_[1] == __CCW_FS_L(':')) ? 2 : 0;
        if (__rn < __s_.size() && __is_sep(__s_[__rn])) return path(string_type(1, __s_[__rn]));
        return path();
    }
    _CCW_LIBCPP_HIDE_FROM_ABI path root_path() const { return path(root_name().__s_ + root_directory().__s_); }
    _CCW_LIBCPP_HIDE_FROM_ABI path relative_path() const {
        ::_CCW_STD::size_t __rp = root_path().__s_.size();
        return path(__rp < __s_.size() ? __s_.substr(__rp) : string_type());
    }

    _CCW_LIBCPP_HIDE_FROM_ABI bool has_extension() const { return !extension().empty(); }
    _CCW_LIBCPP_HIDE_FROM_ABI bool has_filename() const  { return !filename().empty(); }
    _CCW_LIBCPP_HIDE_FROM_ABI bool has_parent_path() const { return __last_sep() != string_type::npos; }
    _CCW_LIBCPP_HIDE_FROM_ABI bool has_stem() const { return !stem().empty(); }
    _CCW_LIBCPP_HIDE_FROM_ABI bool has_root_name() const { return !root_name().empty(); }
    _CCW_LIBCPP_HIDE_FROM_ABI bool has_root_directory() const { return !root_directory().empty(); }
    _CCW_LIBCPP_HIDE_FROM_ABI bool has_root_path() const { return !root_path().empty(); }
    _CCW_LIBCPP_HIDE_FROM_ABI bool has_relative_path() const { return !relative_path().empty(); }
    _CCW_LIBCPP_HIDE_FROM_ABI bool is_absolute() const {
        return (__s_.size() >= 2 && __s_[1] == __CCW_FS_L(':')) || (!__s_.empty() && __is_sep(__s_[0]));
    }
    _CCW_LIBCPP_HIDE_FROM_ABI bool is_relative() const { return !is_absolute(); }

    _CCW_LIBCPP_HIDE_FROM_ABI path& make_preferred() {
        for (::_CCW_STD::size_t __i = 0; __i < __s_.size(); ++__i)
            if (__s_[__i] == __CCW_FS_L('/')) __s_[__i] = preferred_separator;
        return *this;
    }
    _CCW_LIBCPP_HIDE_FROM_ABI path& remove_filename() {
        ::_CCW_STD::size_t __p = __last_sep();
        if (__p == string_type::npos) __s_.clear(); else __s_.erase(__p + 1);
        return *this;
    }
    _CCW_LIBCPP_HIDE_FROM_ABI path& replace_filename(const path& __r) { remove_filename(); return operator/=(__r); }
    _CCW_LIBCPP_HIDE_FROM_ABI path& replace_extension(const path& __e = path()) {
        string_type __ext = extension().__s_;
        if (!__ext.empty()) __s_.erase(__s_.size() - __ext.size());
        if (!__e.__s_.empty()) {
            if (__e.__s_[0] != __CCW_FS_L('.')) __s_.push_back(__CCW_FS_L('.'));
            __s_ += __e.__s_;
        }
        return *this;
    }

    _CCW_LIBCPP_HIDE_FROM_ABI path lexically_normal() const {
        if (__s_.empty()) return path();
        string_type __root = root_path().__s_;
        string_type __rel  = relative_path().__s_;
        ::_CCW_STD::vector<string_type> __out_;
        string_type __cur;
        const string_type __dot(1, __CCW_FS_L('.'));
        const string_type __dotdot(2, __CCW_FS_L('.'));
        bool __trailing_sep = false;
        for (::_CCW_STD::size_t __i = 0; __i <= __rel.size(); ++__i) {
            if (__i == __rel.size() || __is_sep(__rel[__i])) {
                if (__cur == __dot) { /* drop */ }
                else if (__cur == __dotdot) {
                    if (!__out_.empty() && __out_.back() != __dotdot) __out_.pop_back();
                    else if (__root.empty()) __out_.push_back(__dotdot);   // keep for a relative path
                }
                else if (!__cur.empty()) __out_.push_back(__cur);
                __trailing_sep = (__i < __rel.size());
                __cur.clear();
            } else __cur.push_back(__rel[__i]);
        }
        string_type __r = __root;
        for (::_CCW_STD::size_t __i = 0; __i < __out_.size(); ++__i) {
            if (__i) __r.push_back(preferred_separator);
            __r += __out_[__i];
        }
        if (__r.empty()) return path(__dot);                        // normal form of an empty result
        if (__trailing_sep && !__out_.empty()) { __r.push_back(preferred_separator); __r.push_back(__CCW_FS_L('.')); }
        return path(__r);
    }

    _CCW_LIBCPP_HIDE_FROM_ABI int compare(const path& __o) const {
        return __generic_native().compare(__o.__generic_native());
    }

    _CCW_LIBCPP_HIDE_FROM_ABI bool operator==(const path& __o) const { return compare(__o) == 0; }
    _CCW_LIBCPP_HIDE_FROM_ABI bool operator!=(const path& __o) const { return compare(__o) != 0; }
    _CCW_LIBCPP_HIDE_FROM_ABI bool operator<(const path& __o) const  { return compare(__o) <  0; }
    _CCW_LIBCPP_HIDE_FROM_ABI bool operator>(const path& __o) const  { return compare(__o) >  0; }
    _CCW_LIBCPP_HIDE_FROM_ABI bool operator<=(const path& __o) const { return compare(__o) <= 0; }
    _CCW_LIBCPP_HIDE_FROM_ABI bool operator>=(const path& __o) const { return compare(__o) >= 0; }

    _CCW_LIBCPP_HIDE_FROM_ABI path lexically_relative(const path& __base) const {
        if (root_name() != __base.root_name()) return path();
        if (is_absolute() != __base.is_absolute()) return path();
        if (!has_root_directory() && __base.has_root_directory()) return path();

        ::_CCW_STD::vector<string_type> __a = __split_elems();
        ::_CCW_STD::vector<string_type> __b = __base.__split_elems();
        const string_type __dot(1, __CCW_FS_L('.'));
        const string_type __dotdot(2, __CCW_FS_L('.'));
        ::_CCW_STD::size_t __i = 0;
        while (__i < __a.size() && __i < __b.size() && __a[__i] == __b[__i]) ++__i;

        if (__i == __a.size() && __i == __b.size()) return path(__dot);

        ::_CCW_STD::size_t __up = 0;
        for (::_CCW_STD::size_t __k = __i; __k < __b.size(); ++__k) {
            if (__b[__k] == __dotdot) { if (__up == 0) return path(); --__up; }
            else if (__b[__k] != __dot) ++__up;
        }
        if (__up == 0 && __i == __a.size()) return path(__dot);

        path __r;
        for (::_CCW_STD::size_t __k = 0; __k < __up; ++__k) __r /= path(__dotdot);
        for (::_CCW_STD::size_t __k = __i; __k < __a.size(); ++__k) __r /= path(__a[__k]);
        return __r;
    }
    _CCW_LIBCPP_HIDE_FROM_ABI path lexically_proximate(const path& __base) const {
        path __r = lexically_relative(__base);
        return __r.empty() ? *this : __r;
    }

