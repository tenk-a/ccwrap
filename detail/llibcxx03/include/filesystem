        if (!__s_.empty() && !__is_sep(__s_[__s_.size() - 1]) && !__p.__s_.empty()) __s_.push_back(preferred_separator);
        __s_ += __p.__s_;
        return *this;
    }
    _CCW_LIBCPP_HIDE_FROM_ABI path& operator+=(const path& __p) { __s_ += __p.__s_; return *this; }
    _CCW_LIBCPP_HIDE_FROM_ABI path& operator+=(const ::_CCW_STD::string& __s)  { __s_ += __ccw_fs_from_narrow(__s); return *this; }
    _CCW_LIBCPP_HIDE_FROM_ABI path& operator+=(const ::_CCW_STD::wstring& __s) { __s_ += __ccw_fs_from_wide(__s); return *this; }
    _CCW_LIBCPP_HIDE_FROM_ABI path& operator+=(const char* __s)    { return operator+=(::_CCW_STD::string(__s)); }
    _CCW_LIBCPP_HIDE_FROM_ABI path& operator+=(const wchar_t* __s) { return operator+=(::_CCW_STD::wstring(__s)); }
