    template <class _FwdIt>
    _CCW_LIBCPP_HIDE_FROM_ABI string_type transform(_FwdIt __f, _FwdIt __l) const {
        return string_type(__f, __l);           // "C" locale: the identity
    }
    template <class _FwdIt>
    _CCW_LIBCPP_HIDE_FROM_ABI string_type transform_primary(_FwdIt __f, _FwdIt __l) const {
        string_type __s(__f, __l);              // primary = case-insensitive here
        for (size_type __i = 0; __i < __s.size(); ++__i) __s[__i] = translate_nocase(__s[__i]);
        return __s;
    }
    template <class _FwdIt>
    _CCW_LIBCPP_HIDE_FROM_ABI string_type lookup_collatename(_FwdIt __f, _FwdIt __l) const {
        string_type __s(__f, __l);
        return __s.size() == 1 ? __s : string_type();   // only [.x.] with one character
    }
    template <class _FwdIt>
    _CCW_LIBCPP_HIDE_FROM_ABI char_class_type lookup_classname(_FwdIt __f, _FwdIt __l, bool __icase = false) const {
        string_type __s(__f, __l);
