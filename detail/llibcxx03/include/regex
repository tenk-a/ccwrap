template <class _CharT>
struct __re_class {
    bool        __negate;
    _CCW_STD::basic_string<_CharT> __chars;
    _CCW_STD::basic_string<_CharT> __lo, __hi;
    int         __shorthand;   // 1 d,2 w,4 s,8 D,16 W,32 S
    int         __posix;       // OR of the traits' char_class_type bits, from [:name:]
    _CCW_LIBCPP_HIDE_FROM_ABI __re_class() : __negate(false), __shorthand(0), __posix(0) {}
};
template <class _CharT>
struct __re_node {
    int              __type;   // 0 char,1 any,2 class,3 bol,4 eol,5 concat,6 alt,7 repeat,8 group
    _CharT           __c;
    int              __cls;
    int              __rmin, __rmax;   // repeat; max<0 = unbounded
    int              __group;
    _CCW_STD::vector<int> __kids;
    _CCW_LIBCPP_HIDE_FROM_ABI __re_node() : __type(0), __c(0), __cls(-1), __rmin(0), __rmax(0), __group(0) {}
};

template <class _CharT, class _Traits = regex_traits<_CharT> >
class basic_regex {
public:
    typedef _CharT value_type;
    typedef regex_constants::syntax_option_type flag_type;
private:
