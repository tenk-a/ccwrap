        if ((__f & __alpha)  && __is_alpha) return true;
        if ((__f & __blank)  && (__u == ' ' || __u == '\t')) return true;
        if ((__f & __cntrl)  && (__u < 0x20 || __u == 0x7F)) return true;
        if ((__f & __digit)  && __is_digit) return true;
        if ((__f & __graph)  && __is_print && __u != ' ') return true;
        if ((__f & __lower)  && __is_lower) return true;
        if ((__f & __print)  && __is_print) return true;
