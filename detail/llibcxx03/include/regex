        bool __is_lower = __u >= 'a' && __u <= 'z';
        bool __is_upper = __u >= 'A' && __u <= 'Z';
        bool __is_alpha = __is_lower || __is_upper;
        bool __is_space = __u == ' ' || (__u >= 0x09 && __u <= 0x0D);
        bool __is_print = __u >= 0x20 && __u < 0x7F;
