    _CCW_RE_VEC(__re_class<_CharT>) __classes_;
    int                     __root_;
    int                     __ngroups_;
    bool                    __icase_;
    const _CharT*             __p_;
    const _CharT*             __pend_;
    bool                    __err_;
    int                     __errcode_;
    flag_type               __flags_;   // the flag_type the ctor/assign was given
    bool                    __bre_;     // basic or grep: POSIX basic grammar
    bool                    __grep_;    // grep: a newline separates alternatives
