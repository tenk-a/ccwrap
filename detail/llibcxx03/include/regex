};

template <class _CharT>
class regex_traits {
public:
    typedef _CharT                     char_type;
    typedef _CCW_STD::basic_string<_CharT> string_type;
    typedef _CCW_STD::size_t           size_type;
    typedef _CCW_STD::locale           locale_type;      // [re.traits]
    typedef unsigned                   char_class_type;

    static const char_class_type __alnum = 1, __alpha = 2, __blank = 4, __cntrl = 8,
                                 __digit = 16, __graph = 32, __lower = 64, __print = 128,
                                 __punct = 256, __space = 512, __upper = 1024,
                                 __xdigit = 2048, __w = 4096;

    _CCW_LIBCPP_HIDE_FROM_ABI regex_traits() {}

    _CCW_LIBCPP_HIDE_FROM_ABI static size_type length(const char_type* __p) {
        size_type __n = 0; while (__p[__n]) ++__n; return __n;
    }
    _CCW_LIBCPP_HIDE_FROM_ABI char_type translate(char_type __c) const { return __c; }
    _CCW_LIBCPP_HIDE_FROM_ABI char_type translate_nocase(char_type __c) const {
        return (__c >= 'A' && __c <= 'Z') ? (char_type)(__c - 'A' + 'a') : __c;
