@echo Open Watcom Build Environment
@IF "%WATCOM%"=="" SET "WATCOM=C:\WATCOM"
@PATH %WATCOM%\BINNT64;%WATCOM%\BINNT;%PATH%
@SET INCLUDE=%WATCOM%\H;%WATCOM%\H\NT;%WATCOM%\H\NT\DIRECTX;%WATCOM%\H\NT\DDK;%INCLUDE%
@SET EDPATH=%WATCOM%\EDDAT
@SET WHTMLHELP=%WATCOM%\BINNT\HELP
@SET WIPFC=%WATCOM%\WIPFC

pushd %~dp0%
pushd ..\..
set CCWRAP_ROOT=%CD%
popd
set "INCLUDE=%CCWRAP_ROOT%\watcom\std;%INCLUDE%"
set "LIB=%CCWRAP_ROOT%\watcom\lib\nt;%LIB%"
popd
