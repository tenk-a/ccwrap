{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "watcom-base",
      "hidden": true,
      "generator": "Watcom WMake",
      "environment": {
        "WATCOM": "C:/WATCOM",
        "PATH": "$env{WATCOM}/binnt64;$env{WATCOM}/binnt;$penv{PATH}",
        "EDPATH": "$env{WATCOM}/eddat"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "wcl386",
        "CMAKE_CXX_COMPILER": "wcl386"
      }
    },
    {
      "name": "watcom-win32-base",
      "hidden": true,
      "inherits": "watcom-base",
      "environment": {
        "INCLUDE": "$env{WATCOM}/h;$env{WATCOM}/h/nt"
      },
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "Windows",
        "CMAKE_WATCOM_RUNTIME_LIBRARY": "MultiThreaded"
      }
    },
    {
      "name": "watcom-dos32-base",
      "hidden": true,
      "inherits": "watcom-base",
      "environment": {
        "INCLUDE": "$env{WATCOM}/h"
      },
      "cacheVariables": {
        "//": "Target settings come from the toolchain; do not bake Windows in here.",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/../../test/toolchains/watcom-dos32-toolchain.cmake"
      }
    },
    {
      "name": "watcom-debug-base",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "//": "-d2 cannot compile a TU that includes <tuple> (A19); use -d1.",
        "CMAKE_C_FLAGS_DEBUG": "-d1",
        "CMAKE_CXX_FLAGS_DEBUG": "-d1"
      }
    },
    {
      "name": "watcom-full-base",
      "hidden": true,
      "cacheVariables": {
        "//": "also builds ccwstd / -fsc / -xst.",
        "CCW_LIB_CCWSTD": "ON",
        "CCW_LIB_FS_CHAR": "ON",
        "CCW_LIB_XST": "ON"
      }
    },
    {
      "name": "watcom",
      "inherits": "watcom-win32-base",
      "displayName": "Open Watcom 2.0 (Win32) release -- watcom/lib/nt/ccw[_ccwstd][-fsc]-<eh><abi>.lib",
      "binaryDir": "${sourceDir}/_build/watcom",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "watcom-full",
      "inherits": [
        "watcom-full-base",
        "watcom-win32-base"
      ],
      "displayName": "Open Watcom 2.0 (Win32) release -- watcom/lib/nt/ccw[_ccwstd][-fsc]-<eh><abi>.lib  + ccwstd / -fsc / -xst",
      "binaryDir": "${sourceDir}/_build/watcom-full",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "watcom-debug",
      "inherits": [
        "watcom-debug-base",
        "watcom-win32-base"
      ],
      "displayName": "Open Watcom 2.0 (Win32) debug -- watcom/lib/debug/nt/ccw[_ccwstd][-fsc]-<eh><abi>.lib",
      "binaryDir": "${sourceDir}/_build/watcom-debug"
    },
    {
      "name": "watcom-debug-full",
      "inherits": [
        "watcom-full-base",
        "watcom-debug-base",
        "watcom-win32-base"
      ],
      "displayName": "Open Watcom 2.0 (Win32) debug -- watcom/lib/debug/nt/ccw[_ccwstd][-fsc]-<eh><abi>.lib  + ccwstd / -fsc / -xst",
      "binaryDir": "${sourceDir}/_build/watcom-debug-full"
    },
    {
      "name": "watcom-dos32",
      "inherits": "watcom-dos32-base",
      "displayName": "Open Watcom 2.0 (32-bit DOS) release -- watcom/lib/dos/ccw[-lfn]-<eh><abi>.lib",
      "binaryDir": "${sourceDir}/_build/watcom-dos32",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "watcom-dos32-full",
      "inherits": [
        "watcom-full-base",
        "watcom-dos32-base"
      ],
      "displayName": "Open Watcom 2.0 (32-bit DOS) release -- watcom/lib/dos/ccw[-lfn]-<eh><abi>.lib  + -xst",
      "binaryDir": "${sourceDir}/_build/watcom-dos32-full",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "watcom-dos32-debug",
      "inherits": [
        "watcom-debug-base",
        "watcom-dos32-base"
      ],
      "displayName": "Open Watcom 2.0 (32-bit DOS) debug -- watcom/lib/debug/dos/ccw[-lfn]-<eh><abi>.lib",
      "binaryDir": "${sourceDir}/_build/watcom-dos32-debug"
    },
    {
      "name": "watcom-dos32-debug-full",
      "inherits": [
        "watcom-full-base",
        "watcom-debug-base",
        "watcom-dos32-base"
      ],
      "displayName": "Open Watcom 2.0 (32-bit DOS) debug -- watcom/lib/debug/dos/ccw[-lfn]-<eh><abi>.lib  + -xst",
      "binaryDir": "${sourceDir}/_build/watcom-dos32-debug-full"
    },
    {
      "name": "watcom-xrxs",
      "inherits": "watcom",
      "displayName": "Open Watcom 2.0 (Win32) release -- -xrxs only (-xs; test only)",
      "binaryDir": "${sourceDir}/_build/watcom-xrxs",
      "cacheVariables": {
        "CCW_LIB_XS": "ON"
      }
    },
    {
      "name": "watcom-debug-xrxs",
      "inherits": "watcom-debug",
      "displayName": "Open Watcom 2.0 (Win32) debug -- -xrxs only (-xs; test only)",
      "binaryDir": "${sourceDir}/_build/watcom-debug-xrxs",
      "cacheVariables": {
        "CCW_LIB_XS": "ON"
      }
    },
    {
      "name": "watcom-dos32-xrxs",
      "inherits": "watcom-dos32",
      "displayName": "Open Watcom 2.0 (32-bit DOS) release -- -xrxs only (-xs; test only)",
      "binaryDir": "${sourceDir}/_build/watcom-dos32-xrxs",
      "cacheVariables": {
        "CCW_LIB_XS": "ON"
      }
    },
    {
      "name": "watcom-dos32-debug-xrxs",
      "inherits": "watcom-dos32-debug",
      "displayName": "Open Watcom 2.0 (32-bit DOS) debug -- -xrxs only (-xs; test only)",
      "binaryDir": "${sourceDir}/_build/watcom-dos32-debug-xrxs",
      "cacheVariables": {
        "CCW_LIB_XS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "watcom",
      "configurePreset": "watcom",
      "displayName": "watcom -- the shipping set: -eh (-xst -xr) and -ne"
    },
    {
      "name": "watcom-default",
      "configurePreset": "watcom",
      "displayName": "watcom -- the -eh variant only (-xst -xr: the recommended build)",
      "targets": [
        "ccw_eh3r",
        "ccw_eh3s"
      ]
    },
    {
      "name": "watcom-xrxs",
      "configurePreset": "watcom-xrxs",
      "displayName": "watcom -- the -xrxs variant only (-xs -xr: what test/ measures)",
      "targets": [
        "ccw_xrxs3r",
        "ccw_xrxs3s"
      ]
    },
    {
      "name": "watcom-noeh",
      "configurePreset": "watcom",
      "displayName": "watcom -- the -ne variant only (neither -xs nor -xr)",
      "targets": [
        "ccw_ne3r",
        "ccw_ne3s"
      ]
    },
    {
      "name": "watcom-full",
      "configurePreset": "watcom-full",
      "displayName": "watcom -- every variant (ccwstd / -fsc / -xst too)"
    },
    {
      "name": "watcom-debug",
      "configurePreset": "watcom-debug",
      "displayName": "watcom-debug -- the shipping set: -eh (-xst -xr) and -ne"
    },
    {
      "name": "watcom-debug-default",
      "configurePreset": "watcom-debug",
      "displayName": "watcom-debug -- the -eh variant only (-xst -xr: the recommended build)",
      "targets": [
        "ccw_eh3r",
        "ccw_eh3s"
      ]
    },
    {
      "name": "watcom-debug-xrxs",
      "configurePreset": "watcom-debug-xrxs",
      "displayName": "watcom-debug -- the -xrxs variant only (-xs -xr: what test/ measures)",
      "targets": [
        "ccw_xrxs3r",
        "ccw_xrxs3s"
      ]
    },
    {
      "name": "watcom-debug-noeh",
      "configurePreset": "watcom-debug",
      "displayName": "watcom-debug -- the -ne variant only (neither -xs nor -xr)",
      "targets": [
        "ccw_ne3r",
        "ccw_ne3s"
      ]
    },
    {
      "name": "watcom-debug-full",
      "configurePreset": "watcom-debug-full",
      "displayName": "watcom-debug -- every variant (ccwstd / -fsc / -xst too)"
    },
    {
      "name": "watcom-dos32",
      "configurePreset": "watcom-dos32",
      "displayName": "watcom-dos32 -- the shipping set: -eh (-xst -xr) and -ne"
    },
    {
      "name": "watcom-dos32-default",
      "configurePreset": "watcom-dos32",
      "displayName": "watcom-dos32 -- the -eh variant only (-xst -xr: the recommended build)",
      "targets": [
        "ccw_eh3r",
        "ccw_eh3s",
        "ccw_lfn_eh3r",
        "ccw_lfn_eh3s"
      ]
    },
    {
      "name": "watcom-dos32-xrxs",
      "configurePreset": "watcom-dos32-xrxs",
      "displayName": "watcom-dos32 -- the -xrxs variant only (-xs -xr: what test/ measures)",
      "targets": [
        "ccw_xrxs3r",
        "ccw_xrxs3s",
        "ccw_lfn_xrxs3r",
        "ccw_lfn_xrxs3s"
      ]
    },
    {
      "name": "watcom-dos32-noeh",
      "configurePreset": "watcom-dos32",
      "displayName": "watcom-dos32 -- the -ne variant only (neither -xs nor -xr)",
      "targets": [
        "ccw_ne3r",
        "ccw_ne3s",
        "ccw_lfn_ne3r",
        "ccw_lfn_ne3s"
      ]
    },
    {
      "name": "watcom-dos32-full",
      "configurePreset": "watcom-dos32-full",
      "displayName": "watcom-dos32 -- every variant (-xst too)"
    },
    {
      "name": "watcom-dos32-debug",
      "configurePreset": "watcom-dos32-debug",
      "displayName": "watcom-dos32-debug -- the shipping set: -eh (-xst -xr) and -ne"
    },
    {
      "name": "watcom-dos32-debug-default",
      "configurePreset": "watcom-dos32-debug",
      "displayName": "watcom-dos32-debug -- the -eh variant only (-xst -xr: the recommended build)",
      "targets": [
        "ccw_eh3r",
        "ccw_eh3s",
        "ccw_lfn_eh3r",
        "ccw_lfn_eh3s"
      ]
    },
    {
      "name": "watcom-dos32-debug-xrxs",
      "configurePreset": "watcom-dos32-debug-xrxs",
      "displayName": "watcom-dos32-debug -- the -xrxs variant only (-xs -xr: what test/ measures)",
      "targets": [
        "ccw_xrxs3r",
        "ccw_xrxs3s",
        "ccw_lfn_xrxs3r",
        "ccw_lfn_xrxs3s"
      ]
    },
    {
      "name": "watcom-dos32-debug-noeh",
      "configurePreset": "watcom-dos32-debug",
      "displayName": "watcom-dos32-debug -- the -ne variant only (neither -xs nor -xr)",
      "targets": [
        "ccw_ne3r",
        "ccw_ne3s",
        "ccw_lfn_ne3r",
        "ccw_lfn_ne3s"
      ]
    },
    {
      "name": "watcom-dos32-debug-full",
      "configurePreset": "watcom-dos32-debug-full",
      "displayName": "watcom-dos32-debug -- every variant (-xst too)"
    }
  ]
}
