inline double hypot(double __x, double __y, double __z) {
    __x = fabs(__x); __y = fabs(__y); __z = fabs(__z);
    double __a = __x > __y ? __x : __y;
    if (__z > __a) __a = __z;
    if (__a == 0.0) return 0.0;
    double __rx = __x / __a, __ry = __y / __a, __rz = __z / __a;
    return __a * sqrt(__rx * __rx + __ry * __ry + __rz * __rz);
}
inline float hypot(float __x, float __y, float __z) {
    return (float)hypot((double)__x, (double)__y, (double)__z);
}
inline long double hypot(long double __x, long double __y, long double __z) {
    return hypot((double)__x, (double)__y, (double)__z);
}
