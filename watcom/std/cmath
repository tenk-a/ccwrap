#ifndef _CCW_CMATH_CLASSIFY_DEFINED
#define _CCW_CMATH_CLASSIFY_DEFINED
#undef fpclassify
#undef isnan
#undef isinf
#undef isfinite
#undef isnormal
#undef signbit
#undef isgreater
#undef isgreaterequal
#undef isless
#undef islessequal
#undef islessgreater
#undef isunordered
#undef nan
#undef nanf
#undef nanl
namespace std {
    inline _ccw_ullong __ccw_dbits(double __x) { union { double __d; _ccw_ullong __u; } __v; __v.__d = __x; return __v.__u; }
    inline bool signbit(double __x)  { return (__ccw_dbits(__x) >> 63) != 0; }
    inline bool isnan(double __x)    { _ccw_ullong __u = __ccw_dbits(__x); return ((__u >> 52) & 0x7FFu) == 0x7FFu && (__u & 0xFFFFFFFFFFFFFULL) != 0; }
    inline bool isinf(double __x)    { _ccw_ullong __u = __ccw_dbits(__x); return ((__u >> 52) & 0x7FFu) == 0x7FFu && (__u & 0xFFFFFFFFFFFFFULL) == 0; }
    inline bool isfinite(double __x) { return ((__ccw_dbits(__x) >> 52) & 0x7FFu) != 0x7FFu; }
    inline bool isnormal(double __x) { unsigned __e = (unsigned)((__ccw_dbits(__x) >> 52) & 0x7FFu); return __e != 0 && __e != 0x7FFu; }
    inline int  fpclassify(double __x) {
        _ccw_ullong __u = __ccw_dbits(__x);
        unsigned    __e = (unsigned)((__u >> 52) & 0x7FFu);
        _ccw_ullong __m = __u & 0xFFFFFFFFFFFFFULL;
        if (__e == 0x7FFu) return __m ? FP_NAN : FP_INFINITE;
        if (__e == 0)      return __m ? FP_SUBNORMAL : FP_ZERO;
        return FP_NORMAL;
    }
    inline _ccw_uint32 __ccw_fbits(float __x) { union { float __f; _ccw_uint32 __u; } __v; __v.__f = __x; return __v.__u; }
    inline bool signbit(float __x)   { return (__ccw_fbits(__x) >> 31) != 0; }
    inline bool isnan(float __x)     { _ccw_uint32 __u = __ccw_fbits(__x); return ((__u >> 23) & 0xFFu) == 0xFFu && (__u & 0x7FFFFFu) != 0; }
    inline bool isinf(float __x)     { _ccw_uint32 __u = __ccw_fbits(__x); return ((__u >> 23) & 0xFFu) == 0xFFu && (__u & 0x7FFFFFu) == 0; }
    inline bool isfinite(float __x)  { return ((__ccw_fbits(__x) >> 23) & 0xFFu) != 0xFFu; }
    inline bool isnormal(float __x)  { unsigned __e = (unsigned)((__ccw_fbits(__x) >> 23) & 0xFFu); return __e != 0 && __e != 0xFFu; }
    inline int  fpclassify(float __x) {
        _ccw_uint32 __u = __ccw_fbits(__x);
        unsigned    __e = (unsigned)((__u >> 23) & 0xFFu);
        _ccw_uint32 __m = __u & 0x7FFFFFu;
        if (__e == 0xFFu) return __m ? FP_NAN : FP_INFINITE;
        if (__e == 0)     return __m ? FP_SUBNORMAL : FP_ZERO;
        return FP_NORMAL;
    }
    inline int  fpclassify(long double __x) { return fpclassify((double)__x); }
    inline bool signbit(long double __x)   { return signbit((double)__x); }
    inline bool isnan(long double __x)     { return isnan((double)__x); }
    inline bool isinf(long double __x)     { return isinf((double)__x); }
    inline bool isfinite(long double __x)  { return isfinite((double)__x); }
    inline bool isnormal(long double __x)  { return isnormal((double)__x); }
    inline bool isgreater(double __x, double __y)      { return !isnan(__x) && !isnan(__y) && __x >  __y; }
    inline bool isgreaterequal(double __x, double __y) { return !isnan(__x) && !isnan(__y) && __x >= __y; }
    inline bool isless(double __x, double __y)         { return !isnan(__x) && !isnan(__y) && __x <  __y; }
    inline bool islessequal(double __x, double __y)    { return !isnan(__x) && !isnan(__y) && __x <= __y; }
    inline bool islessgreater(double __x, double __y)  { return !isnan(__x) && !isnan(__y) && (__x < __y || __x > __y); }
    inline bool isunordered(double __x, double __y)    { return isnan(__x) || isnan(__y); }
    inline double nan(const char*)  { union { _ccw_ullong __u; double __d; } __v; __v.__u = 0x7FF8000000000000ULL; return __v.__d; }
    inline float       nanf(const char*) { union { _ccw_uint32 __u; float __f; } __v; __v.__u = 0x7FC00000u; return __v.__f; }
    inline double      nanl(const char*) { union { _ccw_ullong __u; double __d; } __v; __v.__u = 0x7FF8000000000000ULL; return __v.__d; }
    inline double lerp(double __a, double __b, double __t) {
        if ((__a <= 0 && __b >= 0) || (__a >= 0 && __b <= 0)) return __t * __b + (1 - __t) * __a;
        if (__t == 1) return __b;
        double __x = __a + __t * (__b - __a);
        if ((__t > 1) == (__b > __a)) return __b < __x ? __x : __b;
        return __x < __b ? __x : __b;
    }
    inline float       lerp(float __a, float __b, float __t)                   { return (float)lerp((double)__a, (double)__b, (double)__t); }
    inline long double lerp(long double __a, long double __b, long double __t) { return lerp((double)__a, (double)__b, (double)__t); }
}
#endif  /* _CCW_CMATH_CLASSIFY_DEFINED */

